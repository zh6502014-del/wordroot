["college", "art", "philosophy"] \}, \{ "word": "alienate", "pos": "verb", "phonetic": "/\u712 e\u618 li\u601 ne\u618 t/", "definition": "To cause someone to feel isolated, estranged, or excluded from a group or society.", "definition_zh": "\u30095 \u36960 \u65307 \u20351 \u23396 \u31435 \u65307 \u36681 \u35731 \u65288 \u36001 \u29986 \u65289 ", "etymology": \{ "roots": [ \{ "root": "alius / alienus", "origin": "Latin", "meaning": "other, another, foreign", "meaning_zh": "\u20854 \u20182 \u30340 \u12289 \u22806 \u22283 \u30340 \u12289 \u30064 \u24049 \u30340 " \} ] \}, "mnemonic": \{ "root_memory": "ALIEN\u65288 \u20854 \u20182 \u30340 \u12289 \u22806 \u26143 \u20154 \u65289 \u8594  \u25226 \u20182 \u20154 \u30070 \u25104 \u22806 \u26143 \u20154 \u25110 \u30064 \u39006 \u30475 \u24453  \u8594  \u30095 \u36960 ", "story_en": "The politician's extreme comments managed to ALIENATE moderate voters, making them feel like ALIENs in the party.", "story_zh": "\u36889 \u20301 \u25919 \u27835 \u20154 \u29289 \u30340 \u26997 \u31471 \u35328 \u35542 \u25104 \u21151 \u12300 \u30095 \u36960 \u20102 \u65288 ALIENATE\u65289 \u12301 \u28331 \u21644 \u27966 \u36984 \u27665 \u65292 \u35731 \u20182 \u20497 \u22312 \u40680 \u20839 \u24863 \u35258 \u20687 \u22806 \u26143 \u20154 \u65288 ALIEN\u65289 \u19968 \u27171 \u26684 \u26684 \u19981 \u20837 \u12290 ", "emojis": ["\u55357 \u56901 ", "\u55358 \u56781 ", "\u55357 \u56468 "] \}, "example": "His arrogant behavior tended to alienate his colleagues, leaving him isolated in the office.", "example_zh": "\u20182 \u30340 \u20658 \u24930 \u34892 \u28858 \u24448 \u24448 \u26371 \u30095 \u36960 \u21516 \u20107 \u65292 \u20351 \u20182 \u22312 \u36774 \u20844 \u23460 \u35041 \u38519 \u20837 \u23396 \u31435 \u12290 ", "collocations": [ "alienate voters", "feel alienated", "alienate colleagues", "completely alienate", "social alienation" ], "synonyms": ["estrange", "isolate", "distance", "exclude"], "near_synonyms": [ \{ "word": "isolate", "difference": "isolate means to physically separate someone or something from a group; alienate focuses on destroying emotional connections or changing feelings from friendly to hostile." \}, \{ "word": "estrange", "difference": "estrange is typically used for families or couples, implying a breakdown of deep, long-standing love or affection." \} ], "antonyms": ["unite", "reconcile", "endear", "attract"], "word_family": [ \{ "word": "alienate", "pos": "verb" \}, \{ "word": "alienation", "pos": "noun" \}, \{ "word": "alien", "pos": "noun / adjective" \} ], "frequency_rank": 69, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "psychology", "social"] \}, \{ "word": "altruism", "pos": "noun", "phonetic": "/\u712 \'e6ltru\u618 z\u601 m/", "definition": "The belief in or practice of disinterested and selfless concern for the well-being of others.", "definition_zh": "\u21033 \u20182 \u20027 \u32681 \u65307 \u28961 \u31169 ", "etymology": \{ "roots": [ \{ "root": "alter", "origin": "Latin", "meaning": "other", "meaning_zh": "\u20854 \u20182 \u30340 \u20154 " \} ] \}, "mnemonic": \{ "root_memory": "ALTER\u65288 \u20854 \u20182 \u20154 \u65289 \u8594  \u20961 \u20107 \u20197 \u12300 \u20854 \u20182 \u20154 \u12301 \u28858 \u20986 \u30332 \u40670 \u30340 \u34892 \u28858  \u8594  \u21033 \u20182 \u20027 \u32681 ", "story_en": "Act with ALTRUISM by putting the needs of ALTER (others) before your own selfish desires.", "story_zh": "\u23637 \u29694 \u12300 \u21033 \u20182 \u20027 \u32681 \u65288 ALTRUISM\u65289 \u12301 \u65292 \u23601 \u35201 \u25226 \u20854 \u20182 \u65288 ALTER\u65289 \u20154 \u30340 \u38656 \u27714 \u25918 \u22312 \u33258 \u24049 \u30340 \u33258 \u31169 \u27442 \u26395 \u20043 \u21069 \u12290 ", "emojis": ["\u10084 \u65039 ", "\u55358 \u56605 ", "\u55358 \u56626 "] \}, "example": "Many charities rely on the pure altruism of volunteers who dedicate their time without pay.", "example_zh": "\u35377 \u22810 \u24904 \u21892 \u27231 \u27083 \u20381 \u38752 \u24535 \u24037 \u32020 \u31929 \u30340 \u21033 \u20182 \u20027 \u32681 \u65292 \u20182 \u20497 \u28961 \u20767 \u22857 \u29563 \u33258 \u24049 \u30340 \u26178 \u38291 \u12290 ", "collocations": [ "pure altruism", "act of altruism", "reciprocal altruism", "motivated by altruism", "human altruism" ], "synonyms": ["unselfishness", "philanthropy", "benevolence", "selflessness"], "near_synonyms": [ \{ "word": "philanthropy", "difference": "philanthropy typically manifests as organized, large-scale financial donations or institutional charity; altruism is the individual psychological mindset of selflessness." \}, \{ "word": "benevolence", "difference": "benevolence means a general kind and friendly attitude, but it does not necessarily require self-sacrifice." \} ], "antonyms": ["egoism", "selfishness", "narcissism"], "word_family": [ \{ "word": "altruism", "pos": "noun" \}, \{ "word": "altruistic", "pos": "adjective" \}, \{ "word": "altruistically", "pos": "adverb" \} ], "frequency_rank": 70, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "philosophy", "psychology"] \}, \{ "word": "ambiguous", "pos": "adjective", "phonetic": "/\'e6m\u712 b\u618 \u609 ju\u601 s/", "definition": "Open to more than one interpretation; having a double meaning; unclear or inexact.", "definition_zh": "\u27169 \u31260 \u20841 \u21487 \u30340 \u65307 \u21547 \u31946 \u19981 \u28165 \u30340 ", "etymology": \{ "roots": [ \{ "root": "ambi-", "origin": "Latin", "meaning": "both, around", "meaning_zh": "\u38617 \u26041 \u12289 \u21608 \u22285 " \}, \{ "root": "agere", "origin": "Latin", "meaning": "to drive, lead", "meaning_zh": "\u39493 \u20351 \u12289 \u24341 \u23566 " \} ] \}, "mnemonic": \{ "root_memory": "AMBI\u65288 \u38617 \u26041 \u65289 + AGERE\u65288 \u39493 \u20351 \u12289 \u36208 \u65289 \u8594  \u21516 \u26178 \u24448 \u20841 \u20491 \u26041 \u21521 \u36208  \u8594  \u35731 \u20154 \u25720 \u19981 \u28165 \u24847 \u22294 \u30340 ", "story_en": "The sign was AMBIGUOUS because it seemed to drive (agere) people in AMBI- (both) directions at once.", "story_zh": "\u36889 \u20491 \u27161 \u35468 \u12300 \u27169 \u31260 \u20841 \u21487 \u65288 AMBIGUOUS\u65289 \u12301 \u65292 \u22240 \u28858 \u23427 \u20284 \u20046 \u21516 \u26178 \u25226 \u20154 \u24341 \u23566 \u65288 AGERE\u65289 \u21040 \u20841 \u65288 AMBI\u65289 \u20491 \u19981 \u21516 \u30340 \u26041 \u21521 \u12290 ", "emojis": ["\u10067 ", "\u55358 \u56631 ", "\u55356 \u57088 "] \}, "example": "The legal contract was rewritten because its ambiguous wording led to multiple disputes between the partners.", "example_zh": "\u36889 \u20221 \u27861 \u24459 \u21512 \u32004 \u34987 \u37325 \u23531 \u65292 \u22240 \u28858 \u20854 \u27169 \u31260 \u20841 \u21487 \u30340 \u23383 \u21477 \u23566 \u33268 \u21512 \u22821 \u20154 \u20043 \u38291 \u29986 \u29983 \u20102 \u22810 \u27425 \u31998 \u32027 \u12290 ", "collocations": [ "ambiguous wording", "highly ambiguous", "ambiguous answer", "remain ambiguous", "ambiguous position" ], "synonyms": ["equivocal", "vague", "unclear", "obscure"], "near_synonyms": [ \{ "word": "vague", "difference": "vague means lacking precision due to a general lack of information; ambiguous means capable of being understood in two or more specific, conflicting ways." \}, \{ "word": "equivocal", "difference": "equivocal implies deliberate ambiguity used to mislead or avoid committing to the truth." \} ], "antonyms": ["unambiguous", "clear", "explicit", "definite"], "word_family": [ \{ "word": "ambiguous", "pos": "adjective" \}, \{ "word": "ambiguity", "pos": "noun" \}, \{ "word": "ambiguously", "pos": "adverb" \} ], "frequency_rank": 71, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "academic", "law"] \}, \{ "word": "analogy", "pos": "noun", "phonetic": "/\u601 \u712 n\'e6l\u601 d\u658 i/", "definition": "A comparison between two things, typically for the purpose of explanation or clarification.", "definition_zh": "\u39006 \u27604 \u65307 \u27604 \u21947 \u65307 \u30456 \u20284 \u29289 ", "etymology": \{ "roots": [ \{ "root": "ana-", "origin": "Greek", "meaning": "upon, according to", "meaning_zh": "\u26681 \u25818 \u12289 \u27839 \u33879 " \}, \{ "root": "logos", "origin": "Greek", "meaning": "ratio, word, reason", "meaning_zh": "\u27604 \u20363 \u12289 \u35328 \u35486 \u12289 \u36947 \u29702 " \} ] \}, "mnemonic": \{ "root_memory": "ANA\u65288 \u26681 \u25818 \u65289 + LOGOS\u65288 \u27604 \u20363 \u12289 \u36947 \u29702 \u65289 \u8594  \u26681 \u25818 \u30456 \u21516 \u30340 \u36947 \u29702 \u36914 \u34892 \u23565 \u27604  \u8594  \u39006 \u27604 ", "story_en": "The teacher drew an ANALOGY, comparing the human brain to a computer based on LOGOS (reason).", "story_zh": "\u32769 \u24107 \u20570 \u20102 \u19968 \u20491 \u12300 \u39006 \u27604 \u65288 ANALOGY\u65289 \u12301 \u65292 \u26681 \u65288 ANA\u65289 \u25818 \u37007 \u36655 \u65288 LOGOS\u65289 \u23559 \u20154 \u39006 \u22823 \u33126 \u27604 \u20316 \u38651 \u33126 \u12290 ", "emojis": ["\u55358 \u56800 ", "\u55357 \u56507 ", "\u9878 \u65039 "] \}, "example": "To explain how electricity flows in a wire, the professor used the analogy of water flowing through a pipe.", "example_zh": "\u28858 \u20102 \u35299 \u37323 \u38651 \u26159 \u22914 \u20309 \u22312 \u23566 \u32218 \u20013 \u27969 \u21205 \u30340 \u65292 \u25945 \u25480 \u20351 \u29992 \u20102 \u27700 \u22312 \u31649 \u36947 \u20013 \u27969 \u21205 \u30340 \u39006 \u27604 \u12290 ", "collocations": [ "draw an analogy", "by analogy with", "false analogy", "striking analogy", "use an analogy" ], "synonyms": ["comparison", "metaphor", "parallel", "similitude"], "near_synonyms": [ \{ "word": "metaphor", "difference": "metaphor is a literary device stating that one thing 
\f1\i is
\f0\i0  another; analogy is an extended logical argument showing structural similarities for explanation." \}, \{ "word": "comparison", "difference": "comparison is a broad term for examining similarities or differences; analogy focuses specifically on parallel systems of internal relationships." \} ], "antonyms": ["contrast", "difference", "disparity"], "word_family": [ \{ "word": "analogy", "pos": "noun" \}, \{ "word": "analogous", "pos": "adjective" \}, \{ "word": "analog", "pos": "noun / adjective" \} ], "frequency_rank": 72, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "academic", "language"] \}, \{ "word": "annihilate", "pos": "verb", "phonetic": "/\uc0\u601 \u712 na\u618 \u601 le\u618 t/", "definition": "To destroy utterly; to wipe out of existence; to defeat completely.", "definition_zh": "\u27570 \u28357 \u65307 \u28040 \u28357 \u65307 \u24505 \u24213 \u25802 \u25943 ", "etymology": \{ "roots": [ \{ "root": "ad-", "origin": "Latin", "meaning": "to, toward", "meaning_zh": "\u21521 \u12289 \u35722 \u25104 " \}, \{ "root": "nihil", "origin": "Latin", "meaning": "nothing", "meaning_zh": "\u34395 \u28961 \u12289 \u27794 \u26377 \u26481 \u35199 " \} ] \}, "mnemonic": \{ "root_memory": "AD\u65288 \u35722 \u25104 \u65289 + NIHIL\u65288 \u28961 \u65289 \u8594  \u35731 \u23427 \u21270 \u28858 \u28879 \u26377  \u8594  \u24505 \u24213 \u28040 \u28357 ", "story_en": "The atomic bomb can ANNIHILATE an entire city, turning all buildings into NIHIL (nothing).", "story_zh": "\u21407 \u23376 \u24392 \u33021 \u12300 \u24505 \u24213 \u28040 \u28357 \u65288 ANNIHILATE\u65289 \u12301 \u25972 \u24231 \u22478 \u24066 \u65292 \u23559 \u25152 \u26377 \u24314 \u31689 \u29289 \u21270 \u28858 \u34395 \u28961 \u65288 NIHIL\u65289 \u12290 ", "emojis": ["\u55357 \u56485 ", "\u55357 \u56448 ", "\u55356 \u57130 \u65039 "] \}, "example": "The heavy artillery fire managed to annihilate the enemy's defensive fortifications within hours.", "example_zh": "\u29467 \u28872 \u30340 \u28846 \u28779 \u22312 \u24190 \u20491 \u23567 \u26178 \u20839 \u25104 \u21151 \u27570 \u28357 \u20102 \u25973 \u20154 \u30340 \u38450 \u31142 \u24037 \u20107 \u12290 ", "collocations": [ "completely annihilate", "annihilate the enemy", "threaten to annihilate", "virtually annihilated", "nuclear annihilation" ], "synonyms": ["destroy", "obliterate", "exterminate", "eradicate"], "near_synonyms": [ \{ "word": "destroy", "difference": "destroy is a common word meaning to damage something so badly it cannot function; annihilate implies total obliteration, leaving absolutely nothing left." \}, \{ "word": "obliterate", "difference": "obliterate focuses on wiping out all physical traces, memories, or markings of something's existence." \} ], "antonyms": ["create", "construct", "preserve", "generate"], "word_family": [ \{ "word": "annihilate", "pos": "verb" \}, \{ "word": "annihilation", "pos": "noun" \} ], "frequency_rank": 73, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "GRE", "history"] \}, \{ "word": "anomaly", "pos": "noun", "phonetic": "/\u601 \u712 n\u593 \u720 m\u601 li/", "definition": "Something that deviates from what is standard, normal, or expected.", "definition_zh": "\u30064 \u24120 \u20107 \u29289 \u65307 \u21453 \u24120 \u29694 \u35937 \u65307 \u30072 \u35722 ", "etymology": \{ "roots": [ \{ "root": "an-", "origin": "Greek", "meaning": "not, without", "meaning_zh": "\u19981 \u12289 \u28961 " \}, \{ "root": "homalos", "origin": "Greek", "meaning": "even, regular, same", "meaning_zh": "\u24179 \u30340 \u12289 \u35215 \u24459 \u30340 \u12289 \u30456 \u21516 \u30340 " \} ] \}, "mnemonic": \{ "root_memory": "AN\u65288 \u19981 \u65289 + HOMALOS\u65288 \u35215 \u24459 \u65289 \u8594  \u19981 \u31526 \u21512 \u24120 \u35215 \u30340 \u29694 \u35937 ", "story_en": "A snowfall in the desert is a weather ANOMALY, because it is AN (not) HOMALOS (regular) for that climate.", "story_zh": "\u27801 \u28448 \u38477 \u38634 \u26159 \u19968 \u31278 \u27683 \u20505 \u12300 \u21453 \u24120 \u29694 \u35937 \u65288 ANOMALY\u65289 \u12301 \u65292 \u22240 \u28858 \u36889 \u23565 \u30070 \u22320 \u30340 \u27683 \u20505 \u20358 \u35498 \u26159 \u19981 \u65288 AN\u65289 \u24120 \u35215 \u65288 HOMALOS\u65289 \u30340 \u12290 ", "emojis": ["\u10052 \u65039 ", "\u55356 \u57141 ", "\u55357 \u56522 "] \}, "example": "Scientists discovered a genetic anomaly in the blood sample that could explain the patient's rare condition.", "example_zh": "\u31185 \u23416 \u23478 \u22312 \u34880 \u28082 \u27171 \u26412 \u20013 \u30332 \u29694 \u20102 \u19968 \u31278 \u22522 \u22240 \u21453 \u24120 \u29694 \u35937 \u65292 \u36889 \u21487 \u20197 \u35299 \u37323 \u35442 \u24739 \u32773 \u30340 \u32597 \u35211 \u30149 \u24773 \u12290 ", "collocations": [ "statistical anomaly", "genetic anomaly", "detect an anomaly", "a strange anomaly", "market anomaly" ], "synonyms": ["abnormality", "irregularity", "deviation", "pecularity"], "near_synonyms": [ \{ "word": "abnormality", "difference": "abnormality often carries a negative, medical, or biological connotation of deformity; anomaly is neutral and widely used in science, statistics, and computing." \}, \{ "word": "aberration", "difference": "aberration emphasizes a temporary lapse or departure from standard behavior, whereas anomaly is a fixed structural variance." \} ], "antonyms": ["normality", "regularity", "standard"], "word_family": [ \{ "word": "anomaly", "pos": "noun" \}, \{ "word": "anomalous", "pos": "adjective" \} ], "frequency_rank": 74, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "science", "academic"] \}, \{ "word": "apathetic", "pos": "adjective", "phonetic": "/\u716 \'e6p\u601 \u712 \u952 et\u618 k/", "definition": "Showing or feeling no interest, enthusiasm, or concern; listless or indifferent.", "definition_zh": "\u20919 \u28448 \u30340 \u65307 \u28961 \u21205 \u26044 \u34935 \u30340 \u65307 \u32570 \u20047 \u33288 \u36259 \u30340 ", "etymology": \{ "roots": [ \{ "root": "a-", "origin": "Greek", "meaning": "without", "meaning_zh": "\u28961 \u12289 \u27794 \u26377 " \}, \{ "root": "pathos", "origin": "Greek", "meaning": "feeling, emotion", "meaning_zh": "\u24863 \u24773 \u12289 \u30171 \u33510 " \} ] \}, "mnemonic": \{ "root_memory": "A\u65288 \u27794 \u26377 \u65289 + PATHOS\u65288 \u24863 \u24773 \u65289 \u8594  \u27794 \u26377 \u32114 \u27627 \u24863 \u24773 \u30340  \u8594  \u20919 \u28448 \u30340 ", "story_en": "Many APATHETIC citizens remain APATHETIC about elections, staying A- (without) PATHOS (feeling) for politics.", "story_zh": "\u35377 \u22810 \u12300 \u20919 \u28448 \u30340 \u65288 APATHETIC\u65289 \u12301 \u20844 \u27665 \u23565 \u36984 \u33289 \u28961 \u21205 \u26044 \u34935 \u65292 \u23565 \u25919 \u27835 \u25265 \u25345 \u33879 \u27794 \u65288 A\u65289 \u26377 \u24863 \u24773 \u65288 PATHOS\u65289 \u30340 \u24907 \u24230 \u12290 ", "emojis": ["\u55357 \u56848 ", "\u55358 \u56631 \u8205 \u9794 \u65039 ", "\u55357 \u56484 "] \}, "example": "The youth are often accused of being apathetic toward local politics, resulting in low voter turnout.", "example_zh": "\u24180 \u36629 \u20154 \u24120 \u34987 \u25351 \u36012 \u23565 \u22320 \u26041 \u25919 \u27835 \u20919 \u28448 \u65292 \u23566 \u33268 \u25237 \u31080 \u29575 \u20302 \u33853 \u12290 ", "collocations": [ "apathetic attitude", "politically apathetic", "become apathetic", "apathetic response", "socially apathetic" ], "synonyms": ["indifferent", "unconcerned", "uninterested", "lethargic"], "near_synonyms": [ \{ "word": "indifferent", "difference": "indifferent means not leaning toward either side or not caring about a choice; apathetic implies a deep, listless lack of vital energy or emotion toward anything." \}, \{ "word": "callous", "difference": "callous means cruel and intentionally unfeeling toward the suffering of others; apathetic is simply passive and unmotivated." \} ], "antonyms": ["enthusiastic", "passionate", "concerned", "eager"], "word_family": [ \{ "word": "apathetic", "pos": "adjective" \}, \{ "word": "apathy", "pos": "noun" \}, \{ "word": "apathetically", "pos": "adverb" \} ], "frequency_rank": 75, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "psychology", "politics"] \}, \{ "word": "arbitrary", "pos": "adjective", "phonetic": "/\u712 \u593 \u720 rb\u618 treri/", "definition": "Based on random choice or personal whim, rather than any reason, system, or law; (of power) autocratic or tyrannical.", "definition_zh": "\u20219 \u24847 \u30340 \u65307 \u38568 \u27231 \u30340 \u65307 \u27494 \u26039 \u30340 \u65307 \u23560 \u21046 \u30340 ", "etymology": \{ "roots": [ \{ "root": "arbiter", "origin": "Latin", "meaning": "judge, witness", "meaning_zh": "\u20210 \u35009 \u32773 \u12289 \u27861 \u23448 " \} ] \}, "mnemonic": \{ "root_memory": "ARBITER\u65288 \u20210 \u35009 \u32773 \u12289 \u27861 \u23448 \u65289 \u8594  \u20840 \u24977 \u27861 \u23448 \u19968 \u20491 \u20154 \u39640 \u33288 \u24590 \u40636 \u21028 \u23601 \u24590 \u40636 \u21028 \u30340  \u8594  \u27494 \u26039 \u30340 \u12289 \u20219 \u24847 \u30340 ", "story_en": "The dictator made an ARBITRARY decision, acting like a tyrannical ARBITER who ignores the written law.", "story_zh": "\u29544 \u35009 \u32773 \u20570 \u20102 \u19968 \u20491 \u12300 \u27494 \u26039 \u30340 \u65288 ARBITRARY\u65289 \u12301 \u27770 \u23450 \u65292 \u34920 \u29694 \u24471 \u20687 \u19968 \u20491 \u28961 \u35222 \u25104 \u25991 \u27861 \u24459 \u30340 \u23560 \u21046 \u20210 \u35009 \u32773 \u65288 ARBITER\u65289 \u12290 ", "emojis": ["\u55356 \u57266 ", "\u55357 \u56401 ", "\u9878 \u65039 "] \}, "example": "The selection of the winners seemed completely arbitrary, with no clear criteria provided by the judges.", "example_zh": "\u29554 \u29518 \u32773 \u30340 \u35413 \u36984 \u20284 \u20046 \u23436 \u20840 \u26159 \u20219 \u24847 \u30340 \u65288 \u38568 \u27231 \u30340 \u65289 \u65292 \u35413 \u23529 \u27794 \u26377 \u25552 \u20379 \u26126 \u30906 \u30340 \u27161 \u28310 \u12290 ", "collocations": [ "arbitrary decision", "arbitrary arrest", "purely arbitrary", "arbitrary power", "arbitrary choice" ], "synonyms": ["random", "capricious", "whimsical", "discretionary"], "near_synonyms": [ \{ "word": "random", "difference": "random means following a strict mathematical chance where every item has an equal probability; arbitrary emphasizes personal whim, bias, or lack of logical justification." \}, \{ "word": "capricious", "difference": "capricious implies unpredictable, highly unstable shifts in mood, behavior, or decisions." \} ], "antonyms": ["rational", "systematic", "lawful", "consistent"], "word_family": [ \{ "word": "arbitrary", "pos": "adjective" \}, \{ "word": "arbitrarily", "pos": "adverb" \}, \{ "word": "arbitrariness", "pos": "noun" \} ], "frequency_rank": 76, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "academic", "law"] \}, \{ "word": "assiduous", "pos": "adjective", "phonetic": "/\u601 \u712 s\u618 d\u658 u\u601 s/", "definition": "Showing great care, attention, and persistent effort; diligent and hard-working.", "definition_zh": "\u23560 \u24515 \u33268 \u24535 \u30340 \u65307 \u21220 \u21193 \u30340 \u65307 \u37733 \u32780 \u19981 \u25448 \u30340 ", "etymology": \{ "roots": [ \{ "root": "ad-", "origin": "Latin", "meaning": "to, near", "meaning_zh": "\u21521 \u12289 \u38752 \u36817 " \}, \{ "root": "sedere", "origin": "Latin", "meaning": "to sit", "meaning_zh": "\u22352 " \} ] \}, "mnemonic": \{ "root_memory": "AD\u65288 \u38752 \u36817 \u65289 + SEDERE\u65288 \u22352 \u65289 \u8594  \u23617 \u32929 \u19968 \u30452 \u22352 \u22312 \u20301 \u23376 \u19978 \u19981 \u25386 \u38283  \u8594  \u21220 \u21193 \u30340 ", "story_en": "The ASSIDUOUS student would SEDE (sit) at her desk for hours, working diligently on her research paper.", "story_zh": "\u36889 \u20301 \u12300 \u21220 \u21193 \u30340 \u65288 ASSIDUOUS\u65289 \u12301 \u23416 \u29983 \u26371 \u36899 \u32396 \u24190 \u20491 \u23567 \u26178 \u22352 \u65288 SEDE\u65289 \u22312 \u26360 \u26700 \u21069 \u65292 \u23560 \u24515 \u33268 \u24535 \u22320 \u23531 \u33879 \u22905 \u30340 \u30740 \u31350 \u35542 \u25991 \u12290 ", "emojis": ["\u9997 \u65039 ", "\u55357 \u56538 ", "\u9203 "] \}, "example": "Through assiduous research and hours of interviews, the journalist finally uncovered the corporate scandal.", "example_zh": "\u36879 \u36942 \u37733 \u32780 \u19981 \u25448 \u30340 \u30740 \u31350 \u21644 \u25976 \u23567 \u26178 \u30340 \u25505 \u35370 \u65292 \u36889 \u20301 \u35352 \u32773 \u26368 \u32066 \u25581 \u38706 \u20102 \u20844 \u21496 \u30340 \u37276 \u32862 \u12290 ", "collocations": [ "assiduous research", "assiduous student", "assiduous attention to detail", "assiduous efforts", "assiduous care" ], "synonyms": ["diligent", "industrious", "painstaking", "sedulous"], "near_synonyms": [ \{ "word": "diligent", "difference": "diligent is a general term for steady, earnest, and energetic effort; assiduous emphasizes unremitting, long-term sitting and constant attention to a detailed task." \}, \{ "word": "painstaking", "difference": "painstaking emphasizes extreme care, precision, and taking great trouble to avoid any tiny mistake." \} ], "antonyms": ["lazy", "negligent", "indolent", "careless"], "word_family": [ \{ "word": "assiduous", "pos": "adjective" \}, \{ "word": "assiduity", "pos": "noun" \}, \{ "word": "assiduously", "pos": "adverb" \} ], "frequency_rank": 77, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "GRE", "academic"] \}, \{ "word": "augment", "pos": "verb", "phonetic": "/\u596 \u720 \u609 \u712 ment/", "definition": "To make something greater, larger, or more intense by adding to it; to increase.", "definition_zh": "\u22686 \u21152 \u65307 \u25844 \u22823 \u65307 \u25844 \u20805 \u65307 \u25552 \u39640 ", "etymology": \{ "roots": [ \{ "root": "augere", "origin": "Latin", "meaning": "to increase, make grow", "meaning_zh": "\u22686 \u21152 \u12289 \u20351 \u25104 \u38263 " \} ] \}, "mnemonic": \{ "root_memory": "AUGERE\u65288 \u22686 \u21152 \u65289 \u8594  \u35731 \u21407 \u26412 \u30340 \u35215 \u27169 \u25844 \u22823 ", "story_en": "He had to AUGMENT his income by taking a second job, AUG- (increasing) his total savings.", "story_zh": "\u20182 \u19981 \u24471 \u19981 \u20860 \u24046 \u31532 \u20108 \u20221 \u24037 \u20316 \u20358 \u12300 \u22686 \u21152 \u65288 AUGMENT\u65289 \u12301 \u25910 \u20837 \u65292 \u20197 \u25844 \u22823 \u65288 AUGERE\u65289 \u20182 \u30340 \u32317 \u23384 \u27454 \u12290 ", "emojis": ["\u10133 ", "\u55357 \u56520 ", "\u55357 \u56496 "] \}, "example": "The military decided to augment its forces in the region due to rising political tensions.", "example_zh": "\u30001 \u26044 \u25919 \u27835 \u32202 \u24373 \u23616 \u21218 \u21152 \u21127 \u65292 \u36557 \u26041 \u27770 \u23450 \u22686 \u21152 \u22312 \u35442 \u22320 \u21312 \u30340 \u20853 \u21147 \u12290 ", "collocations": [ "augment income", "augmented reality", "augment troops", "augment a budget", "substantially augment" ], "synonyms": ["increase", "enhance", "expand", "amplify", "supplement"], "near_synonyms": [ \{ "word": "increase", "difference": "increase is the general word for making something larger in size or number; augment specifically implies adding something to an already existing base to supplement it." \}, \{ "word": "enhance", "difference": "enhance focuses on improving the quality, value, or attractiveness of something rather than its size." \} ], "antonyms": ["decrease", "diminish", "reduce", "deplete"], "word_family": [ \{ "word": "augment", "pos": "verb" \}, \{ "word": "augmentation", "pos": "noun" \} ], "usage_note": "Commonly seen in the tech term 'Augmented Reality' (AR), which adds digital elements to the real world.", "frequency_rank": 78, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "business", "technology"] \}, \{ "word": "austere", "pos": "adjective", "phonetic": "/\u596 \u720 \u712 st\u618 r/", "definition": "Severe or strict in manner, attitude, or appearance; having no comforts or luxuries; plain and unadorned.", "definition_zh": "\u22196 \u21426 \u30340 \u65307 \u31777 \u27192 \u30340 \u65307 \u33510 \u34892 \u30340 \u65307 \u27627 \u28961 \u35037 \u39166 \u30340 ", "etymology": \{ "roots": [ \{ "root": "austeros", "origin": "Greek", "meaning": "bitter, harsh, dry", "meaning_zh": "\u33510 \u30340 \u12289 \u22196 \u21426 \u30340 \u12289 \u20094 \u29157 \u30340 " \} ] \}, "mnemonic": \{ "root_memory": "AUSTEROS\u65288 \u33510 \u28544 \u12289 \u20094 \u29157 \u65289 \u8594  \u29983 \u27963 \u36942 \u24471 \u20687 \u33510 \u34892 \u20711 \u19968 \u27171 \u20094 \u24052 \u24052 \u12289 \u27794 \u26377 \u29980 \u38957 \u30340  \u8594  \u31777 \u27192 \u32780 \u22196 \u21426 \u30340 ", "story_en": "The monk lived a very AUSTERE life in an AUSTERE room with nothing but a wooden bed.", "story_zh": "\u20711 \u20406 \u22312 \u19968 \u38291 \u38500 \u20102 \u26408 \u24202 \u22806 \u21029 \u28961 \u20182 \u29289 \u30340 \u12300 \u31777 \u27192 \u65288 AUSTERE\u65289 \u12301 \u25151 \u38291 \u35041 \u65292 \u36942 \u33879 \u38750 \u24120 \u33510 \u65288 AUSTEROS\u65289 \u34892 \u31777 \u27192 \u30340 \u29983 \u27963 \u12290 ", "emojis": ["\u55358 \u56792 ", "\u55357 \u57039 \u65039 ", "\u55358 \u56817 "] \}, "example": "During the economic crisis, the government introduced austere measures to reduce the national debt.", "example_zh": "\u22312 \u32147 \u28639 \u21361 \u27231 \u26399 \u38291 \u65292 \u25919 \u24220 \u25512 \u20986 \u20102 \u36001 \u25919 \u32202 \u32302 \u65288 \u31777 \u27192 \u12289 \u22196 \u26684 \u30340 \u65289 \u25514 \u26045 \u20197 \u28187 \u23569 \u22283 \u20661 \u12290 ", "collocations": [ "austere lifestyle", "austere measures", "austere beauty", "austere look", "severely austere" ], "synonyms": ["ascetic", "stark", "frugal", "severe", "unadorned"], "near_synonyms": [ \{ "word": "frugal", "difference": "frugal means being economical and careful with spending money on food or resources; austere implies a total lack of comfort, luxury, or ornament, often due to strict discipline." \}, \{ "word": "stark", "difference": "stark describes an appearance that is unpleasantly clear, bare, or harsh to look at." \} ], "antonyms": ["luxurious", "extravagant", "ornate", "indulgent"], "word_family": [ \{ "word": "austere", "pos": "adjective" \}, \{ "word": "austerity", "pos": "noun" \}, \{ "word": "austerely", "pos": "adverb" \} ], "frequency_rank": 79, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "economics", "philosophy"] \}, \{ "word": "autonomous", "pos": "adjective", "phonetic": "/\u596 \u720 \u712 t\u593 \u720 n\u601 m\u601 s/", "definition": "Having the freedom and power to govern itself or control its own affairs; acting independently.", "definition_zh": "\u33258 \u27835 \u30340 \u65307 \u33258 \u20027 \u30340 \u65307 \u29544 \u31435 \u33258 \u20027 \u30340 ", "etymology": \{ "roots": [ \{ "root": "auto-", "origin": "Greek", "meaning": "self", "meaning_zh": "\u33258 \u24049 " \}, \{ "root": "nomos", "origin": "Greek", "meaning": "law, rule", "meaning_zh": "\u27861 \u24459 \u12289 \u31649 \u29702 " \} ] \}, "mnemonic": \{ "root_memory": "AUTO\u65288 \u33258 \u24049 \u65289 + NOMOS\u65288 \u27861 \u24459 \u12289 \u31649 \u29702 \u65289 \u8594  \u33258 \u24049 \u31435 \u27861 \u31649 \u29702 \u33258 \u24049  \u8594  \u29544 \u31435 \u33258 \u20027 \u30340 ", "story_en": "An AUTONOMOUS vehicle uses AUTO- (self) driving systems to obey traffic NOMOS (laws) without a human driver.", "story_zh": "\u12300 \u28961 \u20154 \u39381 \u39387 \u65288 AUTONOMOUS\u65289 \u12301 \u36554 \u36635 \u20351 \u29992 \u33258 \u65288 AUTO\u65289 \u21205 \u39381 \u39387 \u31995 \u32113 \u20358 \u36981 \u23432 \u20132 \u36890 \u27861 \u35215 \u65288 NOMOS\u65289 \u65292 \u19981 \u38656 \u35201 \u20154 \u39006 \u21496 \u27231 \u12290 ", "emojis": ["\u55357 \u56983 ", "\u55356 \u57104 ", "\u55357 \u56829 "] \}, "example": "The university's research department operates as an autonomous unit, independent of the central administration.", "example_zh": "\u35442 \u22823 \u23416 \u30340 \u30740 \u31350 \u37096 \u38272 \u20316 \u28858 \u19968 \u20491 \u33258 \u20027 \u65288 \u29544 \u31435 \u65289 \u21934 \u20301 \u36939 \u20316 \u65292 \u19981 \u21463 \u20013 \u22830 \u34892 \u25919 \u37096 \u38272 \u30340 \u31649 \u36676 \u12290 ", "collocations": [ "autonomous region", "autonomous vehicle", "fully autonomous", "autonomous choice", "gain autonomous status" ], "synonyms": ["independent", "self-governing", "sovereign", "free"], "near_synonyms": [ \{ "word": "independent", "difference": "independent is a general term for not relying on others; autonomous specifically implies having the formal political or structural right to self-rule and make laws." \}, \{ "word": "sovereign", "difference": "sovereign implies supreme and absolute political power, usually referring to an entirely independent nation-state." \} ], "antonyms": ["dependent", "subordinate", "controlled"], "word_family": [ \{ "word": "autonomous", "pos": "adjective" \}, \{ "word": "autonomy", "pos": "noun" \}, \{ "word": "autonomously", "pos": "adverb" \} ], "frequency_rank": 80, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "politics", "technology"] \}, \{ "word": "benevolent", "pos": "adjective", "phonetic": "/b\u601 \u712 nev\u601 l\u601 nt/", "definition": "Well-meaning and kindly; serving a charitable rather than a profit-making purpose.", "definition_zh": "\u20161 \u24904 \u30340 \u65307 \u24904 \u21892 \u30340 \u65307 \u21892 \u24847 \u30340 ", "etymology": \{ "roots": [ \{ "root": "bene", "origin": "Latin", "meaning": "well, good", "meaning_zh": "\u22909 " \}, \{ "root": "velle", "origin": "Latin", "meaning": "to wish", "meaning_zh": "\u24819 \u35201 \u12289 \u31069 \u39000 " \} ] \}, "mnemonic": \{ "root_memory": "BENE\u65288 \u22909 \u65289 + VELLE\u65288 \u31069 \u39000 \u65289 \u8594  \u31069 \u39000 \u20182 \u20154 \u36942 \u24471 \u22909  \u8594  \u20161 \u24904 \u30340 ", "story_en": "The BENEVOLENT king always wished BENE (well) for his people, showing great kindness.", "story_zh": "\u36889 \u20301 \u12300 \u20161 \u24904 \u30340 \u65288 BENEVOLENT\u65289 \u12301 \u22283 \u29579 \u32317 \u26159 \u31069 \u39000 \u65288 VELLE\u65289 \u20182 \u30340 \u23376 \u27665 \u36942 \u24471 \u22909 \u65288 BENE\u65289 \u65292 \u23637 \u29694 \u20102 \u26997 \u22823 \u30340 \u21892 \u33391 \u12290 ", "emojis": ["\u55357 \u56839 ", "\u55358 \u56605 ", "\u55356 \u57217 "] \}, "example": "The local orphanage was entirely funded by a benevolent billionaire who wished to remain anonymous.", "example_zh": "\u30070 \u22320 \u30340 \u23396 \u20818 \u38498 \u23436 \u20840 \u26159 \u30001 \u19968 \u20301 \u24076 \u26395 \u20445 \u25345 \u21311 \u21517 \u30340 \u20161 \u24904 \u20740 \u33836 \u23500 \u32705 \u36039 \u21161 \u30340 \u12290 ", "collocations": [ "benevolent dictator", "benevolent organization", "purely benevolent", "benevolent smile", "benevolent attitude" ], "synonyms": ["kindly", "charitable", "philanthropic", "altruistic"], "near_synonyms": [ \{ "word": "charitable", "difference": "charitable specifically focuses on giving money, food, or help to poor and needy people; benevolent describes a general kindly disposition or well-meaning attitude." \}, \{ "word": "altruistic", "difference": "altruistic emphasizes self-sacrifice for the welfare of others without expecting any return." \} ], "antonyms": ["malevolent", "spiteful", "cruel", "malicious"], "word_family": [ \{ "word": "benevolent", "pos": "adjective" \}, \{ "word": "benevolence", "pos": "noun" \}, \{ "word": "benevolently", "pos": "adverb" \} ], "frequency_rank": 81, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "social", "TOEFL"] \}, \{ "word": "capricious", "pos": "adjective", "phonetic": "/k\u601 \u712 pr\u618 \u643 \u601 s/", "definition": "Given to sudden and unaccountable changes of mood or behavior; fickle and unpredictable.", "definition_zh": "\u35722 \u21270 \u28961 \u24120 \u30340 \u65307 \u20219 \u24615 \u30340 \u65307 \u21892 \u35722 \u30340 ", "etymology": \{ "roots": [ \{ "root": "capra", "origin": "Latin", "meaning": "goat", "meaning_zh": "\u23665 \u32650 " \} ] \}, "mnemonic": \{ "root_memory": "CAPRA\u65288 \u23665 \u32650 \u65289 \u8594  \u20687 \u23665 \u32650 \u19968 \u27171 \u21407 \u22320 \u20098 \u36339 \u12289 \u38627 \u20197 \u38928 \u28204 \u34892 \u36452 \u30340  \u8594  \u35722 \u21270 \u28961 \u24120 \u30340 ", "story_en": "The dictator's CAPRICIOUS moods changed as fast as a CAPRA (goat) leaping randomly in the mountains.", "story_zh": "\u29544 \u35009 \u32773 \u12300 \u35722 \u21270 \u28961 \u24120 \u30340 \u65288 CAPRICIOUS\u65289 \u12301 \u24773 \u32210 \u65292 \u23601 \u20687 \u22312 \u23665 \u20013 \u32993 \u20098 \u36339 \u36493 \u30340 \u23665 \u32650 \u65288 CAPRA\u65289 \u19968 \u27171 \u24555 \u12290 ", "emojis": ["\u55357 \u56336 ", "\u55356 \u57088 ", "\u55356 \u57126 \u65039 "] \}, "example": "The administration's capricious policy changes left local business owners confused and unable to plan ahead.", "example_zh": "\u34892 \u25919 \u37096 \u38272 \u35722 \u21270 \u28961 \u24120 \u30340 \u25919 \u31574 \u26356 \u36845 \u35731 \u30070 \u22320 \u20225 \u26989 \u20027 \u24863 \u21040 \u22256 \u24785 \u65292 \u28961 \u27861 \u25552 \u21069 \u35215 \u21123 \u12290 ", "collocations": [ "capricious weather", "capricious market", "capricious dictator", "fickle and capricious", "capricious behavior" ], "synonyms": ["fickle", "unpredictable", "whimsical", "mercurial", "arbitrary"], "near_synonyms": [ \{ "word": "arbitrary", "difference": "arbitrary means based on random choice or whim instead of reason, often in authoritative decisions; capricious adds a sense of emotional instability, fickleness, and rapid shifting." \}, \{ "word": "mercurial", "difference": "mercurial specifically describes a person's temperament that changes into anger or excitement very quickly." \} ], "antonyms": ["stable", "consistent", "predictable", "reliable"], "word_family": [ \{ "word": "capricious", "pos": "adjective" \}, \{ "word": "caprice", "pos": "noun" \}, \{ "word": "capriciously", "pos": "adverb" \} ], "frequency_rank": 82, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "GRE", "business"] \}, \{ "word": "catalyst", "pos": "noun", "phonetic": "/\u712 k\'e6t\u601 l\u618 st/", "definition": "A substance that increases the rate of a chemical reaction without itself undergoing any permanent chemical change; a person or thing that precipitates an event or change.", "definition_zh": "\u20652 \u21270 \u21137 \u65307 \u20419 \u25104 \u32773 \u65307 \u24341 \u30332 \u25913 \u35722 \u30340 \u20154 \u25110 \u20107 \u29289 ", "etymology": \{ "roots": [ \{ "root": "kata-", "origin": "Greek", "meaning": "down, thoroughly", "meaning_zh": "\u21521 \u19979 \u12289 \u24505 \u24213 " \}, \{ "root": "lyein", "origin": "Greek", "meaning": "to loosen, untie", "meaning_zh": "\u39686 \u38283 \u12289 \u35299 \u38283 " \} ] \}, "mnemonic": \{ "root_memory": "KATA\u65288 \u24505 \u24213 \u65289 + LYEIN\u65288 \u35299 \u38283 \u65289 \u8594  \u24505 \u24213 \u35299 \u38283 \u21407 \u26412 \u30340 \u21270 \u23416 \u37749 \u32080  \u8594  \u21152 \u36895 \u21453 \u25033 \u30340 \u20652 \u21270 \u21137 ", "story_en": "The assassination of the archduke acted as a CATALYST, thoroughly LYEIN (loosening) the fragile peace and starting World War I.", "story_zh": "\u22823 \u20844 \u34987 \u21050 \u27578 \u20107 \u20214 \u20805 \u30070 \u20102 \u12300 \u20652 \u21270 \u21137 \u65288 CATALYST\u65289 \u12301 \u65292 \u24505 \u24213 \u35299 \u38283 \u65288 LYEIN\u65289 \u20102 \u33030 \u24369 \u30340 \u21644 \u24179 \u65292 \u24341 \u30332 \u20102 \u31532 \u19968 \u27425 \u19990 \u30028 \u22823 \u25136 \u12290 ", "emojis": ["\u55358 \u56810 ", "\u9889 ", "\u55357 \u56485 "] \}, "example": "The publication of the book served as a catalyst for the nationwide civil rights movement.", "example_zh": "\u36889 \u26412 \u26360 \u30340 \u20986 \u29256 \u25104 \u28858 \u20840 \u22283 \u27665 \u27402 \u36939 \u21205 \u30340 \u20652 \u21270 \u21137 \u65288 \u20419 \u25104 \u32773 \u65289 \u12290 ", "collocations": [ "act as a catalyst", "chemical catalyst", "catalyst for change", "economic catalyst", "prime catalyst" ], "synonyms": ["stimulus", "spark", "incentive", "impetus", "promoter"], "near_synonyms": [ \{ "word": "stimulus", "difference": "stimulus acts as an initial encouragement or incentive that provokes a response; catalyst directly speeds up or triggers an entire complex process of transformation." \}, \{ "word": "impetus", "difference": "impetus refers to the moving force or momentum behind an action that keeps it going." \} ], "antonyms": ["inhibitor", "deterrent", "hindrance"], "word_family": [ \{ "word": "catalyst", "pos": "noun" \}, \{ "word": "catalyze", "pos": "verb" \}, \{ "word": "catalytic", "pos": "adjective" \} ], "frequency_rank": 83, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "science", "history"] \}, \{ "word": "chronic", "pos": "adjective", "phonetic": "/\u712 kr\u593 \u720 n\u618 k/", "definition": "(of an illness or problem) persisting for a long time or constantly recurring.", "definition_zh": "\u24930 \u24615 \u30340 \u65288 \u30142 \u30149 \u65289 \u65307 \u38263 \u26399 \u30340 \u65307 \u26681 \u28145 \u33922 \u22266 \u30340 ", "etymology": \{ "roots": [ \{ "root": "chronos", "origin": "Greek", "meaning": "time", "meaning_zh": "\u26178 \u38291 " \} ] \}, "mnemonic": \{ "root_memory": "CHRONOS\u65288 \u26178 \u38291 \u65289 \u8594  \u38568 \u33879 \u26178 \u38291 \u19981 \u26039 \u25302 \u24310 \u12289 \u28961 \u27861 \u26681 \u27835 \u30340  \u8594  \u24930 \u24615 \u30340 ", "story_en": "He suffered from CHRONIC back pain, which haunted him for a long CHRONOS (time).", "story_zh": "\u20182 \u24739 \u26377 \u12300 \u24930 \u24615 \u30340 \u65288 CHRONIC\u65289 \u12301 \u32972 \u30171 \u65292 \u36889 \u22256 \u25854 \u20102 \u20182 \u24456 \u38263 \u30340 \u26178 \u38291 \u65288 CHRONOS\u65289 \u12290 ", "emojis": ["\u9203 ", "\u55356 \u57317 ", "\u55358 \u56787 "] \}, "example": "The country is suffering from chronic unemployment, which the government has failed to fix for a decade.", "example_zh": "\u35442 \u22283 \u27491 \u36973 \u21463 \u38263 \u26399 \u22833 \u26989 \u30340 \u22256 \u25854 \u65292 \u25919 \u24220 \u21313 \u24180 \u20358 \u19968 \u30452 \u26410 \u33021 \u35299 \u27770 \u36889 \u19968 \u21839 \u38988 \u12290 ", "collocations": [ "chronic illness", "chronic shortage", "chronic pain", "chronic condition", "chronically unemployed" ], "synonyms": ["persistent", "long-standing", "inveterate", "perennial"], "near_synonyms": [ \{ "word": "persistent", "difference": "persistent describes something that keeps trying or happening despite obstacles; chronic implies a deep-rooted, long-term medical or structural problem that is hard to cure." \}, \{ "word": "acute", "difference": "acute means severe and sudden onset, whereas chronic means lasting for a long duration (direct antonyms in medical contexts)." \} ], "antonyms": ["acute", "temporary", "fleeting"], "word_family": [ \{ "word": "chronic", "pos": "adjective" \}, \{ "word": "chronicle", "pos": "noun / verb" \}, \{ "word": "chronically", "pos": "adverb" \} ], "frequency_rank": 84, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "academic", "science"] \}, \{ "word": "circumspect", "pos": "adjective", "phonetic": "/\u712 s\u604 \u720 rk\u601 mspekt/", "definition": "Wary and unwilling to take risks; cautious and prudent before acting.", "definition_zh": "\u35641 \u24910 \u30340 \u65307 \u32771 \u24942 \u21608 \u23494 \u30340 \u65307 \u24910 \u37325 \u30340 ", "etymology": \{ "roots": [ \{ "root": "circum", "origin": "Latin", "meaning": "around", "meaning_zh": "\u21608 \u22285 \u12289 \u29872 \u32350 " \}, \{ "root": "specere", "origin": "Latin", "meaning": "to look", "meaning_zh": "\u30475 " \} ] \}, "mnemonic": \{ "root_memory": "CIRCUM\u65288 \u22235 \u21608 \u65289 + SPECERE\u65288 \u30475 \u65289 \u8594  \u24448 \u22235 \u21608 \u20180 \u32048 \u30475 \u28165 \u26970 \u20877 \u21069 \u36914  \u8594  \u35641 \u24910 \u30340 ", "story_en": "A CIRCUMSPECT general will always CIRCUM (around) SPEC (look) at the terrain before ordering an attack.", "story_zh": "\u19968 \u20301 \u12300 \u35641 \u24910 \u30340 \u65288 CIRCUMSPECT\u65289 \u12301 \u23559 \u36557 \u22312 \u19979 \u20196 \u36914 \u25915 \u21069 \u65292 \u32317 \u26371 \u21521 \u22235 \u21608 \u65288 CIRCUM\u65289 \u29872 \u39015 \u35264 \u23519 \u65288 SPECERE\u65289 \u22320 \u24418 \u12290 ", "emojis": ["\u55357 \u56384 ", "\u55357 \u57057 \u65039 ", "\u55357 \u56693 \u65039 "] \}, "example": "Officials were circumspect in their statements to the press, avoiding any mention of the ongoing investigation.", "example_zh": "\u23448 \u21729 \u20497 \u22312 \u21521 \u23186 \u39636 \u30332 \u34920 \u32882 \u26126 \u26178 \u38750 \u24120 \u35641 \u24910 \u65292 \u36991 \u20813 \u25552 \u21450 \u27491 \u22312 \u36914 \u34892 \u30340 \u35519 \u26597 \u12290 ", "collocations": [ "highly circumspect", "circumspect approach", "circumspect behavior", "remain circumspect", "circumspect language" ], "synonyms": ["cautious", "prudent", "wary", "guarded", "vigilant"], "near_synonyms": [ \{ "word": "cautious", "difference": "cautious is a general term for avoiding danger; circumspect emphasizes looking at all possible consequences and angles before making a major decision." \}, \{ "word": "wary", "difference": "wary implies a specific suspicion or fear of being deceived by an external threat." \} ], "antonyms": ["reckless", "rash", "incautious", "foolhardy"], "word_family": [ \{ "word": "circumspect", "pos": "adjective" \}, \{ "word": "circumspection", "pos": "noun" \}, \{ "word": "circumspectly", "pos": "adverb" \} ], "frequency_rank": 85, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "GRE", "politics"] \}, \{ "word": "coherent", "pos": "adjective", "phonetic": "/ko\u650 \u712 h\u618 r\u601 nt/", "definition": "(of an argument, theory, or policy) logical and consistent; united as or forming a whole.", "definition_zh": "\u26781 \u29702 \u28165 \u26224 \u30340 \u65307 \u36899 \u36011 \u30340 \u65307 \u19968 \u33268 \u30340 \u65307 \u20957 \u32858 \u30340 ", "etymology": \{ "roots": [ \{ "root": "co-", "origin": "Latin", "meaning": "together", "meaning_zh": "\u20849 \u21516 \u12289 \u19968 \u36215 " \}, \{ "root": "haere / haerere", "origin": "Latin", "meaning": "to stick", "meaning_zh": "\u40655 \u36028 \u12289 \u36899 \u32080 " \} ] \}, "mnemonic": \{ "root_memory": "CO\u65288 \u20849 \u21516 \u65289 + HAERE\u65288 \u40655 \u65289 \u8594  \u25152 \u26377 \u30340 \u24819 \u27861 \u37117 \u32202 \u32202 \u40655 \u22312 \u19968 \u36215  \u8594  \u26781 \u29702 \u28165 \u26224 \u19988 \u36899 \u36011 \u30340 ", "story_en": "An essay must be COHERENT, meaning all points stick (haere) CO- (together) logically to form one clear idea.", "story_zh": "\u25991 \u31456 \u24517 \u38920 \u26159 \u12300 \u36899 \u36011 \u30340 \u65288 COHERENT\u65289 \u12301 \u65292 \u36889 \u24847 \u21619 \u33879 \u25152 \u26377 \u35264 \u40670 \u37117 \u24517 \u38920 \u37007 \u36655 \u22320 \u40655 \u65288 HAERE\u65289 \u22312 \u19968 \u36215 \u65288 CO\u65289 \u12290 ", "emojis": ["\u55357 \u56541 ", "\u55357 \u56599 ", "\u55358 \u56809 "] \}, "example": "The defense attorney failed to present a coherent narrative, confusing the jury with conflicting facts.", "example_zh": "\u36783 \u35703 \u24459 \u24107 \u26410 \u33021 \u25552 \u20986 \u19968 \u20491 \u26781 \u29702 \u28165 \u26224 \u30340 \u25944 \u20107 \u65292 \u29992 \u30456 \u20114 \u30683 \u30462 \u30340 \u20107 \u23526 \u25630 \u28151 \u20102 \u38506 \u23529 \u22296 \u12290 ", "collocations": [ "coherent argument", "coherent policy", "coherent strategy", "lack a coherent plan", "perfectly coherent" ], "synonyms": ["logical", "consistent", "articulate", "lucid"], "near_synonyms": [ \{ "word": "lucid", "difference": "lucid focuses on being easy to understand and clear to the mind; coherent focuses on the internal structural consistency and logical connection of parts." \}, \{ "word": "consistent", "difference": "consistent means acting or performing in the same way over time without contradicting oneself." \} ], "antonyms": ["incoherent", "disjointed", "illogical", "confused"], "word_family": [ \{ "word": "coherent", "pos": "adjective" \}, \{ "word": "coherence", "pos": "noun" \}, \{ "word": "coherently", "pos": "adverb" \} ], "frequency_rank": 86, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "academic", "language"] \}, \{ "word": "compensate", "pos": "verb", "phonetic": "/\u712 k\u593 \u720 mpense\u618 t/", "definition": "To give someone something, typically money, in recognition of loss, suffering, or injury; to make up for something unwelcome or unpleasant.", "definition_zh": "\u35036 \u20767 \u65307 \u36064 \u20767 \u65307 \u24396 \u35036 ", "etymology": \{ "roots": [ \{ "root": "com-", "origin": "Latin", "meaning": "together", "meaning_zh": "\u19968 \u36215 " \}, \{ "root": "pendere / pensare", "origin": "Latin", "meaning": "to weigh, pay out", "meaning_zh": "\u31281 \u37325 \u12289 \u34913 \u37327 \u12289 \u20184 \u37666 " \} ] \}, "mnemonic": \{ "root_memory": "COM\u65288 \u19968 \u36215 \u65289 + PENSARE\u65288 \u31281 \u37325 \u12289 \u34913 \u37327 \u65289 \u8594  \u25226 \u25613 \u22833 \u21644 \u37666 \u25918 \u22312 \u22825 \u24179 \u20841 \u31471 \u19968 \u36215 \u31281 \u37325 \u24179 \u34913  \u8594  \u35036 \u20767 ", "story_en": "The airline had to COMPENSATE the passengers, WEIGHING (pensare) the cash refund COM- (together) with their lost vacation time.", "story_zh": "\u33322 \u31354 \u20844 \u21496 \u24517 \u38920 \u12300 \u35036 \u20767 \u65288 COMPENSATE\u65289 \u12301 \u20056 \u23458 \u65292 \u23559 \u29694 \u37329 \u36864 \u27454 \u33287 \u20182 \u20497 \u25613 \u22833 \u30340 \u20551 \u26399 \u26178 \u38291 \u25918 \u22312 \u19968 \u36215 \u31281 \u37325 \u65288 PENSARE\u65289 \u34913 \u37327 \u20197 \u36948 \u24179 \u34913 \u12290 ", "emojis": ["\u9878 \u65039 ", "\u55357 \u56496 ", "\u55358 \u56953 "] \}, "example": "The company promised to fully compensate the residents for the property damage caused by the pipeline explosion.", "example_zh": "\u20844 \u21496 \u25215 \u35582 \u23565 \u22240 \u31649 \u36947 \u29190 \u28856 \u36896 \u25104 \u30340 \u36001 \u29986 \u25613 \u22833 \u32102 \u20104 \u23621 \u27665 \u20805 \u20998 \u36064 \u20767 \u12290 ", "collocations": [ "compensate victims", "compensate for losses", "highly compensated", "compensate for a lack of", "workers' compensation" ], "synonyms": ["reimburse", "indemnify", "make up for", "offset", "atone"], "near_synonyms": [ \{ "word": "reimburse", "difference": "reimburse strictly means to pay back the exact amount of money someone has already spent; compensate is broader and covers paying for emotional pain, physical injury, or time lost." \}, \{ "word": "offset", "difference": "offset means to counterbalance or neutralize one effect by having an opposing effect (e.g., carbon offsetting)." \} ], "antonyms": ["deprive", "penalize", "damage"], "word_family": [ \{ "word": "compensate", "pos": "verb" \}, \{ "word": "compensation", "pos": "noun" \}, \{ "word": "compensatory", "pos": "adjective" \} ], "frequency_rank": 87, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "business", "law"] \}, \{ "word": "complacent", "pos": "adjective", "phonetic": "/k\u601 m\u712 ple\u618 snt/", "definition": "Showing smug or uncritical satisfaction with oneself or one's achievements, often while remaining unaware of upcoming dangers.", "definition_zh": "\u33258 \u28415 \u30340 \u65307 \u27838 \u27838 \u33258 \u21916 \u30340 \u65307 \u30450 \u30446 \u27138 \u35264 \u30340 ", "etymology": \{ "roots": [ \{ "root": "com-", "origin": "Latin", "meaning": "intensive prefix", "meaning_zh": "\u21152 \u24375 \u35486 \u27683 " \}, \{ "root": "placere", "origin": "Latin", "meaning": "to please", "meaning_zh": "\u20351 \u39640 \u33288 \u12289 \u21462 \u24709 " \} ] \}, "mnemonic": \{ "root_memory": "COM\u65288 \u26997 \u24230 \u65289 + PLACERE\u65288 \u21462 \u24709 \u12289 \u39640 \u33288 \u65289 \u8594  \u35731 \u33258 \u24049 \u36942 \u24230 \u39640 \u33288  \u8594  \u30450 \u30446 \u33258 \u28415 ", "story_en": "The champion became COMPLACENT, so thoroughly PLEASed (placere) with his past wins that he stopped training hard.", "story_zh": "\u36889 \u20301 \u20896 \u36557 \u35722 \u24471 \u12300 \u33258 \u28415 \u65288 COMPLACENT\u65289 \u12301 \u65292 \u23565 \u33258 \u24049 \u36942 \u21435 \u30340 \u21213 \u21033 \u24863 \u21040 \u22826 \u36942 \u39640 \u33288 \u65288 PLACERE\u65289 \u65292 \u20197 \u33267 \u26044 \u20572 \u27490 \u20102 \u21051 \u33510 \u35347 \u32244 \u12290 ", "emojis": ["\u55357 \u56847 ", "\u55356 \u57286 ", "\u9888 \u65039 "] \}, "example": "We cannot afford to become complacent about market competition, as rival startups are launching new products every month.", "example_zh": "\u25105 \u20497 \u19981 \u33021 \u23565 \u24066 \u22580 \u31478 \u29229 \u24863 \u21040 \u33258 \u28415 \u65292 \u22240 \u28858 \u31478 \u29229 \u23565 \u25163 \u26032 \u21109 \u20844 \u21496 \u27599 \u20491 \u26376 \u37117 \u22312 \u25512 \u20986 \u26032 \u29986 \u21697 \u12290 ", "collocations": [ "become complacent", "complacent attitude", "grow complacent", "dangerously complacent", "complacent smile" ], "synonyms": ["smug", "self-satisfied", "conceited", "unconcerned"], "near_synonyms": [ \{ "word": "smug", "difference": "smug implies an annoying, proud, and outward display of satisfaction to others; complacent emphasizes a quiet, passive laziness and blindness to potential threats due to past success." \}, \{ "word": "satisfied", "difference": "satisfied is a positive, healthy feeling of fulfillment after achieving a goal without the negative connotation of blindness or laziness." \} ], "antonyms": ["anxious", "ambitious", "dissatisfied", "humble"], "word_family": [ \{ "word": "complacent", "pos": "adjective" \}, \{ "word": "complacency", "pos": "noun" \}, \{ "word": "complacently", "pos": "adverb" \} ], "usage_note": "Do not confuse 'complacent' with 'complaisant'. Complaisant means willing to please others or overly obliging.", "frequency_rank": 88, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "business", "GRE"] \}, \{ "word": "complement", "pos": "verb", "phonetic": "/\u712 k\u593 \u720 mpl\u618 ment/", "definition": "To add to something in a way that enhances or improves it; to make something perfect or complete.", "definition_zh": "\u35036 \u20805 \u65307 \u33287 ...\u30456 \u36628 \u30456 \u25104 \u65307 \u20351 \u23436 \u32654 ", "etymology": \{ "roots": [ \{ "root": "com-", "origin": "Latin", "meaning": "intensive prefix", "meaning_zh": "\u21152 \u24375 \u35486 \u27683 " \}, \{ "root": "plere", "origin": "Latin", "meaning": "to fill", "meaning_zh": "\u22635 \u28415 \u12289 \u20805 \u28415 " \} ] \}, "mnemonic": \{ "root_memory": "COM\u65288 \u23436 \u20840 \u65289 + PLERE\u65288 \u22635 \u28415 \u65289 \u8594  \u25226 \u31354 \u32570 \u30340 \u22320 \u26041 \u23436 \u20840 \u22635 \u28415  \u8594  \u35036 \u36275 \u20006 \u20351 \u20043 \u23436 \u32654 ", "story_en": "The red wine will COMPLEMENT the steak, FILLing (plere) the meal to perfection.", "story_zh": "\u32005 \u37202 \u23559 \u33287 \u29275 \u25490 \u12300 \u30456 \u24471 \u30410 \u24432 \u65288 COMPLEMENT\u65289 \u12301 \u65292 \u23559 \u36889 \u38931 \u39151 \u23436 \u20840 \u22635 \u28415 \u65288 PLERE\u65289 \u33267 \u23436 \u32654 \u30340 \u22659 \u30028 \u12290 ", "emojis": ["\u55356 \u57207 ", "\u55358 \u56681 ", "\u55358 \u56809 "] \}, "example": "The dynamic skills of the two business partners complement each other perfectly, driving the company's success.", "example_zh": "\u36889 \u20841 \u20301 \u21830 \u26989 \u22821 \u20276 \u30340 \u21205 \u24907 \u25216 \u33021 \u23436 \u32654 \u22320 \u30456 \u36628 \u30456 \u25104 \u65292 \u25512 \u21205 \u20102 \u20844 \u21496 \u30340 \u25104 \u21151 \u12290 ", "collocations": [ "complement each other", "perfectly complement", "designed to complement", "complementary colors", "complementary skills" ], "synonyms": ["supplement", "enhance", "complete", "match"], "near_synonyms": [ \{ "word": "supplement", "difference": "supplement means to add something extra to supply a deficiency or increase a size; complement emphasizes making a perfect combination where both parts look or work better together." \}, \{ "word": "match", "difference": "match means to be identical or harmoniously similar in color, style, or quality." \} ], "antonyms": ["clash", "contradict", "detract from", "spoil"], "word_family": [ \{ "word": "complement", "pos": "verb / noun" \}, \{ "word": "complementary", "pos": "adjective" \} ], "usage_note": "Do not confuse 'complement' with 'compliment'. Compliment means to praise someone (e.g., 'compliment the chef'). Both have identical pronunciation.", "frequency_rank": 89, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "business", "art"] \}, \{ "word": "comprehensive", "pos": "adjective", "phonetic": "/\u716 k\u593 \u720 mpr\u618 \u712 hens\u618 v/", "definition": "Including or dealing with all or nearly all elements or aspects of something; wide-ranging and thorough.", "definition_zh": "\u20840 \u38754 \u30340 \u65307 \u24291 \u27867 \u30340 \u65307 \u32156 \u21512 \u30340 \u65307 \u35443 \u30433 \u30340 ", "etymology": \{ "roots": [ \{ "root": "com-", "origin": "Latin", "meaning": "together", "meaning_zh": "\u19968 \u36215 " \}, \{ "root": "prehendere", "origin": "Latin", "meaning": "to seize, grasp", "meaning_zh": "\u25235 \u20303 \u12289 \u29702 \u35299 " \} ] \}, "mnemonic": \{ "root_memory": "COM\u65288 \u19968 \u36215 \u65289 + PREHENDERE\u65288 \u25235 \u20303 \u65289 \u8594  \u25226 \u25152 \u26377 \u26481 \u35199 \u32113 \u32113 \u25235 \u22312 \u19968 \u36215 \u19981 \u28431 \u25481  \u8594  \u20840 \u38754 \u30340 ", "story_en": "The guide offers a COMPREHENSIVE review, GRASPing (prehendere) all exam topics COM- (together) in one book.", "story_zh": "\u36889 \u26412 \u25351 \u21335 \u25552 \u20379 \u20102 \u12300 \u20840 \u38754 \u30340 \u65288 COMPREHENSIVE\u65289 \u12301 \u35079 \u32722 \u65292 \u23559 \u25152 \u26377 \u32771 \u35430 \u20027 \u38988 \u32113 \u32113 \u25235 \u65288 PREHENDERE\u65289 \u22312 \u19968 \u36215 \u65288 COM\u65289 \u12290 ", "emojis": ["\u55357 \u56550 ", "\u55357 \u56538 ", "\u55356 \u57104 "] \}, "example": "The university insurance policy offers comprehensive coverage for medical treatments, including dental care.", "example_zh": "\u22823 \u23416 \u30340 \u20445 \u38570 \u25919 \u31574 \u28858 \u37291 \u30274 \u26381 \u21209 \u25552 \u20379 \u20840 \u38754 \u30340 \u20445 \u38556 \u65292 \u21253 \u25324 \u29273 \u31185 \u27835 \u30274 \u12290 ", "collocations": [ "comprehensive insurance", "comprehensive study", "comprehensive review", "comprehensive report", "comprehensive understanding" ], "synonyms": ["exhaustive", "thorough", "all-inclusive", "extensive"], "near_synonyms": [ \{ "word": "exhaustive", "difference": "exhaustive means so thorough that it completely drains or tests all available resources, details, or options; comprehensive means broad enough to cover all major aspects, but not necessarily exhausting every micro-detail." \}, \{ "word": "detailed", "difference": "detailed means containing lots of individual facts, regardless of whether it covers the entire scope of a topic." \} ], "antonyms": ["partial", "selective", "limited", "incomplete"], "word_family": [ \{ "word": "comprehensive", "pos": "adjective" \}, \{ "word": "comprehend", "pos": "verb" \}, \{ "word": "comprehension", "pos": "noun" \}, \{ "word": "comprehensively", "pos": "adverb" \} ], "frequency_rank": 90, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "academic", "business"] \}, \{ "word": "condone", "pos": "verb", "phonetic": "/k\u601 n\u712 do\u650 n/", "definition": "To accept and allow (behavior that is considered morally wrong or offensive) to continue; to overlook or forgive.", "definition_zh": "\u32305 \u23481 \u65307 \u23532 \u24661 \u65307 \u40664 \u35377 \u65288 \u22750 \u20107 \u65289 ", "etymology": \{ "roots": [ \{ "root": "com-", "origin": "Latin", "meaning": "intensive prefix", "meaning_zh": "\u21152 \u24375 \u35486 \u27683 " \}, \{ "root": "donare", "origin": "Latin", "meaning": "to give, grant", "meaning_zh": "\u32102 \u20104 \u12289 \u36104 \u36865 " \} ] \}, "mnemonic": \{ "root_memory": "COM\u65288 \u23436 \u20840 \u65289 + DONARE\u65288 \u32102 \u20104 \u12289 \u35905 \u20813 \u65289 \u8594  \u23436 \u20840 \u32102 \u20104 \u21407 \u35538 \u25110 \u35905 \u20813  \u8594  \u32305 \u23481 \u22750 \u20107 ", "story_en": "By remaining silent, the principal seemed to CONDONE bullying, GRANTing (donare) complete freedom to the bullies.", "story_zh": "\u26657 \u38263 \u36879 \u36942 \u20445 \u25345 \u27785 \u40664 \u65292 \u20284 \u20046 \u12300 \u32305 \u23481 \u65288 CONDONE\u65289 \u12301 \u20102 \u26657 \u22290 \u38712 \u20940 \u65292 \u23436 \u20840 \u32102 \u20104 \u65288 DONARE\u65289 \u20102 \u24801 \u38712 \u20497 \u28858 \u25152 \u27442 \u28858 \u30340 \u33258 \u30001 \u12290 ", "emojis": ["\u55357 \u56904 ", "\u55357 \u57003 ", "\u9878 \u65039 "] \}, "example": "The school board made it clear that they do not condone cheating under any circumstances.", "example_zh": "\u23416 \u26657 \u33891 \u20107 \u26371 \u26126 \u30906 \u34920 \u31034 \u65292 \u20182 \u20497 \u22312 \u20219 \u20309 \u24773 \u27841 \u19979 \u37117 \u19981 \u26371 \u32305 \u23481 \u20316 \u24330 \u34892 \u28858 \u12290 ", "collocations": [ "condone violence", "refuse to condone", "condone cheating", "seem to condone", "never condoned" ], "synonyms": ["overlook", "pardon", "excuse", "tolerate", "wink at"], "near_synonyms": [ \{ "word": "tolerate", "difference": "tolerate means to endure or permit something unpleasant or different without actively opposing it; condone carries a heavier moral weight, implying that you tacitly approve of or forgive a wrong or illegal action." \}, \{ "word": "forgive", "difference": "forgive focuses on releasing personal anger or resentment toward an individual offender." \} ], "antonyms": ["condemn", "punish", "forbid", "prosecute"], "word_family": [ \{ "word": "condone", "pos": "verb" \} ], "frequency_rank": 91, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "GRE", "law"] \}, \{ "word": "conducive", "pos": "adjective", "phonetic": "/k\u601 n\u712 du\u720 s\u618 v/", "definition": "Making a certain situation or outcome likely or possible; contributing to a result.", "definition_zh": "\u26377 \u21161 \u26044 ...\u30340 \u65307 \u20419 \u25104 ...\u30340 ", "etymology": \{ "roots": [ \{ "root": "com-", "origin": "Latin", "meaning": "together", "meaning_zh": "\u19968 \u36215 " \}, \{ "root": "ducere", "origin": "Latin", "meaning": "to lead", "meaning_zh": "\u24341 \u23566 \u12289 \u24118 \u38936 " \} ] \}, "mnemonic": \{ "root_memory": "COM\u65288 \u19968 \u36215 \u65289 + DUCERE\u65288 \u24341 \u23566 \u65289 \u8594  \u25226 \u21508 \u31278 \u26781 \u20214 \u19968 \u36215 \u24341 \u23566 \u21521 \u26576 \u20491 \u22909 \u32080 \u26524  \u8594  \u26377 \u21161 \u26044 \u30340 ", "story_en": "A quiet room with bright lights is CONDUCIVE to study, helping to LEAD (ducere) your mind toward focus.", "story_zh": "\u20809 \u32218 \u26126 \u20142 \u30340 \u23433 \u38748 \u25151 \u38291 \u12300 \u26377 \u21161 \u26044 \u65288 CONDUCIVE\u65289 \u12301 \u23416 \u32722 \u65292 \u26377 \u21161 \u26044 \