\outl0\strokewidth0 \strokec2 [ \{ "word": "subsequent", "pos": "adjective", "phonetic": "/\uc0\u712 s\u652 bs\u618 kw\u601 nt/", "definition": "Coming after something else in time; following or succeeding in a chronological order.", "definition_zh": "\u38568 \u24460 \u30340 \u65307 \u24460 \u20358 \u30340 \u65307 \u25509 \u32396 \u30340 ", "etymology": \{ "roots": [ \{ "root": "sub", "origin": "Latin", "meaning": "under, close after", "meaning_zh": "\u22312 ...\u19979 \u38754 \u12289 \u32202 \u38568 \u20854 \u24460 " \}, \{ "root": "sequi", "origin": "Latin", "meaning": "to follow", "meaning_zh": "\u36319 \u38568 " \} ] \}, "mnemonic": \{ "root_memory": "SUB\u65288 \u32202 \u38568 \u20854 \u24460 \u65289 + SEQUI\u65288 \u36319 \u38568 \u65289 \u8594  \u32202 \u32202 \u36319 \u22312 \u24460 \u38754 \u30340 ", "story_en": "In a SUB (close after) sequence, the SEQUI (following) events will show the SUBSEQUENT impact of the decision.", "story_zh": "\u22312 \u32202 \u25509 \u32780 \u20358 \u30340 \u24207 \u21015 \u20013 \u65292 \u36319 \u38568 \u65288 SEQUI\u65289 \u22312 \u24460 \u65288 SUB\u65289 \u30340 \u20107 \u20214 \u23559 \u25581 \u31034 \u35442 \u27770 \u23450 \u30340 \u12300 \u38568 \u24460 \u65288 SUBSEQUENT\u65289 \u12301 \u24433 \u38911 \u12290 ", "emojis": ["\u9203 ", "\u9197 \u65039 ", "\u55357 \u56521 "] \}, "example": "The initial study was flawed, but subsequent research confirmed the medication's effectiveness.", "example_zh": "\u26368 \u21021 \u30340 \u30740 \u31350 \u26377 \u32570 \u38519 \u65292 \u20294 \u38568 \u24460 \u30340 \u30740 \u31350 \u35657 \u23526 \u20102 \u35442 \u34277 \u29289 \u30340 \u30274 \u25928 \u12290 ", "collocations": [ "subsequent events", "subsequent generations", "subsequent to the meeting", "in subsequent years", "subsequent analysis" ], "synonyms": ["following", "succeeding", "consequent", "ensuing"], "near_synonyms": [ \{ "word": "consecutive", "difference": "consecutive emphasizes an uninterrupted, continuous back-to-back sequence; subsequent merely means occurring later in time." \}, \{ "word": "later", "difference": "later is more general and informal; subsequent implies a closer chronological or causal link to a preceding event." \} ], "antonyms": ["previous", "prior", "preceding"], "word_family": [ \{ "word": "subsequent", "pos": "adjective" \}, \{ "word": "subsequently", "pos": "adverb" \} ], "usage_note": "The phrase 'subsequent to' can be used as a formal preposition meaning 'after' (e.g., 'subsequent to the investigation').", "frequency_rank": 51, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "academic", "IELTS"] \}, \{ "word": "substantiate", "pos": "verb", "phonetic": "/s\u601 b\u712 st\'e6n\u643 ie\u618 t/", "definition": "To provide evidence to support or prove the truth of a claim, theory, or allegation.", "definition_zh": "\u35657 \u23526 \u65307 \u35657 \u26126 ...\u26377 \u26681 \u25818 ", "etymology": \{ "roots": [ \{ "root": "sub", "origin": "Latin", "meaning": "under", "meaning_zh": "\u22312 ...\u20043 \u19979 " \}, \{ "root": "stare", "origin": "Latin", "meaning": "to stand", "meaning_zh": "\u31449 \u31435 " \} ] \}, "mnemonic": \{ "root_memory": "SUB\u65288 \u22312 \u19979 \u65289 + STARE\u65288 \u31449 \u31435 \u65289 \u8594  \u22312 \u19979 \u38754 \u31449 \u24471 \u20303 \u33139 \u30340 \u23526 \u39636  \u8594  \u25343 \u20986 \u35657 \u25818 \u20351 \u20043 \u31337 \u22266 ", "story_en": "You must find solid substance under the claim so that it can STAnd firmly and SUBSTANTIATE your argument in court.", "story_zh": "\u20320 \u24517 \u38920 \u22312 \u25351 \u25511 \u19979 \u26041 \u25214 \u21040 \u23526 \u36074 \u35657 \u25818 \u65292 \u20351 \u20854 \u33021 \u22816 \u31337 \u22266 \u31449 \u65288 STAre\u65289 \u31435 \u65292 \u36914 \u32780 \u12300 \u35657 \u23526 \u65288 SUBSTANTIATE\u65289 \u12301 \u20320 \u22312 \u27861 \u24237 \u19978 \u30340 \u35542 \u40670 \u12290 ", "emojis": ["\u55357 \u56540 ", "\u55357 \u56589 ", "\u9878 \u65039 "] \}, "example": "The prosecutor failed to provide sufficient evidence to substantiate the charges against the suspect.", "example_zh": "\u27298 \u23519 \u23448 \u26410 \u33021 \u25552 \u20379 \u20805 \u20998 \u30340 \u35657 \u25818 \u20358 \u35657 \u23526 \u23565 \u23244 \u30097 \u20154 \u30340 \u25351 \u25511 \u12290 ", "collocations": [ "substantiate a claim", "substantiate allegations", "substantiate a theory", "amply substantiated", "fail to substantiate" ], "synonyms": ["corroborate", "verify", "validate", "authenticate"], "near_synonyms": [ \{ "word": "prove", "difference": "prove implies absolute, logical, or scientific certainty; substantiate emphasizes supporting a claim with concrete, corroborating facts." \}, \{ "word": "confirm", "difference": "confirm means to declare that something is true based on facts; substantiate focuses heavily on the act of supplying the physical evidence itself." \} ], "antonyms": ["refute", "disprove", "contradict"], "word_family": [ \{ "word": "substantiate", "pos": "verb" \}, \{ "word": "substantiation", "pos": "noun" \}, \{ "word": "substantial", "pos": "adjective" \} ], "frequency_rank": 52, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "GRE", "law"] \}, \{ "word": "superficial", "pos": "adjective", "phonetic": "/\u716 su\u720 p\u601 r\u712 f\u618 \u643 l/", "definition": "Existing or occurring at or on the surface; lacking depth, substance, or thoroughness.", "definition_zh": "\u34920 \u38754 \u30340 \u65307 \u33178 \u28154 \u30340 \u65307 \u33609 \u29575 \u30340 ", "etymology": \{ "roots": [ \{ "root": "super", "origin": "Latin", "meaning": "above, over", "meaning_zh": "\u22312 ...\u20043 \u19978 \u12289 \u36229 \u36942 " \}, \{ "root": "facies", "origin": "Latin", "meaning": "face, appearance", "meaning_zh": "\u33225 \u12289 \u22806 \u34920 " \} ] \}, "mnemonic": \{ "root_memory": "SUPER\u65288 \u20043 \u19978 \u65289 + FACIES\u65288 \u34920 \u38754 \u12289 \u33225 \u65289 \u8594  \u21482 \u20572 \u30041 \u22312 \u34920 \u38754 \u22806 \u35264 \u30340 ", "story_en": "He only looked at the SUPER (above) FACIES (face) of the problem, making a very SUPERFICIAL analysis.", "story_zh": "\u20182 \u21482 \u30475 \u21839 \u38988 \u20043 \u65288 SUPER\u65289 \u19978 \u30340 \u34920 \u38754 \u65288 FACIES\u65289 \u65292 \u20570 \u20986 \u20102 \u38750 \u24120 \u12300 \u33178 \u28154 \u30340 \u65288 SUPERFICIAL\u65289 \u12301 \u20998 \u26512 \u12290 ", "emojis": ["\u55356 \u57098 ", "\u55356 \u57261 ", "\u55357 \u56516 "] \}, "example": "The committee made a superficial review of the proposal without analyzing its long-term financial risks.", "example_zh": "\u22996 \u21729 \u26371 \u23565 \u35442 \u25552 \u26696 \u36914 \u34892 \u20102 \u33178 \u28154 \u30340 \u23529 \u26597 \u65292 \u32780 \u27794 \u26377 \u20998 \u26512 \u20854 \u38263 \u26399 \u30340 \u36001 \u21209 \u39080 \u38570 \u12290 ", "collocations": [ "superficial knowledge", "superficial wound", "superficial resemblance", "purely superficial", "superficial analysis" ], "synonyms": ["shallow", "surface-level", "cursory", "frivolous"], "near_synonyms": [ \{ "word": "cursory", "difference": "cursory describes a hasty and brief action or glance; superficial describes a permanent lack of depth in thought, knowledge, or structure." \}, \{ "word": "frivolous", "difference": "frivolous means lacking any serious purpose or value; superficial means lacking depth but can still refer to physical surfaces or basic understanding." \} ], "antonyms": ["profound", "deep", "thorough"], "word_family": [ \{ "word": "superficial", "pos": "adjective" \}, \{ "word": "superficiality", "pos": "noun" \}, \{ "word": "superficially", "pos": "adverb" \} ], "frequency_rank": 53, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "academic", "TOEFL"] \}, \{ "word": "supersede", "pos": "verb", "phonetic": "/\u716 su\u720 p\u601 r\u712 si\u720 d/", "definition": "To take the place of a person or thing previously in authority or use; to replace or supplant.", "definition_zh": "\u21462 \u20195 \u65307 \u26367 \u20195 \u65307 \u24290 \u26820 \u65288 \u22240 \u26032 \u20107 \u29289 \u20986 \u29694 \u65289 ", "etymology": \{ "roots": [ \{ "root": "super", "origin": "Latin", "meaning": "above, over", "meaning_zh": "\u22312 ...\u20043 \u19978 " \}, \{ "root": "sedere", "origin": "Latin", "meaning": "to sit", "meaning_zh": "\u22352 " \} ] \}, "mnemonic": \{ "root_memory": "SUPER\u65288 \u22312 \u20043 \u19978 \u65289 + SEDERE\u65288 \u22352 \u65289 \u8594  \u22352 \u21040 \u21407 \u26412 \u20301 \u32622 \u30340 \u19978 \u26041  \u8594  \u25226 \u33290 \u30340 \u22739 \u19979 \u21435 \u20006 \u21462 \u32780 \u20195 \u20043 ", "story_en": "The new digital technology will SUPER (above) SEDE (sit) the old analog systems completely.", "story_zh": "\u26032 \u25976 \u20301 \u25216 \u34899 \u23559 \u22352 \u65288 SEDE\u65289 \u22312 \u33290 \u39006 \u27604 \u31995 \u32113 \u20043 \u65288 SUPER\u65289 \u19978 \u65292 \u23436 \u20840 \u12300 \u21462 \u20195 \u65288 SUPERSEDE\u65289 \u12301 \u23427 \u12290 ", "emojis": ["\u55357 \u56561 ", "\u55357 \u56580 ", "\u55357 \u56401 "] \}, "example": "Most of these old regulations have been superseded by the new environmental protection law.", "example_zh": "\u36889 \u20123 \u33290 \u27861 \u35215 \u30340 \u22823 \u37096 \u20998 \u24050 \u34987 \u26032 \u30340 \u29872 \u22659 \u20445 \u35703 \u27861 \u25152 \u21462 \u20195 \u12290 ", "collocations": [ "be superseded by", "largely superseded", "supersede old technology", "supersede a regulation", "eventually superseded" ], "synonyms": ["replace", "supplant", "override", "displace"], "near_synonyms": [ \{ "word": "replace", "difference": "replace is a general term for putting something new in place of the old; supersede emphasizes that the old is now obsolete or invalid." \}, \{ "word": "supplant", "difference": "supplant often implies replacing through political scheming, force, or underhanded means." \} ], "antonyms": ["retain", "maintain", "perpetuate"], "word_family": [ \{ "word": "supersede", "pos": "verb" \} ], "usage_note": "Note the spelling: it ends in '-sede', unlike 'concede', 'precede', or 'proceed' which end in '-cede' or '-ceed'.", "frequency_rank": 54, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "GRE", "technology"] \}, \{ "word": "tangible", "pos": "adjective", "phonetic": "/\u712 t\'e6nd\u658 \u601 bl/", "definition": "Perceptible by touch; clear and definite; real rather than imaginary.", "definition_zh": "\u26377 \u24418 \u30340 \u65307 \u23526 \u36074 \u30340 \u65307 \u21487 \u35320 \u25720 \u21040 \u30340 \u65307 \u26126 \u30906 \u30340 ", "etymology": \{ "roots": [ \{ "root": "tang / tangere", "origin": "Latin", "meaning": "to touch", "meaning_zh": "\u35320 \u25720 " \} ] \}, "mnemonic": \{ "root_memory": "TANG\u65288 \u35320 \u25720 \u65289 \u8594  \u33021 \u29992 \u25163 \u35320 \u25720 \u21040 \u30340  \u8594  \u30495 \u23526 \u23384 \u22312 \u30340 ", "story_en": "Without TANGible assets that you can TANG (touch), the bank will not approve your business loan.", "story_zh": "\u22914 \u26524 \u27794 \u26377 \u21487 \u20197 \u29992 \u25163 \u35320 \u65288 TANG\u65289 \u25720 \u21040 \u30340 \u12300 \u26377 \u24418 \u65288 TANGIBLE\u65289 \u12301 \u36039 \u29986 \u65292 \u37504 \u34892 \u19981 \u26371 \u25209 \u20934 \u20320 \u30340 \u21830 \u26989 \u36024 \u27454 \u12290 ", "emojis": ["\u55357 \u56720 \u65039 ", "\u55358 \u56817 ", "\u55357 \u56520 "] \}, "example": "The police are looking for tangible evidence, such as fingerprints or DNA, rather than mere speculation.", "example_zh": "\u35686 \u26041 \u27491 \u22312 \u23563 \u25214 \u25351 \u32011 \u25110  DNA \u31561 \u26377 \u24418 \u35657 \u25818 \u65292 \u32780 \u38750 \u20677 \u20677 \u26159 \u25512 \u28204 \u12290 ", "collocations": [ "tangible evidence", "tangible benefits", "tangible assets", "tangible results", "show tangible improvement" ], "synonyms": ["concrete", "palpable", "substantial", "physical"], "near_synonyms": [ \{ "word": "concrete", "difference": "concrete emphasizes solid reality opposed to abstract ideas; tangible emphasizes that something is distinct, measurable, or touchable." \}, \{ "word": "palpable", "difference": "palpable usually describes an intense atmosphere, feeling, or emotion that is so strong it feels almost physical." \} ], "antonyms": ["intangible", "abstract", "conceptual"], "word_family": [ \{ "word": "tangible", "pos": "adjective" \}, \{ "word": "tangibility", "pos": "noun" \}, \{ "word": "tangibly", "pos": "adverb" \} ], "frequency_rank": 55, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "business", "TOEFL"] \}, \{ "word": "tentative", "pos": "adjective", "phonetic": "/\u712 tent\u601 t\u618 v/", "definition": "Not certain or fixed; done without confidence; hesitant or provisional.", "definition_zh": "\u26283 \u23450 \u30340 \u65307 \u22039 \u35430 \u24615 \u30340 \u65307 \u29494 \u35947 \u19981 \u27770 \u30340 ", "etymology": \{ "roots": [ \{ "root": "tent / temptare", "origin": "Latin", "meaning": "to feel, try, test", "meaning_zh": "\u35320 \u25720 \u12289 \u22039 \u35430 \u12289 \u28204 \u35430 " \} ] \}, "mnemonic": \{ "root_memory": "TENT\u65288 \u22039 \u35430 \u12289 \u28204 \u35430 \u65289 \u8594  \u36996 \u22312 \u28204 \u35430 \u38542 \u27573 \u30340  \u8594  \u26283 \u26178 \u24615 \u30340 ", "story_en": "They made a TENTative schedule to TENT (try) out the new system before making it permanent.", "story_zh": "\u20182 \u20497 \u21046 \u23450 \u20102 \u19968 \u20491 \u12300 \u26283 \u23450 \u30340 \u65288 TENTATIVE\u65289 \u12301 \u26178 \u31243 \u34920 \u20358 \u22039 \u65288 TENT\u65289 \u35430 \u26032 \u31995 \u32113 \u65292 \u20043 \u24460 \u25165 \u26371 \u23450 \u26696 \u12290 ", "emojis": ["\u55357 \u56787 \u65039 ", "\u10067 ", "\u55358 \u56810 "] \}, "example": "We have reached a tentative agreement, but it still needs to be ratified by the board of directors.", "example_zh": "\u25105 \u20497 \u24050 \u36948 \u25104 \u19968 \u38917 \u26283 \u23450 \u21332 \u35696 \u65292 \u20294 \u20173 \u38656 \u33891 \u20107 \u26371 \u25209 \u20934 \u12290 ", "collocations": [ "tentative schedule", "tentative agreement", "tentative plan", "take tentative steps", "tentative conclusion" ], "synonyms": ["provisional", "conditional", "speculative", "hesitant"], "near_synonyms": [ \{ "word": "provisional", "difference": "provisional refers strictly to official arrangements intended to be changed later; tentative can also describe hesitant human behavior or lack of confidence." \}, \{ "word": "temporary", "difference": "temporary means built or designed to last for a limited time only; tentative means open to change because it is not yet finalized." \} ], "antonyms": ["definite", "conclusive", "final", "certain"], "word_family": [ \{ "word": "tentative", "pos": "adjective" \}, \{ "word": "tentatively", "pos": "adverb" \} ], "frequency_rank": 56, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "business", "IELTS"] \}, \{ "word": "transient", "pos": "adjective", "phonetic": "/\u712 tr\'e6n\u658 nt/", "definition": "Lasting only for a short time; impermanent or fleeting.", "definition_zh": "\u30701 \u26283 \u30340 \u65307 \u36681 \u30636 \u21363 \u36893 \u30340 \u65307 \u36942 \u23458 \u30340 ", "etymology": \{ "roots": [ \{ "root": "trans", "origin": "Latin", "meaning": "across, through", "meaning_zh": "\u31359 \u36942 \u12289 \u36328 \u36234 " \}, \{ "root": "ire", "origin": "Latin", "meaning": "to go", "meaning_zh": "\u36208 " \} ] \}, "mnemonic": \{ "root_memory": "TRANS\u65288 \u31359 \u36942 \u65289 + IRE\u65288 \u36208 \u65289 \u8594  \u21482 \u26159 \u36208 \u36942 \u21435 \u12289 \u36335 \u36942 \u30340  \u8594  \u30041 \u23384 \u26178 \u38291 \u26997 \u30701 ", "story_en": "The storm was TRANsient, quickly TRANS (crossing) over the city and leaving as fast as it arrived.", "story_zh": "\u36889 \u22580 \u26292 \u39080 \u38632 \u26159 \u12300 \u30701 \u26283 \u30340 \u65288 TRANSIENT\u65289 \u12301 \u65292 \u36805 \u36895 \u31359 \u65288 TRANS\u65289 \u36942 \u22478 \u24066 \u65292 \u20358 \u24471 \u24555 \u21435 \u24471 \u20063 \u24555 \u12290 ", "emojis": ["\u9889 ", "\u55356 \u57155 ", "\u9200 "] \}, "example": "The economic boom turned out to be transient, followed quickly by a severe recession.", "example_zh": "\u20107 \u23526 \u35657 \u26126 \u65292 \u32147 \u28639 \u32321 \u27054 \u21482 \u26159 \u30701 \u26283 \u30340 \u65292 \u32202 \u25509 \u33879 \u23601 \u20986 \u29694 \u20102 \u22196 \u37325 \u30340 \u34928 \u36864 \u12290 ", "collocations": [ "transient population", "transient phenomena", "transient nature of life", "transient symptoms", "purely transient" ], "synonyms": ["fleeting", "ephemeral", "temporary", "evanescent"], "near_synonyms": [ \{ "word": "ephemeral", "difference": "ephemeral implies something with a naturally very short life cycle (like flowers or biological entities); transient usually describes passing conditions, trends, or populations." \}, \{ "word": "temporary", "difference": "temporary implies an arrangement intended to last for a specific limited period; transient emphasizes a rapid, fleeting nature." \} ], "antonyms": ["permanent", "enduring", "persistent", "eternal"], "word_family": [ \{ "word": "transient", "pos": "adjective / noun" \}, \{ "word": "transience", "pos": "noun" \} ], "frequency_rank": 57, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "academic", "TOEFL"] \}, \{ "word": "unprecedented", "pos": "adjective", "phonetic": "/\u652 n\u712 pres\u618 dent\u618 d/", "definition": "Never done or known before; without any previous example or parallel case.", "definition_zh": "\u21490 \u28961 \u21069 \u20363 \u30340 \u65307 \u31354 \u21069 \u30340 ", "etymology": \{ "roots": [ \{ "root": "un-", "origin": "Old English", "meaning": "not", "meaning_zh": "\u19981 \u12289 \u38750 " \}, \{ "root": "pre", "origin": "Latin", "meaning": "before", "meaning_zh": "\u22312 ...\u20043 \u21069 " \}, \{ "root": "cedere", "origin": "Latin", "meaning": "to go", "meaning_zh": "\u36208 " \} ] \}, "mnemonic": \{ "root_memory": "UN\u65288 \u19981 \u65289 + PRE\u65288 \u21069 \u65289 + CEDERE\u65288 \u36208 \u65289 \u8594  \u20197 \u21069 \u27794 \u26377 \u30332 \u29983 \u65288 \u36208 \u22312 \u21069 \u38754 \u65289 \u36942 \u30340 ", "story_en": "The country experienced UNprecedented growth, which had never PRE-CEDEd (gone before) it in history.", "story_zh": "\u35442 \u22283 \u32147 \u27511 \u20102 \u12300 \u21490 \u28961 \u21069 \u20363 \u30340 \u65288 UNPRECEDENTED\u65289 \u12301 \u22686 \u38263 \u65292 \u36889 \u22312 \u27511 \u21490 \u19978 \u24478 \u26410 \u26377 \u36208 \u22312 \u21069 \u38754 \u65288 PRE-CEDE\u65289 \u30340 \u20808 \u20363 \u12290 ", "emojis": ["\u55357 \u56520 ", "\u55357 \u56960 ", "\u55357 \u56485 "] \}, "example": "The government took the unprecedented step of closing all national borders to contain the virus.", "example_zh": "\u25919 \u24220 \u25505 \u21462 \u20102 \u38364 \u38281 \u25152 \u26377 \u22283 \u22659 \u30340 \u21490 \u28961 \u21069 \u20363 \u25514 \u26045 \u20197 \u25511 \u21046 \u30149 \u27602 \u12290 ", "collocations": [ "unprecedented growth", "unprecedented challenge", "an unprecedented move", "on an unprecedented scale", "wholly unprecedented" ], "synonyms": ["unparalleled", "exceptional", "groundbreaking", "novel"], "near_synonyms": [ \{ "word": "unparalleled", "difference": "unparalleled means having no equal or match in quality or size; unprecedented means having never happened before in time." \}, \{ "word": "unusual", "difference": "unusual means uncommon or rare; unprecedented means absolutely unique in history." \} ], "antonyms": ["precedented", "commonplace", "familiar", "traditional"], "word_family": [ \{ "word": "unprecedented", "pos": "adjective" \}, \{ "word": "precedent", "pos": "noun" \}, \{ "word": "precede", "pos": "verb" \} ], "frequency_rank": 58, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "politics", "IELTS"] \}, \{ "word": "vehement", "pos": "adjective", "phonetic": "/\u712 vi\u720 \u601 m\u601 nt/", "definition": "Showing strong feeling; forceful, passionate, or intense in expression or emotion.", "definition_zh": "\u24375 \u28872 \u30340 \u65307 \u29467 \u28872 \u30340 \u65307 \u29105 \u24773 \u30340 \u65307 \u65288 \u24120 \u25351 \u28608 \u21205 \u22320 \u65289 \u24375 \u28872 \u21453 \u23565 \u30340 ", "etymology": \{ "roots": [ \{ "root": "vehere", "origin": "Latin", "meaning": "to carry, convey", "meaning_zh": "\u25884 \u24118 \u12289 \u36939 \u36865 " \}, \{ "root": "mens", "origin": "Latin", "meaning": "mind", "meaning_zh": "\u24515 \u26234 \u12289 \u31934 \u31070 " \} ] \}, "mnemonic": \{ "root_memory": "VEHERE\u65288 \u25884 \u24118 \u12289 \u34909 \u21205 \u65289 + MENS\u65288 \u24515 \u26234 \u65289 \u8594  \u33126 \u34955 \u34987 \u24375 \u28872 \u24773 \u32210 \u36617 \u33879 \u36208  \u8594  \u28608 \u28872 \u30340 ", "story_en": "Driven by a powerful VEHEment impulse, his MENS (mind) exploded into a VEHEMENT denial of the charges.", "story_zh": "\u22312 \u24375 \u28872 \u24773 \u32210 \u30340 \u36617 \u65288 VEHE\u65289 \u36939 \u19979 \u65292 \u20182 \u30340 \u24515 \u26234 \u65288 MENS\u65289 \u29190 \u30332 \u20986 \u23565 \u25351 \u25511 \u30340 \u12300 \u24375 \u28872 \u65288 VEHEMENT\u65289 \u12301 \u21542 \u35469 \u12290 ", "emojis": ["\u55357 \u56865 ", "\u55357 \u56803 \u65039 ", "\u55357 \u56613 "] \}, "example": "Despite vehement opposition from local residents, the city council approved the construction of the landfill.", "example_zh": "\u20760 \u31649 \u21463 \u21040 \u30070 \u22320 \u23621 \u27665 \u30340 \u24375 \u28872 \u21453 \u23565 \u65292 \u24066 \u35696 \u26371 \u36996 \u26159 \u25209 \u20934 \u20102 \u22403 \u22334 \u25513 \u22475 \u22580 \u30340 \u24314 \u35373 \u12290 ", "collocations": [ "vehement denial", "vehement opposition", "vehement protest", "vehement critic", "vehemently object" ], "synonyms": ["passionate", "forceful", "fervent", "ardent"], "near_synonyms": [ \{ "word": "passionate", "difference": "passionate usually carries a positive connotation of love or enthusiasm; vehement often carries a negative connotation of anger, protest, or fierce defense." \}, \{ "word": "intense", "difference": "intense refers to a high degree of force or concentration; vehement specifically implies an emotional, forceful outward expression." \} ], "antonyms": ["apathetic", "indifferent", "mild", "lukewarm"], "word_family": [ \{ "word": "vehement", "pos": "adjective" \}, \{ "word": "vehemence", "pos": "noun" \}, \{ "word": "vehemently", "pos": "adverb" \} ], "frequency_rank": 59, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "GRE", "social"] \}, \{ "word": "vulnerable", "pos": "adjective", "phonetic": "/\u712 v\u652 ln\u601 r\u601 bl/", "definition": "Susceptible to physical or emotional attack or harm; unprotected and easily damaged.", "definition_zh": "\u26131 \u21463 \u20663 \u30340 \u65307 \u33030 \u24369 \u30340 \u65307 \u26131 \u21463 \u25915 \u25802 \u30340 ", "etymology": \{ "roots": [ \{ "root": "vulnerare / vulnus", "origin": "Latin", "meaning": "to wound, injury", "meaning_zh": "\u21463 \u20663 \u12289 \u20663 \u21475 " \} ] \}, "mnemonic": \{ "root_memory": "VULNER\u65288 \u20663 \u21475 \u65289 \u8594  \u23481 \u26131 \u35069 \u36896 \u20986 \u20663 \u21475 \u30340  \u8594  \u33030 \u24369 \u30340 ", "story_en": "Without a shield, the soldier's chest was left VULNERable to a fatal VULNER (wound).", "story_zh": "\u27794 \u26377 \u30462 \u29260 \u20445 \u35703 \u65292 \u22763 \u20853 \u30340 \u33016 \u33179 \u24456 \u23481 \u26131 \u21463 \u20663 \u65288 VULNER\u65289 \u65292 \u34389 \u26044 \u12300 \u26131 \u21463 \u25915 \u25802 \u30340 \u65288 VULNERABLE\u65289 \u12301 \u29376 \u24907 \u12290 ", "emojis": ["\u55357 \u57057 \u65039 ", "\u55357 \u56468 ", "\u55358 \u56640 "] \}, "example": "Older people and young children are particularly vulnerable to influenza during the winter months.", "example_zh": "\u22312 \u20908 \u23395 \u65292 \u32769 \u24180 \u20154 \u21644 \u24188 \u31461 \u29305 \u21029 \u23481 \u26131 \u24863 \u26579 \u27969 \u24863 \u12290 ", "collocations": [ "vulnerable to attack", "highly vulnerable", "vulnerable groups", "vulnerable position", "economic vulnerability" ], "synonyms": ["susceptible", "exposed", "defenseless", "fragile"], "near_synonyms": [ \{ "word": "susceptible", "difference": "susceptible suggests a high likelihood of being influenced, affected, or infected (e.g., susceptible to disease); vulnerable emphasizes being exposed to severe harm or damage." \}, \{ "word": "fragile", "difference": "fragile implies that something is physically or structurally delicate and breaks easily; vulnerable means unprotected against external threats." \} ], "antonyms": ["invulnerable", "resilient", "protected", "immune"], "word_family": [ \{ "word": "vulnerable", "pos": "adjective" \}, \{ "word": "vulnerability", "pos": "noun" \}, \{ "word": "vulnerably", "pos": "adverb" \} ], "frequency_rank": 60, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "psychology", "IELTS"] \}, \{ "word": "wary", "pos": "adjective", "phonetic": "/\u712 weri/", "definition": "Feeling or showing caution about possible dangers or problems; alert and watchful.", "definition_zh": "\u35641 \u24910 \u30340 \u65307 \u35686 \u24789 \u30340 \u65307 \u21807 \u24656 \u30340 ", "etymology": \{ "roots": [ \{ "root": "war / waer", "origin": "Old English", "meaning": "watchful, guarded", "meaning_zh": "\u27880 \u24847 \u30340 \u12289 \u23432 \u34907 \u30340 " \} ] \}, "mnemonic": \{ "root_memory": "WAR\u65288 \u35686 \u24789 \u65289 \u8594  \u39006 \u20284  aware\u65288 \u24847 \u35672 \u21040 \u30340 \u65289 \u21644  beware\u65288 \u23567 \u24515 \u65289 ", "story_en": "Be aWARE and stay WARY of strangers who offer you investments that sound too good to be true.", "story_zh": "\u38568 \u26178 \u20445 \u25345 \u24847 \u35672 \u65288 aWARE\u65289 \u65292 \u23565 \u37027 \u20123 \u32893 \u36215 \u20358 \u22909 \u24471 \u20196 \u20154 \u38627 \u20197 \u32622 \u20449 \u30340 \u25237 \u36039 \u38917 \u30446 \u20445 \u25345 \u12300 \u35686 \u24789 \u65288 WARY\u65289 \u12301 \u12290 ", "emojis": ["\u55358 \u56714 ", "\u55357 \u56384 ", "\u9888 \u65039 "] \}, "example": "Investors are increasingly wary of putting money into high-risk startups during an economic downturn.", "example_zh": "\u22312 \u32147 \u28639 \u20302 \u36855 \u26178 \u26399 \u65292 \u25237 \u36039 \u32773 \u23565 \u26044 \u23559 \u36039 \u37329 \u25237 \u20837 \u39640 \u39080 \u38570 \u26032 \u21109 \u20844 \u21496 \u35722 \u24471 \u36234 \u20358 \u36234 \u35641 \u24910 \u12290 ", "collocations": [ "wary of strangers", "be wary of", "wary eye", "become wary", "wary glance" ], "synonyms": ["cautious", "circumspect vigilant", "suspicious", "guarded"], "near_synonyms": [ \{ "word": "cautious", "difference": "cautious implies careful planning to avoid mistakes or danger; wary implies a specific suspicion or fear of being tricked or harmed." \}, \{ "word": "vigilant", "difference": "vigilant means staying awake and alert to detect danger actively, like a guard on duty." \} ], "antonyms": ["trusting", "reckless", "careless", "unwary"], "word_family": [ \{ "word": "wary", "pos": "adjective" \}, \{ "word": "wariness", "pos": "noun" \}, \{ "word": "warily", "pos": "adverb" \} ], "usage_note": "Wary is usually followed by the preposition 'of' (e.g., 'wary of pitfalls'). Do not confuse with 'weary', which means tired.", "frequency_rank": 61, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "business", "TOEFL"] \}, \{ "word": "aberration", "pos": "noun", "phonetic": "/\u716 \'e6b\u601 \u712 re\u618 \u643 n/", "definition": "A departure from what is normal, usual, or expected, typically one that is unwelcome.", "definition_zh": "\u30064 \u24120 \u65307 \u20559 \u24046 \u65307 \u20559 \u38626 \u24120 \u36556 \u65288 \u36890 \u24120 \u25351 \u19981 \u33391 \u30340 \u65289 ", "etymology": \{ "roots": [ \{ "root": "ab-", "origin": "Latin", "meaning": "away from", "meaning_zh": "\u38626 \u38283 \u12289 \u36960 \u38626 " \}, \{ "root": "errare", "origin": "Latin", "meaning": "to stray, wander", "meaning_zh": "\u36855 \u36335 \u12289 \u36938 \u34153 \u12289 \u29359 \u37679 " \} ] \}, "mnemonic": \{ "root_memory": "AB\u65288 \u38626 \u38283 \u65289 + ERRARE\u65288 \u36855 \u36335 \u12289 \u29359 \u37679 \u65289 \u8594  \u38626 \u38283 \u27491 \u30906 \u30340 \u36947 \u36335  \u8594  \u30064 \u24120 \u34892 \u28858 ", "story_en": "The player's violent outburst was a temporary ABERRATION from his AB- (away) normal calm behavior, caused by ERRARE (straying) from his training.", "story_zh": "\u35442 \u29699 \u21729 \u30340 \u26292 \u21147 \u29190 \u30332 \u21482 \u26159 \u26283 \u26178 \u36960 \u38626 \u65288 AB\u65289 \u20919 \u38748 \u36556 \u36947 \u12289 \u36208 \u20837 \u36855 \u36884 \u65288 ERRARE\u65289 \u30340 \u12300 \u30064 \u24120 \u65288 ABERRATION\u65289 \u12301 \u34892 \u28858 \u12290 ", "emojis": ["\u55357 \u56521 ", "\u55356 \u57088 ", "\u10067 "] \}, "example": "The sudden drop in sales was a temporary aberration caused by a computer glitch rather than a market trend.", "example_zh": "\u37559 \u21806 \u38989 \u30340 \u31361 \u28982 \u19979 \u38477 \u26159 \u38651 \u33126 \u25925 \u38556 \u24341 \u36215 \u30340 \u26283 \u26178 \u30064 \u24120 \u65292 \u32780 \u38750 \u24066 \u22580 \u36264 \u21218 \u12290 ", "collocations": [ "temporary aberration", "mental aberration", "statistical aberration", "chromatic aberration", "treated as an aberration" ], "synonyms": ["anomaly", "deviation", "eccentricity", "irregularity"], "near_synonyms": [ \{ "word": "anomaly", "difference": "anomaly is a neutral term for something that doesn't fit a pattern; aberration often implies a moral, mental, or performance-related lapse that is unwelcome." \}, \{ "word": "deviation", "difference": "deviation is a measurable distance from a standard path, line, or statistical mean." \} ], "antonyms": ["normality", "conformity", "regularity"], "word_family": [ \{ "word": "aberration", "pos": "noun" \}, \{ "word": "aberrant", "pos": "adjective" \} ], "frequency_rank": 62, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "GRE", "science"] \}, \{ "word": "acquiesce", "pos": "verb", "phonetic": "/\u716 \'e6kwi\u712 es/", "definition": "To accept something reluctantly but without protest; to comply silently.", "definition_zh": "\u40664 \u35377 \u65307 \u21193 \u24375 \u21516 \u24847 \u65307 \u40664 \u24478 ", "etymology": \{ "roots": [ \{ "root": "ad-", "origin": "Latin", "meaning": "to, toward", "meaning_zh": "\u21521 \u12289 \u24448 " \}, \{ "root": "quiescere", "origin": "Latin", "meaning": "to rest, be quiet", "meaning_zh": "\u20241 \u24687 \u12289 \u23433 \u38748 " \} ] \}, "mnemonic": \{ "root_memory": "AD\u65288 \u21435 \u65289 + QUIESCERE\u65288 \u23433 \u38748 \u65289 \u8594  \u20445 \u25345 \u23433 \u38748 \u19981 \u21435 \u21453 \u25239  \u8594  \u40664 \u40664 \u25509 \u21463 ", "story_en": "The manager decided to ACQUIESCE to the demands, remaining QUIET (quiescere) instead of arguing.", "story_zh": "\u32147 \u29702 \u27770 \u23450 \u12300 \u40664 \u35377 \u65288 ACQUIESCE\u65289 \u12301 \u36889 \u20123 \u35201 \u27714 \u65292 \u20445 \u25345 \u23433 \u38748 \u65288 QUIESCERE\u65289 \u32780 \u19981 \u20877 \u29229 \u36783 \u12290 ", "emojis": ["\u55358 \u56592 ", "\u55358 \u56605 ", "\u55357 \u56852 "] \}, "example": "The director chose to acquiesce to the board's decision rather than risking his position by protesting.", "example_zh": "\u33891 \u20107 \u36984 \u25799 \u40664 \u35377 \u33891 \u20107 \u26371 \u30340 \u27770 \u23450 \u65292 \u32780 \u19981 \u26159 \u20882 \u33879 \u22833 \u21435 \u32887 \u20301 \u30340 \u39080 \u38570 \u25552 \u20986 \u25239 \u35696 \u12290 ", "collocations": [ "acquiesce to demands", "acquiesce in a decision", "refuse to acquiesce", "reluctantly acquiesce", "acquiesce quietly" ], "synonyms": ["comply", "concede", "assent", "succumb"], "near_synonyms": [ \{ "word": "agree", "difference": "agree implies a positive or willing alignment of opinions; acquiesce emphasizes passive submission or passive consent due to reluctance." \}, \{ "word": "comply", "difference": "comply means following an official rule or command, often out of necessity or legal duty." \} ], "antonyms": ["protest", "rebel", "object", "resist"], "word_family": [ \{ "word": "acquiesce", "pos": "verb" \}, \{ "word": "acquiescence", "pos": "noun" \}, \{ "word": "acquiescent", "pos": "adjective" \} ], "usage_note": "Acquiesce can take either 'to' or 'in' (e.g., 'acquiesce to demands' or 'acquiesce in the ruling').", "frequency_rank": 63, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "GRE", "politics"] \}, \{ "word": "acute", "pos": "adjective", "phonetic": "/\u601 \u712 kju\u720 t/", "definition": "Experienced to a severe or intense degree; having or showing a perceptive understanding or insight; (of an angle) less than 90\'b0.", "definition_zh": "\u22196 \u37325 \u30340 \u65307 \u25935 \u37555 \u30340 \u65307 \u24613 \u24615 \u30340 \u65288 \u30142 \u30149 \u65289 \u65307 \u37555 \u35282 \u30340 ", "etymology": \{ "roots": [ \{ "root": "acus / acuere", "origin": "Latin", "meaning": "needle, to sharpen", "meaning_zh": "\u37341 \u12289 \u20351 \u23574 \u37555 " \} ] \}, "mnemonic": \{ "root_memory": "ACU\u65288 \u23574 \u37555 \u65289 \u8594  \u20687 \u37341 \u23574 \u19968 \u27171 \u21050 \u30171 \u30340  \u8594  \u22196 \u37325 \u30340 \u65292 \u25110 \u38957 \u33126 \u20687 \u37341 \u19968 \u27171 \u23574 \u37555 \u30340  \u8594  \u25935 \u37555 \u30340 ", "story_en": "The patient felt an ACUTE pain that was as sharp as an ACUs (needle) piercing the skin.", "story_zh": "\u30149 \u24739 \u24863 \u21463 \u21040 \u12300 \u21127 \u28872 \u30340 \u65288 ACUTE\u65289 \u12301 \u30140 \u30171 \u65292 \u23601 \u20687 \u37341 \u65288 ACUs\u65289 \u23574 \u21050 \u20837 \u30382 \u33178 \u19968 \u27171 \u37555 \u21033 \u12290 ", "emojis": ["\u55356 \u57263 ", "\u55358 \u56800 ", "\u55356 \u57317 "] \}, "example": "The company is facing an acute shortage of skilled software engineers, threatening its project deadlines.", "example_zh": "\u35442 \u20844 \u21496 \u27491 \u38754 \u33256 \u25104 \u29087 \u36575 \u39636 \u24037 \u31243 \u24107 \u30340 \u22196 \u37325 \u30701 \u32570 \u65292 \u36889 \u23041 \u33029 \u21040 \u20854 \u23560 \u26696 \u25130 \u27490 \u26085 \u26399 \u12290 ", "collocations": [ "acute shortage", "acute pain", "acute angle", "acute illness", "acute sense of smell" ], "synonyms": ["severe", "intense", "sharp", "astute", "discerning"], "near_synonyms": [ \{ "word": "severe", "difference": "severe describes something harsh, strict, or intensely bad; acute emphasizes a sharp, critical pinnacle or sudden onset (especially in medical terms)." \}, \{ "word": "chronic", "difference": "chronic means long-lasting or recurring over a long period; acute means sudden and severe (direct antonym in medicine)." \} ], "antonyms": ["chronic", "mild", "obtuse", "dull"], "word_family": [ \{ "word": "acute", "pos": "adjective" \}, \{ "word": "acutely", "pos": "adverb" \}, \{ "word": "acuteness", "pos": "noun" \} ], "frequency_rank": 64, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "academic", "science"] \}, \{ "word": "adhere", "pos": "verb", "phonetic": "/\u601 d\u712 h\u618 r/", "definition": "To stick fast to a surface or substance; to believe in and follow the practices or rules of something.", "definition_zh": "\u40655 \u38468 \u65307 \u22533 \u25345 \u65307 \u36981 \u23432 \u65288 \u35215 \u21063 \u25110 \u20449 \u24565 \u65289 ", "etymology": \{ "roots": [ \{ "root": "ad-", "origin": "Latin", "meaning": "to, toward", "meaning_zh": "\u21521 \u12289 \u24448 " \}, \{ "root": "haere/haerere", "origin": "Latin", "meaning": "to stick", "meaning_zh": "\u40655 \u36028 " \} ] \}, "mnemonic": \{ "root_memory": "AD\u65288 \u21521 \u65289 + HAERE\u65288 \u40655 \u65289 \u8594  \u40655 \u22312 \u19978 \u38754  \u8594  \u22533 \u25345 \u36981 \u23432 ", "story_en": "Glue makes the poster ADHERE to the wall, just as professional athletes must ADHERE to strict rules.", "story_zh": "\u33184 \u27700 \u35731 \u28023 \u22577 \u40655 \u65288 HAERE\u65289 \u22312 \u29254 \u22721 \u19978 \u65292 \u23601 \u20687 \u32887 \u26989 \u36939 \u21205 \u21729 \u24517 \u38920 \u12300 \u36981 \u23432 \u65288 ADHERE\u65289 \u12301 \u22196 \u26684 \u30340 \u35215 \u31456 \u19968 \u27171 \u12290 ", "emojis": ["\u55357 \u56599 ", "\u55357 \u56523 ", "\u55358 \u56817 "] \}, "example": "All laboratory personnel must strictly adhere to safety protocols to prevent chemical contamination.", "example_zh": "\u25152 \u26377 \u23526 \u39511 \u23460 \u20154 \u21729 \u24517 \u38920 \u22196 \u26684 \u36981 \u23432 \u23433 \u20840 \u21332 \u23450 \u65292 \u20197 \u38450 \u27490 \u21270 \u23416 \u27745 \u26579 \u12290 ", "collocations": [ "adhere to rules", "adhere to a policy", "firmly adhere", "adhere to the surface", "strict adherence" ], "synonyms": ["stick", "cling", "comply", "observe", "abide by"], "near_synonyms": [ \{ "word": "comply", "difference": "comply means to act in accordance with a command or rule; adhere emphasizes loyalty or sticking unyieldingly to a principle or rule over time." \}, \{ "word": "follow", "difference": "follow is a general, conversational word; adhere to is formal and implies an unswerving commitment." \} ], "antonyms": ["disobey", "flout", "detach", "separate"], "word_family": [ \{ "word": "adhere", "pos": "verb" \}, \{ "word": "adherence", "pos": "noun" \}, \{ "word": "adhesive", "pos": "noun / adjective" \} ], "usage_note": "Always use the preposition 'to' after adhere when meaning to follow a rule (e.g., 'adhere to guidelines').", "frequency_rank": 65, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "academic", "law"] \}, \{ "word": "adverse", "pos": "adjective", "phonetic": "/\u601 d\u712 v\u604 \u720 rs/", "definition": "Preventing success or development; harmful, unfavorable, or hostile.", "definition_zh": "\u19981 \u21033 \u30340 \u65307 \u26377 \u23475 \u30340 \u65307 \u21453 \u21521 \u30340 ", "etymology": \{ "roots": [ \{ "root": "ad-", "origin": "Latin", "meaning": "toward", "meaning_zh": "\u21521 " \}, \{ "root": "vertere", "origin": "Latin", "meaning": "to turn", "meaning_zh": "\u26059 \u36681 \u12289 \u36681 \u21521 " \} ] \}, "mnemonic": \{ "root_memory": "AD\u65288 \u21521 \u65289 + VERTERE\u65288 \u36681 \u65289 \u8594  \u36681 \u36942 \u20358 \u23565 \u33879 \u20320 \u25239 \u34913  \u8594  \u38754 \u23565 \u38754 \u30340 \u25973 \u23565 \u25110 \u19981 \u21033 ", "story_en": "When the wind shifts and turns ADVERSEly against your ship, you face ADVERSE weather conditions.", "story_zh": "\u30070 \u39080 \u21521 \u25913 \u35722 \u12289 \u36681 \u65288 VERTERE\u65289 \u21521 \u33287 \u20320 \u30340 \u33337 \u20316 \u23565 \u26178 \u65292 \u20320 \u23601 \u38754 \u33256 \u20102 \u12300 \u19981 \u21033 \u30340 \u65288 ADVERSE\u65289 \u12301 \u22825 \u27683 \u26781 \u20214 \u12290 ", "emojis": ["\u55356 \u57130 \u65039 ", "\u9888 \u65039 ", "\u55357 \u56458 "] \}, "example": "The pharmaceutical company reported that the new drug has no adverse side effects on patients.", "example_zh": "\u35442 \u35069 \u34277 \u20844 \u21496 \u22577 \u21578 \u31281 \u65292 \u36889 \u31278 \u26032 \u34277 \u23565 \u24739 \u32773 \u27794 \u26377 \u19981 \u33391 \u65288 \u26377 \u23475 \u30340 \u65289 \u21103 \u20316 \u29992 \u12290 ", "collocations": [ "adverse effects", "adverse weather conditions", "adverse reaction", "adverse impact", "under adverse circumstances" ], "synonyms": ["unfavorable", "disadvantageous", "harmful", "detrimental"], "near_synonyms": [ \{ "word": "harmful", "difference": "harmful explicitly states that damage or injury will occur; adverse emphasizes that conditions are working against success or well-being." \}, \{ "word": "hostile", "difference": "hostile implies an active, aggressive enemy or intent to harm; adverse can refer to inanimate conditions like weather or economy." \} ], "antonyms": ["favorable", "beneficial", "advantageous"], "word_family": [ \{ "word": "adverse", "pos": "adjective" \}, \{ "word": "adversity", "pos": "noun" \}, \{ "word": "adversary", "pos": "noun" \}, \{ "word": "adversely", "pos": "adverb" \} ], "usage_note": "Do not confuse 'adverse' with 'averse'. Adverse applies to things or situations (adverse effects); averse describes a person's feeling of dislike or opposition (averse to risk).", "frequency_rank": 66, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "business", "science"] \}, \{ "word": "advocate", "pos": "verb", "phonetic": "/\u712 \'e6dv\u601 ke\u618 t/", "definition": "To publicly recommend or support a particular cause, policy, or course of action.", "definition_zh": "\u25552 \u20513 \u65307 \u20027 \u24373 \u65307 \u25793 \u35703 ", "etymology": \{ "roots": [ \{ "root": "ad-", "origin": "Latin", "meaning": "to, toward", "meaning_zh": "\u21521 \u12289 \u24448 " \}, \{ "root": "vocare / vox", "origin": "Latin", "meaning": "to call, voice", "meaning_zh": "\u21628 \u21898 \u12289 \u32882 \u38899 " \} ] \}, "mnemonic": \{ "root_memory": "AD\u65288 \u21521 \u65289 + VOCARE\u65288 \u21628 \u21898 \u65289 \u8594  \u21521 \u22823 \u30526 \u30332 \u20986 \u32882 \u38899 \u20197 \u25903 \u25345 \u26576 \u20107  \u8594  \u25552 \u20513 ", "story_en": "Environmentalists ADvocate for cleaner oceans by calling out with a loud VOC- (voice) to the government.", "story_zh": "\u29872 \u20445 \u20027 \u32681 \u32773 \u21521 \u25919 \u24220 \u30332 \u20986 \u22823 \u32882 \u30340 \u21628 \u21898 \u65288 VOCARE\u65289 \u65292 \u34249 \u27492 \u12300 \u25552 \u20513 \u65288 ADVOCATE\u65289 \u12301 \u26356 \u20094 \u28136 \u30340 \u28023 \u27915 \u12290 ", "emojis": ["\u55357 \u56546 ", "\u55356 \u57137 ", "\u55357 \u56421 "] \}, "example": "The organization advocates for the rights of disabled citizens to ensure equal job opportunities.", "example_zh": "\u35442 \u32068 \u32340 \u25552 \u20513 \u27544 \u30142 \u20844 \u27665 \u30340 \u27402 \u21033 \u65292 \u20197 \u30906 \u20445 \u24179 \u31561 \u30340 \u23601 \u26989 \u27231 \u26371 \u12290 ", "collocations": [ "advocate for reform", "strongly advocate", "advocate a policy", "patient advocate", "openly advocate" ], "synonyms": ["support", "champion", "promote", "endorse"], "near_synonyms": [ \{ "word": "support", "difference": "support is a general term for agreeing with or helping a cause; advocate specifically implies active, public, and vocal promotion." \}, \{ "word": "recommend", "difference": "recommend means to advise a choice because it is good; advocate means to fight for a policy or cause based on principles." \} ], "antonyms": ["oppose", "condemn", "resist", "criticize"], "word_family": [ \{ "word": "advocate", "pos": "verb / noun" \}, \{ "word": "advocacy", "pos": "noun" \} ], "usage_note": "When used as a verb, it can be followed directly by a noun ('advocate reform') or by 'for' ('advocate for reform'). As a noun, it is pronounced /\u712 \'e6dv\u601 k\u601 t/.", "frequency_rank": 67, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "politics", "social"] \}, \{ "word": "aesthetic", "pos": "adjective", "phonetic": "/es\u712 \u952 et\u618 k/", "definition": "Concerning or characterized by an appreciation of beauty or good taste, especially in art.", "definition_zh": "\u32654 \u23416 \u30340 \u65307 \u23529 \u32654 \u30340 \u65307 \u20855 \u26377 \u32654 \u24863 \u30340 ", "etymology": \{ "roots": [ \{ "root": "aisthetikos", "origin": "Greek", "meaning": "perceptive, of sense 