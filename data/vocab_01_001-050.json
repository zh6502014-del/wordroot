nyms": ["legitimize", "warrant", "validate", "defend"], "near_synonyms": [ \{ "word": "defend", "difference": "defend implies protecting an idea or physical wall from aggressive outside attacks; justify means presenting solid ethical or financial proof that an action was right from the start." \}, \{ "word": "excuse", "difference": "excuse means trying to minimize blame or bypass criticism for an acknowledged mistake or bad behavior." \} ], "antonyms": ["condemn", "oppose", "invalidate"], "word_family": [ \{ "word": "justify", "pos": "verb" \}, \{ "word": "justification", "pos": "noun" \}, \{ "word": "justifiable", "pos": "adjective" \} ], "usage_note": "A famous political maxim states: 'The ends justify the means' (\u28858 \u20102 \u36948 \u21040 \u30446 \u30340 \u19981 \u25799 \u25163 \u27573 \u65292 \u21363 \u32080 \u26524 \u20351 \u25163 \u27573 \u27491 \u30070 \u21270 ).", "frequency_rank": 34, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "law", "philosophy"] \}, \{ "word": "legitimate", "pos": "adjective", "phonetic": "/l\u618 \u712 d\u658 \u618 t\u618 m\u601 t/", "definition": "Conforming to the law or to rules; legal, lawful, or able to be defended as reasonable and valid.", "definition_zh": "\u21512 \u27861 \u30340 \u65307 \u27491 \u30070 \u30340 \u65307 \u21512 \u29702 \u30340 \u65307 \u27491 \u32113 \u30340 ", "etymology": \{ "roots": [ \{ "root": "leg / lex", "origin": "Latin", "meaning": "law", "meaning_zh": "\u27861 \u24459 " \} ] \}, "mnemonic": \{ "root_memory": "LEG\u65288 \u27861 \u24459 \u65289 \u8594  \u23436 \u20840 \u31526 \u21512 \u22283 \u23478 \u27861 \u24459 \u26781 \u25991 \u35215 \u31684 \u30340 \u29376 \u24907 ", "story_en": "The business operates within strict LEG (law) frameworks, ensuring all its profits are perfectly LEGITIMATE.", "story_zh": "\u36889 \u23478 \u20225 \u26989 \u22312 \u22196 \u26684 \u30340 \u12300 \u27861 \u24459 \u65288 LEG\u65289 \u12301 \u26694 \u26550 \u20839 \u36939 \u20316 \u65292 \u30906 \u20445 \u20854 \u25152 \u26377 \u21033 \u28516 \u23436 \u20840 \u26159 \u12300 \u21512 \u27861 \u30340 \u65288 LEGITIMATE\u65289 \u12301 \u12290 ", "emojis": ["\u55357 \u56540 ", "\u55358 \u56785 \u8205 \u9878 \u65039 ", "\u9989 "] \}, "example": "The customer had a legitimate grievance regarding the defective battery, so the retail shop issued a full refund.", "example_zh": "\u28040 \u36027 \u32773 \u37341 \u23565 \u29781 \u30133 \u38651 \u27744 \u25552 \u20986 \u20102 \u27491 \u30070 \u21512 \u29702 \u30340 \u30003 \u35380 \u65292 \u22240 \u27492 \u38646 \u21806 \u24215 \u30332 \u25918 \u20102 \u20840 \u38989 \u36864 \u27454 \u12290 ", "collocations": [ "legitimate business", "legitimate concern", "perfectly legitimate", "legitimate government", "legitimate reason" ], "synonyms": ["lawful", "valid", "legal", "authorized"], "near_synonyms": [ \{ "word": "legal", "difference": "legal strictly means something does not break written code or legislation; legitimate is broader, meaning it is accepted as fair, reasonable, or morally correct by society." \}, \{ "word": "valid", "difference": "valid means technically effective or binding under current rules (like a valid passport or ticket)." \} ], "antonyms": ["illegitimate", "illegal", "invalid"], "word_family": [ \{ "word": "legitimate", "pos": "adjective" \}, \{ "word": "legitimize", "pos": "verb" \}, \{ "word": "legitimacy", "pos": "noun" \} ], "usage_note": "Be careful with pronunciation: the adjective is /l\u618 \u712 d\u658 \u618 t\u618 m\u601 t/, but the verb form (to make legal) is /l\u618 \u712 d\u658 \u618 t\u618 me\u618 t/.", "frequency_rank": 35, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "law", "academic"] \}, \{ "word": "manifest", "pos": "verb", "phonetic": "/\u712 m\'e6n\u618 fest/", "definition": "To display or show a quality or feeling by one's acts or appearance; to demonstrate clearly.", "definition_zh": "\u39023 \u29694 \u65307 \u27969 \u38706 \u65307 \u34920 \u26126 \u