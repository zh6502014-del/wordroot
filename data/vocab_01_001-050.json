" \} ], "antonyms": ["conceal", "hide", "mask"], "word_family": [ \{ "word": "manifest", "pos": "verb / adjective" \}, \{ "word": "manifestation", "pos": "noun" \}, \{ "word": "manifestly", "pos": "adverb" \} ], "usage_note": "'Manifest' is also widely used as an adjective meaning 'obvious' (e.g., manifest injustice), and as a noun meaning a passenger or cargo ship list.", "frequency_rank": 36, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "psychology", "academic"] \}, \{ "word": "manipulate", "pos": "verb", "phonetic": "/m\u601 \u712 n\u618 pjule\u618 t/", "definition": "To handle or control something tool or variable with skill; or to control or influence a person or situation cleverly or unfairly.", "definition_zh": "\u25805 \u32305 \u65307 \u25511 \u21046 \u65307 \u29087 \u32244 \u22320 \u25805 \u20316 \u65307 \u22312 \u32972 \u24460 \u25511 \u21046 \u65288 \u20154 \u65289 ", "etymology": \{ "roots": [ \{ "root": "manus", "origin": "Latin", "meaning": "hand", "meaning_zh": "\u25163 " \}, \{ "root": "plere", "origin": "Latin", "meaning": "to fill", "meaning_zh": "\u22635 \u28415 \u12289 \u20805 \u28415 " \} ] \}, "mnemonic": \{ "root_memory": "MANUS\u65288 \u25163 \u65289 + PLERE\u65288 \u22635 \u28415 \u65289 \u8594  \u25163 \u35041 \u25235 \u28415 \u20102 \u25511 \u21046 \u27402 \u65292 \u22312 \u32972 \u24460 \u38728 \u27963 \u25805 \u25511 ", "story_en": "With his MANUS (hand) filling the control room, the technician could MANIPULATE the complex robotic arms.", "story_zh": "\u12300 \u25163 \u65288 MANUS\u65289 \u12301 \u20013 \u25569 \u28415 \u20102 \u25511 \u21046 \u27402 \u65292 \u25216 \u34899 \u20154 \u21729 \u20415 \u33021 \u38728 \u27963 \u22320 \u12300 \u25805 \u32305 \u65288 MANIPULATE\u65289 \u12301 \u35079 \u38620 \u30340 \u27231 \u26800 \u25163 \u33218 \u12290 ", "emojis": ["\u55356 \u57243 \u65039 ", "\u55358 \u56633 ", "\u55358 \u56785 \u8205 \u55357 \u56507 "] \}, "example": "The dictator used state-controlled television networks to manipulate public opinion during the election.", "example_zh": "\u29544 \u35009 \u32773 \u22312 \u36984 \u33289 \u26399 \u38291 \u21033 \u29992 \u22283 \u23478 \u25511 \u21046 \u30340 \u38651 \u35222 \u32178 \u36335 \u20358 \u25805 \u32305 \u20844 \u30526 \u36671 \u35542 \u12290 ", "collocations": [ "manipulate public opinion", "cleverly manipulate", "manipulate data", "manipulate variables", "attempt to manipulate" ], "synonyms": ["maneuver", "influence", "exploit", "operate"], "near_synonyms": [ \{ "word": "influence", "difference": "influence means to affect someone's thinking or behavior naturally or open-endedly; manipulate implies dishonest, secret, or total control for personal gain." \}, \{ "word": "operate", "difference": "operate is a neutral, physical term for running a piece of machinery according to manual instructions." \} ], "antonyms": ["leave alone", "be transparent"], "word_family": [ \{ "word": "manipulate", "pos": "verb" \}, \{ "word": "manipulation", "pos": "noun" \}, \{ "word": "manipulative", "pos": "adjective" \} ], "usage_note": "In laboratory science, 'manipulate variables' (\u25805 \u20316 \u35722 \u22240 ) is a standard phrase that means changing quantities to observe results.", "frequency_rank": 37, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "politics", "psychology"] \}, \{ "word": "marginal", "pos": "adjective", "phonetic": "/\u712 m\u593 \u720 rd\u658 \u618 nl/", "definition": "Relating to or at the edge or margin; minimal, minor, or barely sufficient.", "definition_zh": "\u37002 \u32227 \u30340 \u65307 \u24494 \u23567 \u30340 \u65307 \u19981 \u37325 \u35201 \u30340 \u65307 \u37002 \u38555 \u30340 ", "etymology": \{ "roots": [ \{ "root": "margo", "origin": "Latin", "meaning": "border, edge, brink", "meaning_zh": "\u37002 \u32227 \u12289 \u37002 \u30028 " \} ] \}, "mnemonic": \{ "root_memory": "MARGO\u65288 \u37002 \u32227 \u65289 \u8594  \u30041 \u22312 \u32025 \u24373 \u26368 \u35282 \u33853 \u12289 \u26368 \u19981 \u37325 \u35201 \u30340 \u31354 \u30333 \u34389 \u30340 \u35338 \u24687 ", "story_en": "The editor scribbled minor notes on the MARGO (edge) of the paper, representing MARGINAL corrections.", "story_zh": "\u32232 \u36655 \u22312 \u32025 \u24373 \u30340 \u12300 \u37002 \u32227 \u65288 MARGO\u65289 \u12301 \u22615 \u23531 \u20102 \u23567 \u31558 \u35352 \u65292 \u36889 \u20195 \u34920 \u20102 \u12300 \u24494 \u23567 \u30340 \u65288 MARGINAL\u65289 \u12301 \u20462 \u27491 \u12290 ", "emojis": ["\u55357 \u56521 ", "\u55357 \u56528 ", "\u55357 \u56516 "] \}, "example": "The new advertising campaign resulted in only a marginal increase in total monthly sales.", "example_zh": "\u26032 \u30340 \u24291 \u21578 \u27963 \u21205 \u20677 \u20351 \u27599 \u26376 \u30340 \u32317 \u37559 \u21806 \u38989 \u20986 \u29694 \u20102 \u24494 \u23567 \u30340 \u22686 \u38263 \u12290 ", "collocations": [ "marginal increase", "marginal utility", "marginal improvement", "marginal cost", "remain marginal" ], "synonyms": ["slight", "minimal", "insignificant", "peripheral"], "near_synonyms": [ \{ "word": "slight", "difference": "slight refers directly to small size, weight, or degree; marginal implies something sitting on the very outer edge of importance or a statistical boundary." \}, \{ "word": "insignificant", "difference": "insignificant implies that something is completely useless or worthless; marginal means it has value but it is very close to the lowest threshold." \} ], "antonyms": ["significant", "substantial", "central"], "word_family": [ \{ "word": "marginal", "pos": "adjective" \}, \{ "word": "margin", "pos": "noun" \}, \{ "word": "marginally", "pos": "adverb" \}, \{ "word": "marginalize", "pos": "verb" \} ], "usage_note": "In economics, 'marginal cost' (\u37002 \u38555 \u25104 \u26412 ) and 'marginal utility' (\u37002 \u38555 \u25928 \u29992 ) are critical terms dealing with the cost or benefit of producing one extra unit.", "frequency_rank": 38, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "economics", "academic"] \}, \{ "word": "modify", "pos": "verb", "phonetic": "/\u712 m\u593 \u720 d\u618 fa\u618 /", "definition": "To make partial or minor changes to something, typically to improve it or make it more suitable for a specific purpose.", "definition_zh": "\u20462 \u25913 \u65307 \u26356 \u25913 \u65307 \u20462 \u27491 \u65307 \u65288 \u25991 \u27861 \u65289 \u20462 \u39166 ", "etymology": \{ "roots": [ \{ "root": "mod / modus", "origin": "Latin", "meaning": "measure, limit, manner", "meaning_zh": "\u34913 \u37327 \u12289 \u38480 \u21046 \u12289 \u38480 \u24230 " \}, \{ "root": "fy / fac / facere", "origin": "Latin", "meaning": "to make, do", "meaning_zh": "\u20570 \u12289 \u20351 \u24471 " \} ] \}, "mnemonic": \{ "root_memory": "MOD\u65288 \u38480 \u21046 /\u38480 \u24230 \u65289 + FY\u65288 \u20570 \u65289 \u8594  \u20570 \u20986 \u19968 \u20123 \u35519 \u25972 \u65292 \u20351 \u20854 \u31526 \u21512 \u38480 \u24230 \u33287 \u35215 \u26684 ", "story_en": "The mechanics had to make the engine fit the standard MOD (measure) to MODIFY the sports car for racing rules.", "story_zh": "\u25216 \u24037 \u24517 \u38920 \u35731 \u24341 \u25806 \u31526 \u21512 \u35215 \u26684 \u12300 \u38480 \u24230 \u65288 MOD\u65289 \u12301 \u65292 \u20197 \u27492 \u12300 \u20462 \u25913 \u65288 MODIFY\u65289 \u12301 \u36305 \u36554 \u20197 \u31526 \u21512 \u36093 \u20107 \u35215 \u21063 \u12290 ", "emojis": ["\u55357 \u57056 \u65039 ", "\u9999 \u65039 ", "\u55357 \u56580 "] \}, "example": "The architect agreed to modify the building plans to incorporate a wider elevator shaft.", "example_zh": "\u24314 \u31689 \u24107 \u21516 \u24847 \u20462 \u25913 \u24314 \u31689 \u34253 \u22294 \u65292 \u20197 \u32013 \u20837 \u26356 \u23532 \u30340 \u38651 \u26799 \u20117 \u12290 ", "collocations": [ "modify behavior", "modify plans", "significantly modify", "modify code", "need to modify" ], "synonyms": ["alter", "amend", "adjust", "revise"], "near_synonyms": [ \{ "word": "alter", "difference": "alter means to make a structural, noticeable change in character or appearance; modify implies smaller, functional tweaks aimed at optimization or safety guidelines." \}, \{ "word": "change", "difference": "change is a broad, common word that can mean discarding the old entirely to replace it with something completely different." \} ], "antonyms": ["preserve", "maintain", "leave unchanged"], "word_family": [ \{ "word": "modify", "pos": "verb" \}, \{ "word": "modification", "pos": "noun" \}, \{ "word": "modified", "pos": "adjective" \} ], "usage_note": "In biology, GMO stands for 'Genetically Modified Organism' (\u22522 \u22240 \u25913 \u36896 \u29983 \u29289 ), using 'modified' to show targeted scientific alteration.", "frequency_rank": 39, "frequency_source": "custom", "difficulty": "B1", "tags": ["college", "technology", "academic"] \}, \{ "word": "negotiate", "pos": "verb", "phonetic": "/n\u618 \u712 \u609 o\u650 \u643 ie\u618 t/", "definition": "To try to reach an agreement or compromise through formal discussion and bargaining with others.", "definition_zh": "\u35527 \u21028 \u65307 \u21332 \u21830 \u65307 \u20132 \u28041 ", "etymology": \{ "roots": [ \{ "root": "neg", "origin": "Latin", "meaning": "not", "meaning_zh": "\u19981 \u12289 \u38750 " \}, \{ "root": "ot / otium", "origin": "Latin", "meaning": "leisure, ease, rest", "meaning_zh": "\u38290 \u26247 \u12289 \u20241 \u24687 " \} ] \}, "mnemonic": \{ "root_memory": "NEG\u65288 \u19981 \u65289 + OT\u65288 \u38290 \u26247 \u65289 \u8594  \u19981 \u33021 \u20241 \u24687 \u38290 \u26179 \u65292 \u24517 \u38920 \u35469 \u30495 \u22352 \u19979 \u20358 \u35527 \u29983 \u24847 ", "story_en": "Merchants have NEG (no) time for OT (leisure) when they must sit at the table and NEGOTIATE the trade contract.", "story_zh": "\u30070 \u21830 \u23478 \u24517 \u38920 \u22352 \u22312 \u26700 \u21069 \u12300 \u35527 \u21028 \u65288 NEGOTIATE\u65289 \u12301 \u3603