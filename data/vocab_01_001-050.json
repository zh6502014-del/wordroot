\outl0\strokewidth0 \strokec2 [ \{ "word": "advocate", "pos": "verb", "phonetic": "/\uc0\u712 \'e6dv\u601 ke\u618 t/", "definition": "To publicly recommend, support, or urge for a particular policy, cause, or course of action.", "definition_zh": "\u25793 \u35703 \u65307 \u25552 \u20513 \u65307 \u20027 \u24373 ", "etymology": \{ "roots": [ \{ "root": "ad", "origin": "Latin", "meaning": "to, toward", "meaning_zh": "\u21521 \u12289 \u26397 \u21521 " \}, \{ "root": "voc / vocare", "origin": "Latin", "meaning": "to call", "meaning_zh": "\u21628 \u21898 \u12289 \u21483 " \} ] \}, "mnemonic": \{ "root_memory": "AD\u65288 \u21521 \u65289 + VOC\u65288 \u22823 \u21898 \u65289 \u8594  \u21521 \u22823 \u30526 \u22823 \u32882 \u21628 \u21898 \u20197 \u23563 \u27714 \u25903 \u25345 ", "story_en": "The activist went to AD (to) the stage to VOC (call) upon the citizens to ADVOCATE for environmental protection.", "story_zh": "\u25239 \u35696 \u32773 \u36208 \u21521 \u65288 AD\u65289 \u33310 \u21488 \u22823 \u32882 \u21628 \u21898 \u65288 VOC\u65289 \u65292 \u21628 \u31858 \u24066 \u27665 \u19968 \u21516 \u12300 \u25552 \u20513 \u65288 ADVOCATE\u65289 \u12301 \u29872 \u20445 \u12290 ", "emojis": ["\u55357 \u56546 ", "\u9994 ", "\u55356 \u57137 "] \}, "example": "Many economists advocate introducing a carbon tax to tackle climate change globally.", "example_zh": "\u35377 \u22810 \u32147 \u28639 \u23416 \u23478 \u25552 \u20513 \u38283 \u24501 \u30899 \u31237 \u65292 \u20197 \u25033 \u23565 \u20840 \u29699 \u27683 \u20505 \u35722 \u36983 \u12290 ", "collocations": [ "openly advocate", "advocate change", "advocate policies", "strongly advocate", "advocate for the rights of" ], "synonyms": ["champion", "support", "promote", "endorse"], "near_synonyms": [ \{ "word": "defend", "difference": "defend implies protecting something under active attack; advocate means promoting or recommending a new or preferred idea." \}, \{ "word": "suggest", "difference": "suggest is a gentle or tentative expression of an idea; advocate implies a strong, active, and public endorsement." \} ], "antonyms": ["oppose", "condemn", "resist"], "word_family": [ \{ "word": "advocate", "pos": "verb / noun" \}, \{ "word": "advocacy", "pos": "noun" \} ], "usage_note": "When used as a verb, 'advocate' can take a direct object (advocate a policy) or be followed by 'for' (advocate for a policy), though the direct object form is preferred in formal writing.", "frequency_rank": 1, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "academic", "politics"] \}, \{ "word": "ambiguous", "pos": "adjective", "phonetic": "/\'e6m\u712 b\u618 \u609 ju\u601 s/", "definition": "Open to more than one interpretation, or having a double meaning, often causing confusion or uncertainty.", "definition_zh": "\u21547 \u31946 \u19981 \u28165 \u30340 \u65307 \u24341 \u36215 \u27495 \u32681 \u30340 \u65307 \u27169 \u31260 \u20841 \u21487 \u30340 ", "etymology": \{ "roots": [ \{ "root": "ambi", "origin": "Latin", "meaning": "both, around", "meaning_zh": "\u20841 \u32773 \u12289 \u21608 \u22285 " \}, \{ "root": "ag / ig / agere", "origin": "Latin", "meaning": "to drive, lead, act", "meaning_zh": "\u39493 \u20351 \u12289 \u24341 \u23566 \u12289 \u20570 " \} ] \}, "mnemonic": \{ "root_memory": "AMBI\u65288 \u20841 \u37002 \u65289 + IG\u65288 \u39493 \u20351 \u65289 \u8594  \u34987 \u24448 \u20841 \u37002 \u25289 \u25199 \u65292 \u35731 \u20154 \u25720 \u19981 \u33879 \u38957 \u32210 ", "story_en": "The sign was AMBI (both) ways, which IG (drove) drivers to make AMBIGUOUS decisions at the intersection.", "story_zh": "\u25351 \u27161 \u21516 \u26178 \u25351 \u21521 \u20841 \u37002 \u65288 AMBI\u65289 \u65292 \u36889 \u39493 \u20351 \u65288 IG\u65289 \u39381 \u39387 \u22312 \u21313 \u23383 \u36335 \u21475 \u20570 \u20986 \u12300 \u27169 \u31260 \u20841 \u21487 \u30340 \u65288 AMBIGUOUS\u65289 \u12301 \u27770 \u23450 \u12290 ", "emojis": ["\u10067 ", "\u55357 \u56826 \u65039 ", "\u55358 \u56631 "] \}, "example": "The legislation was deliberately left ambiguous to allow for future political compromises.", "example_zh": "\u35442 \u27861 \u35215 \u21051 \u24847 \u20445 \u25345 \u21547 \u31946 \u19981 \u28165 \u65292 \u20197 \u20415 \u28858 \u26410 \u20358 \u30340 \u25919 \u27835 \u22949 \u21332 \u30041 \u20986 \u31354 \u38291 \u12290 ", "collocations": [ "ambiguous phrasing", "highly ambiguous", "deliberately ambiguous", "ambiguous wording", "remain ambiguous" ], "synonyms": ["equivocal", "vague", "unclear", "cryptic"], "near_synonyms": [ \{ "word": "vague", "difference": "vague means lacking detail or precision in general; ambiguous specifically means capable of being understood in two or more distinct ways." \}, \{ "word": "obscure", "difference": "obscure means little known or hidden from view; ambiguous means visible or known but difficult to interpret clearly." \} ], "antonyms": ["unambiguous", "clear", "explicit"], "word_family": [ \{ "word": "ambiguous", "pos": "adjective" \}, \{ "word": "ambiguity", "pos": "noun" \}, \{ "word": "ambiguously", "pos": "adverb" \} ], "usage_note": "Use 'ambiguous' when a statement has multiple potential meanings; use 'vague' when a statement simply doesn't contain enough information to be useful.", "frequency_rank": 2, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "academic", "TOEFL"] \}, \{ "word": "attribute", "pos": "verb", "phonetic": "/\u601 \u712 tr\u618 bju\u720 t/", "definition": "To regard something as being caused by, or belonging to, a specific person, thing, or source.", "definition_zh": "\u27512 \u22240 \u26044 \u65307 \u27512 \u21151 \u26044 \u65307 \u35469 \u28858 \'85\u26159 \u26576 \u20154 \u25152 \u20570 ", "etymology": \{ "roots": [ \{ "root": "ad", "origin": "Latin", "meaning": "to, toward", "meaning_zh": "\u21521 \u12289 \u32102 \u20104 " \}, \{ "root": "tribut / tribuere", "origin": "Latin", "meaning": "to assign, give, pay", "meaning_zh": "\u20998 \u37197 \u12289 \u32102 \u20104 " \} ] \}, "mnemonic": \{ "root_memory": "AD\u65288 \u21521 \u65289 + TRIBUT\u65288 \u32102 \u20104 \u65289 \u8594  \u25226 \u32080 \u26524 \u27512 \u32102 \u26576 \u20491 \u21407 \u22240 ", "story_en": "The scholars AD (to) tribute to the master and ATTRIBUTE the discovery entirely to his guidance.", "story_zh": "\u23416 \u32773 \u20497 \u21521 \u65288 AD\u65289 \u22823 \u24107 \u33268 \u25964 \u65292 \u20006 \u23559 \u65288 TRIBUT\u65289 \u36889 \u38917 \u30332 \u29694 \u12300 \u27512 \u21151 \u26044 \u65288 ATTRIBUTE\u65289 \u12301 \u20182 \u30340 \u25351 \u23566 \u12290 ", "emojis": ["\u55356 \u57263 ", "\u55358 \u56812 ", "\u55357 \u56540 "] \}, "example": "Scientists attribute the recent increase in extreme weather events to global warming.", "example_zh": "\u31185 \u23416 \u23478 \u23559 \u36817 \u26399 \u26997 \u31471 \u22825 \u27683 \u20107 \u20214 \u30340 \u22686 \u21152 \u27512 \u22240 \u26044 \u20840 \u29699 \u26262 \u21270 \u12290 ", "collocations": [ "attribute success to", "directly attribute", "attribute A to B", "commonly attributed to", "solely attribute" ], "synonyms": ["ascribe", "credit", "assign", "impute"], "near_synonyms": [ \{ "word": "ascribe", "difference": "ascribe is highly formal and can refer to abstract qualities; attribute is more common and often links direct causes to effects." \}, \{ "word": "credit", "difference": "credit is used strictly when the outcome is positive or praiseworthy; attribute can be used for positive, negative, or neutral causes." \} ], "antonyms": ["deny", "dissociate"], "word_family": [ \{ "word": "attribute", "pos": "verb / noun" \}, \{ "word": "attribution", "pos": "noun" \}, \{ "word": "attributable", "pos": "adjective" \} ], "usage_note": "Pay attention to pronunciation: the verb is /\u601 \u712 tr\u618 bju\u720 t/ (stress on second syllable), while the noun (meaning characteristic) is /\u712 \'e6tr\u618 bju\u720 t/ (stress on first syllable).", "frequency_rank": 3, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "academic", "science"] \}, \{ "word": "autonomous", "pos": "adjective", "phonetic": "/\u596 \u720 \u712 t\u593 \u720 n\u601 m\u601 s/", "definition": "Existing or acting independently; having the freedom and authority to govern itself or control its own affairs.", "definition_zh": "\u33258 \u27835 \u30340 \u65307 \u33258 \u20027 \u30340 \u65307 \u29544 \u31435 \u33258 \u20027 \u30340 ", "etymology": \{ "roots": [ \{ "root": "auto", "origin": "Greek", "meaning": "self", "meaning_zh": "\u33258 \u24049 \u12289 \u33258 \u36523 " \}, \{ "root": "nomos", "origin": "Greek", "meaning": "law, custom", "meaning_zh": "\u27861 \u24459 \u12289 \u31649 \u29702 " \} ] \}, "mnemonic": \{ "root_memory": "AUTO\u65288 \u33258 \u24049 \u65289 + NOMOS\u65288 \u27861 \u24459 \u65289 \u8594  \u33258 \u24049 \u21046 \u23450 \u27861 \u24459 \u20358 \u31649 \u29702 \u33258 \u24049 ", "story_en": "An AUTO (self) governing region makes its own NOMOS (laws) to remain fully AUTONOMOUS from the empire.", "story_zh": "\u19968 \u20491 \u33258 \u25105 \u65288 AUTO\u65289 \u27835 \u29702 \u30340 \u22320 \u21312 \u24314 \u31435 \u20102 \u33258 \u24049 \u30340 \u27861 \u24459 \u65288 NOMOS\u65289 \u65292 \u20197 \u20445 \u25345 \u23436 \u20840 \u12300 \u33258 \u27835 \u30340 \u65288 AUTONOMOUS\u65289 \u12301 \u29376 \u24907 \u12290 ", "emojis": ["\u55357 \u56983 ", "\u55356 \u57104 ", "\u55357 \u56650 \u65039 "] \}, "example": "The university's research departments operate as autonomous units with their own budgets.", "example_zh": "\u35442 \u22823 \u23416 \u30340 \u30740 \u31350 \u37096 \u38272 \u20316 \u28858 \u25793 \u26377 \u29544 \u31435 \u38928 \u31639 \u30340 \u33258 \u20027 \u21934 \u20301 \u36939 \u20316 \u12290 ", "collocations": [ "autonomous region", "autonomous vehicle", "highly autonomous", "fully autonomous", "autonomous individual" ], "synonyms": ["independent", "sovereign", "self-governing", "free"], "near_synonyms": [ \{ "word": "independent", "difference": "independent is general and means not relying on others; autonomous specifically emphasizes internal rules, governance, or operational systems." \}, \{ "word": "sovereign", "difference": "sovereign carries a heavier political weight, usually implying supreme authority and international recognition as a nation." \} ], "antonyms": ["dependent", "subordinate", "controlled"], "word_family": [ \{ "word": "autonomous", "pos": "adjective" \}, \{ "word": "autonomy", "pos": "noun" \}, \{ "word": "autonomously", "pos": "adverb" \} ], "usage_note": "In modern technology, 'autonomous' is the standard term for systems (like self-driving cars or drones) that operate without human intervention.", "frequency_rank": 4, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "technology", "politics"] \}, \{ "word": "coherent", "pos": "adjective", "phonetic": "/ko\u650 \u712 h\u618 r\u601 nt/", "definition": "Logical, orderly, and consistent; clear and easy to understand because all parts fit together well.", "definition_zh": "\u36899 \u36011 \u30340 \u65307 \u26781 \u29702 \u20998 \u26126 \u30340 \u65307 \u21069 \u24460 \u19968 \u33268 \u30340 ", "etymology": \{ "roots": [ \{ "root": "co", "origin": "Latin", "meaning": "together", "meaning_zh": "\u20849 \u21516 \u12289 \u19968 \u36215 " \}, \{ "root": "her / haerere", "origin": "Latin", "meaning": "to stick", "meaning_zh": "\u40655 \u36028 \u12289 \u32202 \u36028 " \} ] \}, "mnemonic": \{ "root_memory": "CO\u65288 \u19968 \u36215 \u65289 + HER\u65288 \u40655 \u20303 \u65289 \u8594  \u25152 \u26377 \u35264 \u40670 \u32202 \u23494 \u40655 \u22312 \u19968 \u36215 \u65292 \u24456 \u26377 \u26781 \u29702 ", "story_en": "When all paragraphs CO (together) HER (stick), the essay becomes a COHERENT argument.", "story_zh": "\u30070 \u25152 \u26377 \u27573 \u33853 \u37117 \u32202 \u23494 \u12300 \u40655 \u65288 HER\u65289 \u12301 \u22312 \u12300 \u19968 \u36215 \u65288 CO\u65289 \u12301 \u26178 \u65292 \u36889 \u31687 \u35542 \u25991 \u23601 \u25104 \u20102 \u19968 \u20491 \u12300 \u36899 \u36011 \u30340 \u65288 COHERENT\u65289 \u12301 \u35542 \u35657 \u12290 ", "emojis": ["\u55358 \u56809 ", "\u55357 \u56541 ", "\u55358 \u56800 "] \}, "example": "The minister failed to provide a coherent explanation for the sudden policy shift.", "example_zh": "\u37096 \u38263 \u26410 \u33021 \u23565 \u31361 \u28982 \u30340 \u25919 \u31574 \u36681 \u35722 \u25552 \u20379 \u26781 \u29702 \u20998 \u26126 \u30340 \u35299 \u37323 \u12290 ", "collocations": [ "coherent strategy", "coherent argument", "coherent policy", "perfectly coherent", "lack a coherent" ], "synonyms": ["logical", "consistent", "articulate", "lucid"], "near_synonyms": [ \{ "word": "logical", "difference": "logical emphasizes adherence to the rules of formal reasoning; coherent emphasizes that all components flow smoothly and fit together naturally." \}, \{ "word": "lucid", "difference": "lucid specifically highlights clarity and ease of understanding, often describing expression or a state of mind." \} ], "antonyms": ["incoherent", "fragmented", "illogical"], "word_family": [ \{ "word": "coherent", "pos": "adjective" \}, \{ "word": "coherence", "pos": "noun" \}, \{ "word": "coherently", "pos": "adverb" \} ], "usage_note": "Coherent is frequently used to evaluate writing, speeches, economic plans, and legal arguments that require high logical integration.", "frequency_rank": 5, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "academic", "language"] \}, \{ "word": "compensate", "pos": "verb", "phonetic": "/\u712 k\u593 \u720 mpense\u618 t/", "definition": "To give someone something, typically money, in recognition of loss, suffering, or injury; or to act to neutralize an adverse effect.", "definition_zh": "\u35036 \u20767 \u65307 \u36064 \u20767 \u65307 \u24396 \u35036 ", "etymology": \{ "roots": [ \{ "root": "com", "origin": "Latin", "meaning": "together, thoroughly", "meaning_zh": "\u20849 \u21516 \u12289 \u24505 \u24213 " \}, \{ "root": "pens / pendere", "origin": "Latin", "meaning": "to weigh, pay", "meaning_zh": "\u31281 \u37325 \u12289 \u34913 \u37327 \u12289 \u25903 \u20184 " \} ] \}, "mnemonic": \{ "root_memory": "COM\u65288 \u19968 \u36215 \u65289 + PENS\u65288 \u31281 \u37325 \u65289 \u8594  \u25226 \u25613 \u22833 \u21644 \u37666 \u25918 \u22312 \u22825 \u24179 \u20841 \u31471 \u31281 \u37325 \u65292 \u20351 \u20854 \u24179 \u34913 ", "story_en": "The judge will weigh COM (together) the damages and the PENS (payment) to COMPENSATE the victim.", "story_zh": "\u27861 \u23448 \u23559 \u21463 \u25613 \u37096 \u20998 \u33287 \u25903 \u20184 \u27454 \u65288 PENS\u65289 \u25918 \u22312 \u12300 \u19968 \u36215 \u65288 COM\u65289 \u12301 \u31281 \u37325 \u34913 \u37327 \u65292 \u20197 \u12300 \u35036 \u20767 \u65288 COMPENSATE\u65289 \u12301 \u21463 \u23475 \u32773 \u12290 ", "emojis": ["\u9878 \u65039 ", "\u55357 \u56496 ", "\u55358 \u56953 "] \}, "example": "The company agreed to compensate the workers for the additional hours they worked during the holiday.", "example_zh": "\u20844 \u21496 \u21516 \u24847 \u35036 \u20767 \u21214 \u24037 \u22312 \u20551 \u26085 \u26399 \u38291 \u38989 \u22806 \u24037 \u20316 \u21152 \u29677 \u30340 \u34218 \u36039 \u12290 ", "collocations": [ "compensate for losses", "fully compensate", "financially compensate", "compensate victims", "seek to compensate" ], "synonyms": ["reimburse", "indemnify", "make up for", "offset"], "near_synonyms": [ \{ "word": "reimburse", "difference": "reimburse strictly means to pay back money that someone has already spent; compensate is broader and can cover abstract things like pain, time, or effort." \}, \{ "word": "offset", "difference": "offset means to balance one force or effect against another to achieve neutrality, without necessarily involving financial transactions." \} ], "antonyms": ["deprive", "penalize", "damage"], "word_family": [ \{ "word": "compensate", "pos": "verb" \}, \{ "word": "compensation", "pos": "noun" \}, \{ "word": "compensatory", "pos": "adjective" \} ], "usage_note": "When meaning 'to make up for an error or lack', it is usually followed by the preposition 'for' (e.g., His enthusiasm compensates for his lack of experience).", "frequency_rank": 6, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "business", "law"] \}, \{ "word": "complement", "pos": "verb", "phonetic": "/\u712 k\u593 \u720 mpl\u618 ment/", "definition": "To add to something in a way that enhances or improves it; to make something perfect or complete.", "definition_zh": "\u35036 \u20805 \u65307 \u33287 \'85\u30456 \u36628 \u30456 \u25104 \u65307 \u20351 \u23436 \u32654 ", "etymology": \{ "roots": [ \{ "root": "com", "origin": "Latin", "meaning": "together, completely", "meaning_zh": "\u20849 \u21516 \u12289 \u23436 \u20840 " \}, \{ "root": "ple / plere", "origin": "Latin", "meaning": "to fill", "meaning_zh": "\u22635 \u28415 \u12289 \u20805 \u28415 " \} ] \}, "mnemonic": \{ "root_memory": "COM\u65288 \u23436 \u20840 \u65289 + PLE\u65288 \u22635 \u28415 \u65289 \u8594  \u20840 \u37096 \u22635 \u28415 \u65292 \u20351 \u20854 \u23436 \u32654 \u28961 \u32570 ", "story_en": "The red wine was chosen to COM (completely) PLE (fill) the dinner, as it would COMPLEMENT the steak perfectly.", "story_zh": "\u36984 \u25799 \u36889 \u27454 \u32005 \u37202 \u26159 \u28858 \u20102 \u12300 \u23436 \u20840 \u65288 COM\u65289 \u22635 \u28415 \u65288 PLE\u65289 \u12301 \u36889 \u38931 \u26202 \u23476 \u65292 \u22240 \u28858 \u23427 \u33021 \u33287 \u29275 \u25490 \u12300 \u30456 \u36628 \u30456 \u25104 \u65288 COMPLEMENT\u65289 \u12301 \u12290 ", "emojis": ["\u55356 \u57207 ", "\u55358 \u56681 ", "\u55358 \u56809 "] \}, "example": "The husband's calm demeanor complements his wife's energetic personality perfectly.", "example_zh": "\u19976 \u22827 \u27785 \u31337 \u30340 \u33289 \u27490 \u33287 \u22971 \u23376 \u27963 \u21147 \u22235 \u23556 \u30340 \u20491 \u24615 \u23436 \u32654 \u20114 \u35036 \u12290 ", "collocations": [ "perfectly complement", "complement each other", "complement the design", "designed to complement", "beautifully complement" ], "synonyms": ["supplement", "enhance", "complete", "harmonize with"], "near_synonyms": [ \{ "word": "supplement", "difference": "supplement means to add something extra to increase or improve volume; complement means to combine with something else to form a balanced, superior whole." \}, \{ "word": "enhance", "difference": "enhance simply means to improve the quality or value of something, without implying that the two parts fit together as a system." \} ], "antonyms": ["clash with", "detract from", "undermine"], "word_family": [ \{ "word": "complement", "pos": "verb / noun" \}, \{ "word": "complementary", "pos": "adjective" \} ], "usage_note": "Do not confuse 'complement' (to complete/improve) with 'compliment' (to praise). They sound identical but have entirely different meanings and spellings.", "frequency_rank": 7, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "academic", "art"] \}, \{ "word": "comprehensive", "pos": "adjective", "phonetic": "/\u716 k\u593 \u720 mpr\u618 \u712 hens\u618 v/", "definition": "Complete; including all or nearly all elements, aspects, or items of something.", "definition_zh": "\u20840 \u38754 \u30340 \u65307 \u24291 \u27867 \u30340 \u65307 \u21253 \u32645 \u33836 \u35937 \u30340 ", "etymology": \{ "roots": [ \{ "root": "com", "origin": "Latin", "meaning": "together", "meaning_zh": "\u20849 \u21516 \u12289 \u19968 \u36215 " \}, \{ "root": "prehens / prehendere", "origin": "Latin", "meaning": "to seize, grasp", "meaning_zh": "\u25235 \u20303 \u12289 \u25235 \u21462 " \} ] \}, "mnemonic": \{ "root_memory": "COM\u65288 \u19968 \u36215 \u65289 + PREHENS\u65288 \u25235 \u65289 \u8594  \u25226 \u25152 \u26377 \u26481 \u35199 \u20840 \u37096 \u25235 \u22312 \u19968 \u36215 \u65292 \u27794 \u26377 \u36986 \u28431 ", "story_en": "The guide will COM (together) PREHENS (seize) all facts to provide a COMPREHENSIVE overview of the museum.", "story_zh": "\u23566 \u35261 \u21729 \u23559 \u25226 \u25152 \u26377 \u20107 \u23526 \u12300 \u25235 \u65288 PREHENS\u65289 \u12301 \u22312 \u12300 \u19968 \u36215 \u65288 COM\u65289 \u12301 \u65292 \u20197 \u25552 \u20379 \u23565 \u21338 \u29289 \u39208 \u12300 \u20840 \u38754 \u30340 \u65288 COMPREHENSIVE\u65289 \u12301 \u27010 \u36848 \u12290 ", "emojis": ["\u55357 \u56538 ", "\u55356 \u57101 ", "\u55357 \u56589 "] \}, "example": "The insurance policy provides comprehensive coverage against fire, theft, and natural disasters.", "example_zh": "\u35442 \u20445 \u38570 \u21934 \u25552 \u20379 \u37341 \u23565 \u28779 \u28797 \u12289 \u30428 \u31434 \u21644 \u33258 \u28982 \u28797 \u23475 \u30340 \u20840 \u38754 \u20445 \u38556 \u12290 ", "collocations": [ "comprehensive review", "comprehensive insurance", "comprehensive study", "highly comprehensive", "comprehensive approach" ], "synonyms": ["exhaustive", "thorough", "all-inclusive", "extensive"], "near_synonyms": [ \{ "word": "thorough", "difference": "thorough emphasizes depth, care, and attention to small detail; comprehensive emphasizes breadth and including every category or item." \}, \{ "word": "exhaustive", "difference": "exhaustive implies that everything has been tested or checked until absolutely nothing is left, often suggesting a tiring process." \} ], "antonyms": ["partial", "incomplete", "selective"], "word_family": [ \{ "word": "comprehensive", "pos": "adjective" \}, \{ "word": "comprehend", "pos": "verb" \}, \{ "word": "comprehensively", "pos": "adverb" \}, \{ "word": "comprehension", "pos": "noun" \} ], "usage_note": "A common mistake is confusing 'comprehensive' with 'comprehensible' (easy to understand). Remember: comprehensive = full coverage; comprehensible = understandable.", "frequency_rank": 8, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "academic", "business"] \}, \{ "word": "conducive", "pos": "adjective", "phonetic": "/k\u601 n\u712 du\u720 s\u618 v/", "definition": "Making a certain situation or outcome likely or possible; contributing to a desirable result.", "definition_zh": "\u26377 \u21161 \u26044 \'85\u30340 \u65307 \u20419 \u25104 \'85\u30340 ", "etymology": \{ "roots": [ \{ "root": "con", "origin": "Latin", "meaning": "together", "meaning_zh": "\u20849 \u21516 \u12289 \u19968 \u36215 " \}, \{ "root": "duc / ducere", "origin": "Latin", "meaning": "to lead", "meaning_zh": "\u24341 \u23566 \u12289 \u24118 \u38936 " \} ] \}, "mnemonic": \{ "root_memory": "CON\u65288 \u19968 \u36215 \u65289 + DUC\u65288 \u24341 \u23566 \u65289 \u8594  \u22823 \u23478 \u19968 \u36215 \u24341 \u23566 \u20107 \u24907 \u24448 \u22909 \u30340 \u26041 \u21521 \u30332 \u23637 ", "story_en": "Quiet environments CON (together) DUC (lead) minds to focus, making them CONDUCIVE to deep study.", "story_zh": "\u23433 \u38748 \u30340 \u29872 \u22659 \u26371 \u12300 \u24341 \u23566 \u65288 DUC\u65289 \u12301 \u24605 \u32210 \u20957 \u32858 \u22312 \u12300 \u19968 \u36215 \u65288 CON\u65289 \u12301 \u65292 \u36889 \u20351 \u20854 \u12300 \u26377 \u21161 \u26044 \u65288 CONDUCIVE\u65289 \u12301 \u28145 \u24230 \u23416 \u32722 \u12290 ", "emojis": ["\u55356 \u57137 ", "\u55357 \u56520 ", "\u55358 \u56619 "] \}, "example": "The noisy open-plan office is not particularly conducive to intensive research or creative writing.", "example_zh": "\u21557 \u38620 \u30340 \u38283 \u25918 \u24335 \u36774 \u20844 \u23460 \u29305 \u21029 \u19981 \u21033 \u26044 \u36914 \u34892 \u28145 \u20837 \u30740 \u31350 \u25110 \u21109 \u24847 \u23531 \u20316 \u12290 ", "collocations": [ "conducive to learning", "environment conducive to", "not conducive to", "highly conducive", "conducive to health" ], "synonyms": ["favorable", "beneficial", "advantageous", "contributory"], "near_synonyms": [ \{ "word": "favorable", "difference": "favorable describes conditions that are pleasant or helpful; conducive implies a more active, structural contribution to an outcome." \}, \{ "word": "helpful", "difference": "helpful is a general, everyday term applied to people or things; conducive is formal and usually applies to environments, habits, or policies." \} ], "antonyms": ["unfavorable", "adverse", "hindering"], "word_family": [ \{ "word": "conducive", "pos": "adjective" \}, \{ "word": "conduce", "pos": "verb" \} ], "usage_note": "Conducive is almost invariably paired with the preposition 'to' followed by a noun or gerund (e.g., conducive to success).", "frequency_rank": 9, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "academic", "psychology"] \}, \{ "word": "controversial", "pos": "adjective", "phonetic": "/\u716 k\u593 \u720 ntr\u601 \u712 v\u604 \u720 r\u643 l/", "definition": "Giving rise or likely to give rise to public disagreement, heated debate, or conflicting opinions.", "definition_zh": "\u26377 \u29229 \u35696 \u30340 \u65307 \u24341 \u30332 \u29229 \u35542 \u30340 ", "etymology": \{ "roots": [ \{ "root": "contra", "origin": "Latin", "meaning": "against, opposite", "meaning_zh": "\u21453 \u23565 \u12289 \u30456 \u21453 " \}, \{ "root": "vers / vertere", "origin": "Latin", "meaning": "to turn", "meaning_zh": "\u36681 \u21521 " \} ] \}, "mnemonic": \{ "root_memory": "CONTRA\u65288 \u30456 \u21453 \u65289 + VERS\u65288 \u36681 \u65289 \u8594  \u24847 \u35211 \u36681 \u21521 \u30456 \u21453 \u30340 \u26041 \u21521 \u65292 \u27491 \u38754 \u23565 \u25758 ", "story_en": "When a topic forces opinions to turn VERS (turn) CONTRA (against) each other, it becomes CONTROVERSIAL.", "story_zh": "\u30070 \u19968 \u20491 \u35696 \u38988 \u36843 \u20351 \u35264 \u40670 \u12300 \u36681 \u21521 \u65288 VERS\u65289 \u12301 \u24444 \u27492 \u12300 \u30456 \u21453 \u65288 CONTRA\u65289 \u12301 \u30340 \u31435 \u22580 \u26178 \u65292 \u23427 \u23601 \u25104 \u20102 \u12300 \u26377 \u29229 \u35696 \u30340 \u65288 CONTROVERSIAL\u65289 \u12301 \u12290 ", "emojis": ["\u55357 \u56803 \u65039 ", "\u55358 \u56650 ", "\u55357 \u56613 "] \}, "example": "The decision to build a nuclear power plant near the coastline remains highly controversial.", "example_zh": "\u22312 \u28023 \u23736 \u32218 \u38468 \u36817 \u24314 \u36896 \u26680 \u38651 \u24288 \u30340 \u27770 \u23450 \u20381 \u28982 \u20855 \u26377 \u39640 \u24230 \u29229 \u35696 \u12290 ", "collocations": [ "highly controversial", "controversial issue", "controversial decision", "controversial policy", "spark a controversial" ], "synonyms": ["disputed", "contentious", "debatable", "polemical"], "near_synonyms": [ \{ "word": "contentious", "difference": "contentious implies that something actively causes arguments or that a person likes to argue; controversial points to the widespread public status of the disagreement." \}, \{ "word": "debatable", "difference": "debatable means something is not proven fact and can be questioned logically; controversial implies emotional, public conflict." \} ], "antonyms": ["uncontroversial", "indisputable", "agreed"], "word_family": [ \{ "word": "controversial", "pos": "adjective" \}, \{ "word": "controversy", "pos": "noun" \}, \{ "word": "controversially", "pos": "adverb" \} ], "usage_note": "Controversial describes the issue itself, whereas people involved might be described as 'divisive' or 'contentious'.", "frequency_rank": 10, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "politics", "social"] \}, \{ "word": "correlation", "pos": "noun", "phonetic": "/\u716 k\u596 \u720 r\u601 \u712 le\u618 \u643 n/", "definition": "A mutual relationship or connection between two or more things, where a change in one is associated with a change in the other.", "definition_zh": "\u30456 \u38364 \u24615 \u65307 \u30456 \u20114 \u38364 \u20418 ", "etymology": \{ "roots": [ \{ "root": "cor", "origin": "Latin", "meaning": "together", "meaning_zh": "\u20849 \u21516 \u12289 \u19968 \u36215 " \}, \{ "root": "relat / referre", "origin": "Latin", "meaning": "brought back, related", "meaning_zh": "\u24118 \u22238 \u12289 \u38364 \u32879 " \} ] \}, "mnemonic": \{ "root_memory": "COR\u65288 \u19968 \u36215 \u65289 + RELAT\u65288 \u38364 \u32879 \u65289 \u8594  \u20841 \u20491 \u20107 \u29289 \u32202 \u23494 \u32879 \u32363 \u22312 \u19968 \u36215 \u30340 \u38364 \u20418 ", "story_en": "Scientists study how two variables are COR (together) RELAT (related) to establish a clear CORRELATION.", "story_zh": "\u31185 \u23416 \u23478 \u30740 \u31350 \u20841 \u20491 \u35722 \u25976 \u26159 \u22914 \u20309 \u12300 \u32879 \u32363 \u65288 RELAT\u65289 \u12301 \u22312 \u12300 \u19968 \u36215 \u65288 COR\u65289 \u12301 \u30340 \u65292 \u20197 \u24314 \u31435 \u26126 \u30906 \u30340 \u12300 \u30456 \u38364 \u24615 \u65288 CORRELATION\u65289 \u12301 \u12290 ", "emojis": ["\u55357 \u56520 ", "\u55357 \u56522 ", "\u55357 \u56599 "] \}, "example": "Statistical evidence shows a strong correlation between high sugar consumption and obesity rates.", "example_zh": "\u32113 \u35336 \u35657 \u25818 \u39023 \u31034 \u65292 \u39640 \u31958 \u25885 \u21462 \u37327 \u33287 \u32933 \u32982 \u29575 \u20043 \u38291 \u23384 \u22312 \u24375 \u28872 \u30340 \u30456 \u38364 \u24615 \u12290 ", "collocations": [ "strong correlation", "direct correlation", "statistical correlation", "correlation between", "positive correlation" ], "synonyms": ["connection", "link", "association", "interdependence"], "near_synonyms": [ \{ "word": "causation", "difference": "causation means one event directly produces another; correlation only means the two events change together, without proving one caused the other." \}, \{ "word": "association", "difference": "association is a general term for any link or mental connection; correlation usually implies a measurable, structural, or statistical relationship." \} ], "antonyms": ["independence", "disconnection", "irrelevance"], "word_family": [ \{ "word": "correlation", "pos": "noun" \}, \{ "word": "correlate", "pos": "verb" \}, \{ "word": "correlative", "pos": "adjective" \} ], "usage_note": "A foundational rule in data science and academic logic is: 'Correlation does not imply causation' (\u30456 \u38364 \u19981 \u20195 \u34920 \u22240 \u26524 ).", "frequency_rank": 11, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "academic", "math"] \}, \{ "word": "deficient", "pos": "adjective", "phonetic": "/d\u618 \u712 f\u618 \u643 nt/", "definition": "Not having enough of a specified quality or ingredient; lacking in something necessary.", "definition_zh": "\u32570 \u20047 \u30340 \u65307 \u19981 \u36275 \u30340 \u65307 \u26377 \u32570 \u38519 \u30340 ", "etymology": \{ "roots": [ \{ "root": "de", "origin": "Latin", "meaning": "down, away from", "meaning_zh": "\u21521 \u19979 \u12289 \u38626 \u38283 \u12289 \u28187 \u23569 " \}, \{ "root": "fic / fac / facere", "origin": "Latin", "meaning": "to make, do", "meaning_zh": "\u20570 \u12289 \u35069 \u36896 " \} ] \}, "mnemonic": \{ "root_memory": "DE\u65288 \u21521 \u19979 /\u23569 \u65289 + FIC\u65288 \u20570 \u65289 \u8594  \u20570 \u24471 \u19981 \u22816 \u65292 \u25976 \u37327 \u24448 \u19979 \u25481 \u65292 \u23566 \u33268 \u32570 \u20047 ", "story_en": "Because the chef did DE (down) FIC (make) the prep work, the soup was DEFICIENT in salt.", "story_zh": "\u22240 \u28858 \u24282 \u24107 \u20570 \u65288 FIC\u65289 \u24471 \u22826 \u23569 \u12289 \u24448 \u19979 \u25481 \u65288 DE\u65289 \u65292 \u23566 \u33268 \u36889 \u36947 \u28271 \u22312 \u40573 \u20998 \u19978 \u39023 \u24471 \u12300 \u32570 \u20047 \u30340 \u65288 DEFICIENT\u65289 \u12301 \u12290 ", "emojis": ["\u55357 \u56521 ", "\u55356 \u57163 ", "\u10060 "] \}, "example": "A diet deficient in vitamin D can lead to severe bone weakness over time.", "example_zh": "\u38263 \u26399 \u32780 \u35328 \u65292 \u32570 \u20047 \u32173 \u29983 \u32032  D \u30340 \u39154 \u39135 \u26371 \u23566 \u33268 \u22196 \u37325 \u30340 \u39592 \u39612 \u33030 \u24369 \u12290 ", "collocations": [ "deficient in", "mentally deficient", "iron deficient", "seriously deficient", "deficient performance" ], "synonyms": ["lacking", "insufficient", "inadequate", "scanty"], "near_synonyms": [ \{ "word": "insufficient", "difference": "insufficient refers general quantity (not enough food); deficient implies that the quality or an essential element within a system is critically missing." \}, \{ "word": "scarce", "difference": "scarce applies to resources available in small quantities across a market or region; deficient applies to an internal lack within a specific subject." \} ], "antonyms": ["sufficient", "adequate", "abundant"], "word_family": [ \{ "word": "deficient", "pos": "adjective" \}, \{ "word": "deficiency", "pos": "noun" \}, \{ "word": "deficit", "pos": "noun" \} ], "usage_note": "Deficient is almost always followed by the preposition 'in' when describing what is lacking (e.g., deficient in iron).", "frequency_rank": 12, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "academic", "science"] \}, \{ "word": "demonstrate", "pos": "verb", "phonetic": "/\u712 dem\u601 nstre\u618 t/", "definition": "To show clearly by giving proof, evidence, or examples; or to explain how something works by operating it.", "definition_zh": "\u35657 \u26126 \u65307 \u35657 \u23526 \u65307 \u31034 \u31684 \u65307 \u23637 \u31034 ", "etymology": \{ "roots": [ \{ "root": "de", "origin": "Latin", "meaning": "completely, thoroughly", "meaning_zh": "\u23436 \u20840 \u12289 \u24505 \u24213 " \}, \{ "root": "monstr / monstrare", "origin": "Latin", "meaning": "to show, point out", "meaning_zh": "\u23637 \u31034 \u12289 \u25351 \u20986 " \} ] \}, "mnemonic": \{ "root_memory": "DE\u65288 \u24505 \u24213 \u65289 + MONSTR\u65288 \u23637 \u31034 \u65289 \u8594  \u24505 \u24213 \u23637 \u31034 \u20986 \u20358 \u32102 \u25152 \u26377 \u20154 \u30475 \u65292 \u20197 \u27714 \u35657 \u26126 ", "story_en": "The engineer will DE (completely) MONSTR (show) the blueprint to DEMONSTRATE the safety of the bridge.", "story_zh": "\u24037 \u31243 \u24107 \u23559 \u12300 \u24505 \u24213 \u65288 DE\u65289 \u23637 \u31034 \u65288 MONSTR\u65289 \u12301 \u34253 \u22294 \u65292 \u20197 \u12300 \u35657 \u26126 \u65288 DEMONSTRATE\u65289 \u12301 \u27211 \u27153 \u30340 \u23433 \u20840 \u24615 \u12290 ", "emojis": ["\u55358 \u56785 \u8205 \u55356 \u57323 ", "\u55358 \u56810 ", "\u55357 \u56522 "] \}, "example": "The laboratory experiment successfully demonstrated the law of conservation of energy.", "example_zh": "\u35442 \u23526 \u39511 \u23460 \u23526 \u39511 \u25104 \u21151 \u35657 \u23526 \u20102 \u33021 \u37327 \u23432 \u24646 \u23450 \u24459 \u12290 ", "collocations": [ "clearly demonstrate", "demonstrate skills", "demonstrate a method", "ability to demonstrate", "experiment demonstrated" ], "synonyms": ["prove", "illustrate", "manifest", "verify"], "near_synonyms": [ \{ "word": "prove", "difference": "prove means to establish absolute truth beyond doubt; demonstrate emphasizes showing the process or evidence visually or logically so others can follow." \}, \{ "word": "illustrate", "difference": "illustrate means to clarify an idea by using comparisons, drawings, or examples, without necessarily trying to prove it true." \} ], "antonyms": ["disprove", "conceal", "refute"], "word_family": [ \{ "word": "demonstrate", "pos": "verb" \}, \{ "word": "demonstration", "pos": "noun" \}, \{ "word": "demonstrable", "pos": "adjective" \} ], "usage_note": "In addition to academic proof, 'demonstrate' can also mean to take part in a public protest (e.g., They demonstrated against the tax hikes).", "frequency_rank": 13, "frequency_source": "custom", "difficulty": "B1", "tags": ["college", "academic", "science"] \}, \{ "word": "diminish", "pos": "verb", "phonetic": "/d\u618 \u712 m\u618 n\u618 \u643 /", "definition": "To make or become less, smaller, or weaker in size, extent, or importance.", "definition_zh": "\u28187 \u23569 \u65307 \u35722 \u23567 \u65307 \u21066 \u24369 \u65307 \u36022 \u20302 ", "etymology": \{ "roots": [ \{ "root": "de", "origin": "Latin", "meaning": "completely, down", "meaning_zh": "\u21521 \u19979 \u12289 \u23436 \u20840 " \}, \{ "root": "min / minuere", "origin": "Latin", "meaning": "to make small", "meaning_zh": "\u35722 \u23567 \u12289 \u20351 \u23567 " \} ] \}, "mnemonic": \{ "root_memory": "DE\u65288 \u19979 \u65289 + MIN\u65288 \u23567 \u65289 \u8594  \u24448 \u19979 \u35722 \u23567 \u65292 \u20351 \u25976 \u37327 \u25110 \u21147 \u37327 \u28187 \u23569 ", "story_en": "As resources go DE (down), the team must MIN (make small) expenses to prevent power from being DIMINISHED.", "story_zh": "\u38568 \u33879 \u36039 \u28304 \u19979 \u28369 \u65288 DE\u65289 \u65292 \u22296 \u38538 \u24517 \u38920 \u12300 \u35722 \u23567 \u65288 MIN\u65289 \u12301 \u38283 \u25903 \u65292 \u20197 \u38450 \u27490 \u21147 \u37327 \u34987 \u12300 \u21066 \u24369 \u65288 DIMINISHED\u65289 \u12301 \u12290 ", "emojis": ["\u55357 \u56521 ", "\u9203 ", "\u55357 \u56687 \u65039 "] \}, "example": "The medication helped to diminish the severe pain in her joints within an hour.", "example_zh": "\u36889 \u27454 \u34277 \u29289 \u22312 \u19968 \u23567 \u26178 \u20839 \u24171 \u21161 \u28187 \u36629 \u20102 \u22905 \u22196 \u37325 \u30340 \u38364 \u31680 \u30140 \u30171 \u12290 ", "collocations": [ "diminish return", "gradually diminish", "diminish influence", "diminish capacity", "nothing can diminish" ], "synonyms": ["decrease", "dwindle", "decline", "subside"], "near_synonyms": [ \{ "word": "decrease", "difference": "decrease is a general term for drops in numbers or size; diminish often carries an abstract nuance of losing value, prestige, or influence." \}, \{ "word": "dwindle", "difference": "dwindle describes a progressive, ongoing shrinking until almost nothing is left (e.g., dwindling savings)." \} ], "antonyms": ["increase", "enhance", "amplify"], "word_family": [ \{ "word": "diminish", "pos": "verb" \}, \{ "word": "diminution", "pos": "noun" \}, \{ "word": "undiminished", "pos": "adjective" \} ], "usage_note": "In economics, the law of 'diminishing returns' (\u37002 \u38555 \u25928 \u30410 \u36958 \u28187 ) is a standard phrase describing shrinking marginal output.", "frequency_rank": 14, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "economics", "academic"] \}, \{ "word": "discrimination", "pos": "noun", "phonetic": "/d\u618 \u716 skr\u618 m\u618 \u712 ne\u618 \u643 n/", "definition": "The unjust or prejudicial treatment of different categories of people, especially on the grounds of race, age, or sex; or the ability to perceive fine distinctions.", "definition_zh": "\u27495 \u35222 \u65307 \u19981 \u20844 \u27491 \u23565 \u24453 \u65307 \u36776 \u21029 \u21147 \u65307 \u35672 \u21029 ", "etymology": \{ "roots": [ \{ "root": "dis", "origin": "Latin", "meaning": "apart, away", "meaning_zh": "\u20998 \u38283 \u12289 \u20559 \u38626 " \}, \{ "root": "crim / cernere", "origin": "Latin", "meaning": "to separate, sift", "meaning_zh": "\u20998 \u38283 \u12289 \u31721 \u36984 \u12289 \u21028 \u23450 " \} ] \}, "mnemonic": \{ "root_memory": "DIS\u65288 \u20998 \u38283 \u65289 + CRIM\u65288 \u31721 \u36984 \u65289 \u8594  \u25226 \u20154 \u20998 \u38283 \u31721 \u36984 \u23565 \u24453 \u65292 \u24418 \u25104 \u19981 \u24179 \u31561 \u30340 \u21123 \u20998 ", "story_en": "To sift DIS (apart) groups based on bias is to CRIM (separate) them unlawfully, creating DISCRIMINATION.", "story_zh": "\u22522 \u26044 \u20559 \u35211 \u23559 \u32676 \u39636 \u12300 \u20998 \u38283 \u65288 DIS\u65289 \u12301 \u20006 \u12300 \u31721 \u36984 \u23565 \u24453 \u65288 CRIM\u65289 \u12301 \u65292 \u23601 \u26371 \u36896 \u25104 \u12300 \u27495 \u35222 \u65288 DISCRIMINATION\u65289 \u12301 \u12290 ", "emojis": ["\u9878 \u65039 ", "\u9994 ", "\u55357 \u57003 "] \}, "example": "The civil rights organization fought tirelessly against racial discrimination in housing markets.", "example_zh": "\u35442 \u27665 \u27402 \u32068 \u32340 \u28858 \u21453 \u23565 \u20303 \u25151 \u24066 \u22580 \u20013 \u30340 \u31278 \u26063 \u27495 \u35222 \u36914 \u34892 \u20102 \u19981 \u25032 \u30340 \u39717 \u29229 \u12290 ", "collocations": [ "racial discrimination", "gender discrimination", "fight against discrimination", "discrimination policy", "price discrimination" ], "synonyms": ["prejudice", "bias", "bigotry", "differentiation"], "near_synonyms": [ \{ "word": "prejudice", "difference": "prejudice refers to an internal negative opinion or attitude formed without basis; discrimination is the actual external action or policy treating people unfairly." \}, \{ "word": "bias", "difference": "bias is a general inclination or preference for or against something, which may not always result in institutional harm." \} ], "antonyms": ["fairness", "equality", "impartiality"], "word_family": [ \{ "word": "discrimination", "pos": "noun" \}, \{ "word": "discriminate", "pos": "verb" \}, \{ "word": "discriminatory", "pos": "adjective" \} ], "usage_note": "In business or economics, 'price discrimination' (\u20729 \u26684 \u27495 \u35222 ) is a neutral technical term meaning charging different consumers different prices for the same product.", "frequency_rank": 15, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "social", "law"] \}, \{ "word": "empirical", "pos": "adjective", "phonetic": "/\u618 m\u712 p\u618 r\u618 kl/", "definition": "Based on, concerned with, or verifiable by observation or experience rather than theory or pure logic.", "definition_zh": "\u32147 \u39511 \u20027 \u32681 \u30340 \u65307 \u20197 \u35264 \u23519 \u25110 \u23526 \u39511 \u28858 \u20381 \u25818 \u30340 \u65307 \u23526 \u35657 \u30340 ", "etymology": \{ "roots": [ \{ "root": "en / em", "origin": "Greek", "meaning": "in, into", "meaning_zh": "\u22312 \'85\u20043 \u20013 \u12289 \u36914 \u20837 " \}, \{ "root": "peira", "origin": "Greek", "meaning": "trial, experiment, attempt", "meaning_zh": "\u22039 \u35430 \u12289 \u23526 \u39511 " \} ] \}, "mnemonic": \{ "root_memory": "EM\u65288 \u22312 \'85\u20013 \u65289 + PEIRA\u65288 \u23526 \u39511 \u65289 \u8594  \u25237 \u36523 \u22312 \u23526 \u39511 \u33287 \u22039 \u35430 \u20043 \u20013 \u24471 \u21040 \u30340 \u32080 \u35542 ", "story_en": "The scientist put EM (in) action a fresh PEIRA (trial) to gather solid EMPIRICAL data.", "story_zh": "\u31185 \u23416 \u23478 \u23559 \u26032 \u30340 \u12300 \u22039 \u35430 \u65288 PEIRA\u65289 \u12301 \u25237 \u20837 \u12300 \u20854 \u20013 \u65288 EM\u65289 \u12301 \u65292 \u20197 \u27492 \u20358 \u25910 \u38598 \u25166 \u23526 \u30340 \u12300 \u23526 \u35657 \u65288 EMPIRICAL\u65289 \u12301 \u25976 \u25818 \u12290 ", "emojis": ["\u55358 \u56810 ", "\u55357 \u56522 ", "\u55357 \u56385 \u65039 "] \}, "example": "The professor presented empirical evidence derived from a ten-year study to support his hypothesis.", "example_zh": "\u25945 \u25480 \u23637 \u31034 \u20102 \u28304 \u33258 \u19968 \u38917 \u28858 \u26399 \u21313 \u24180 \u30740 \u31350 \u30340 \u23526 \u35657 \u35657 \u25818 \u65292 \u20197 \u25903 \u25345 \u20182 \u30340 \u20551 \u35373 \u12290 ", "collocations": [ "empirical evidence", "empirical study", "empirical research", "purely empirical", "empirical analysis" ], "synonyms": ["observational", "experimental", "factual", "verifiable"], "near_synonyms": [ \{ "word": "experimental", "difference": "experimental specifically implies data gathered under controlled laboratory testing; empirical is broader, including historical observations, real-world experience, and fieldwork." \}, \{ "word": "theoretical", "difference": "theoretical is an antonymous near-synonym, meaning based on abstract mathematical models or philosophical logic rather than physical testing." \} ], "antonyms": ["theoretical", "hypothetical", "speculative"], "word_family": [ \{ "word": "empirical", "pos": "adjective" \}, \{ "word": "empiricism", "pos": "noun" \}, \{ "word": "empirically", "pos": "adverb" \} ], "usage_note": "'Empirical evidence' (\u23526 \u35657 \u35657 \u25818 ) is one of the most foundational collocations in academic writing and scientific research papers.", "frequency_rank": 16, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "academic", "science"] \}, \{ "word": "equivalent", "pos": "adjective", "phonetic": "/\u618 \u712 kw\u618 v\u601 l\u601 nt/", "definition": "Equal in value, amount, function, meaning, or importance, though not necessarily identical in form.", "definition_zh": "\u31561 \u20540 \u30340 \u65307 \u30456 \u31561 \u30340 \u65307 \u31561 \u20729 \u30340 \u65307 \u30456 \u23565 \u25033 \u30340 \u29289 ", "etymology": \{ "roots": [ \{ "root": "equi", "origin": "Latin", "meaning": "equal", "meaning_zh": "\u30456 \u31561 \u30340 \u12289 \u24179 \u31561 \u30340 " \}, \{ "root": "val / valere", "origin": "Latin", "meaning": "to be strong, be worth", "meaning_zh": "\u24375 \u22767 \u12289 \u26377 \u20729 \u20540 " \} ] \}, "mnemonic": \{ "root_memory": "EQUI\u65288 \u30456 \u31561 \u65289 + VAL\u65288 \u20729 \u20540 \u65289 \u8594  \u20729 \u20540 \u23436 \u20840 \u30456 \u31561 ", "story_en": "Two currencies with EQUI (equal) VAL (value) are considered completely EQUIVALENT in global trade.", "story_zh": "\u20841 \u31278 \u25793 \u26377 \u12300 \u30456 \u31561 \u65288 EQUI\u65289 \u12301 \u12300 \u20729 \u20540 \u65288 VAL\u65289 \u12301 \u30340 \u36008 \u24163 \u65292 \u22312 \u20840 \u29699 \u36031 \u26131 \u20013 \u34987 \u35222 \u28858 \u23436 \u20840 \u12300 \u31561 \u20540 \u30340 \u65288 EQUIVALENT\u65289 \u12301 \u12290 ", "emojis": ["\u55357 \u56501 ", "\u9878 \u65039 ", "\u55357 \u56580 "] \}, "example": "Spreading rumors online is the moral equivalent of whispering behind someone's back.", "example_zh": "\u22312 \u32178 \u36335 \u19978 \u20659 \u25773 \u35616 \u35328 \u22312 \u36947 \u24503 \u19978 \u31561 \u21516 \u26044 \u22312 \u32972 \u24460 \u23565 \u26576 \u20154 \u25351 \u25351 \u40670 \u40670 \u12290 ", "collocations": [ "roughly equivalent", "equivalent to", "functional equivalent", "cash equivalent", "moral equivalent" ], "synonyms": ["identical", "comparable", "amounting to", "tantamount"], "near_synonyms": [ \{ "word": "identical", "difference": "identical means exactly the same in every detail and physical form; equivalent means different in form but equal in effect, value, or meaning." \}, \{ "word": "similar", "difference": "similar means sharing some common traits but permits variations in total value or function; equivalent implies a strict balance of exchange." \} ], "antonyms": ["different", "unequal", "disparate"], "word_family": [ \{ "word": "equivalent", "pos": "adjective / noun" \}, \{ "word": "equivalence", "pos": "noun" \} ], "usage_note": "Equivalent is commonly used with the preposition 'to' (e.g., Eight kilometers is roughly equivalent to five miles).", "frequency_rank": 17, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "math", "academic"] \}, \{ "word": "evaluate", "pos": "verb", "phonetic": "/\u618 \u712 v\'e6ljue\u618 t/", "definition": "To form an idea of the amount, number, value, or quality of something after careful appraisal.", "definition_zh": "\u35413 \u20272 \u65307 \u35413 \u20729 \u65307 \u20272 \u20729 ", "etymology": \{ "roots": [ \{ "root": "ex / e", "origin": "Latin", "meaning": "out", "meaning_zh": "\u21521 \u22806 \u12289 \u20986 \u20358 " \}, \{ "root": "valu / valere", "origin": "Latin", "meaning": "to be worth", "meaning_zh": "\u26377 \u20729 \u20540 " \} ] \}, "mnemonic": \{ "root_memory": "E\u65288 \u20986 \u20358 \u65289 + VALU\u65288 \u20729 \u20540 \u65289 \u8594  \u25226 \u28507 \u22312 \u30340 \u20729 \u20540 \u31639 \u20986 \u20358 \u65292 \u36914 \u34892 \u35413 \u23450 ", "story_en": "Experts work to bring E (out) the real VALU (worth) of the asset to EVALUATE its market potential.", "story_zh": "\u23560 \u23478 \u33268 \u21147 \u26044 \u23559 \u36039 \u29986 \u30340 \u12300 \u20729 \u20540 \u65288 VALU\u65289 \u12301 \u25512 \u23566 \u12300 \u20986 \u20358 \u65288 E\u65289 \u12301 \u65292 \u20197 \u27492 \u20358 \u12300 \u35413 \u20272 \u65288 EVALUATE\u65289 \u12301 \u20854 \u24066 \u22580 \u28507 \u21147 \u12290 ", "emojis": ["\u55357 \u56523 ", "\u55358 \u56784 ", "\u55357 \u56520 "] \}, "example": "The committee will thoroughly evaluate all research proposals before allocating the grant money.", "example_zh": "\u22996 \u21729 \u26371 \u23559 \u22312 \u20998 \u37197 \u35036 \u21161 \u27454 \u20043 \u21069 \u65292 \u24505 \u24213 \u35413 \u20272 \u25152 \u26377 \u30740 \u31350 \u35336 \u21123 \u26360 \u12290 ", "collocations": [ "thoroughly evaluate", "evaluate performance", "evaluate effectiveness", "critically evaluate", "evaluate options" ], "synonyms": ["assess", "appraise", "estimate", "gauge"], "near_synonyms": [ \{ "word": "assess", "difference": "assess is often used for ongoing processes or systematic measurements (like assessing student tax or skill); evaluate emphasizes judging final quality, merit, or overall worth." \}, \{ "word": "appraise", "difference": "appraise specifically implies putting an official financial or monetary value on a physical property or antique." \} ], "antonyms": ["ignore", "neglect"], "word_family": [ \{ "word": "evaluate", "pos": "verb" \}, \{ "word": "evaluation", "pos": "noun" \}, \{ "word": "evaluative", "pos": "adjective" \} ], "usage_note": "In academic settings, assignments often ask students to 'critically evaluate' an argument, which means weighing its strengths and weaknesses objectively.", "frequency_rank": 18, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "academic", "business"] \}, \{ "word": "exaggerate", "pos": "verb", "phonetic": "/\u618 \u609 \u712 z\'e6d\u658 \u601 re\u618 t/", "definition": "To represent something as being larger, better, worse, or more important than it really is.", "definition_zh": "\u35463 \u22823 \u65307 \u35463 \u24373 \u65307 \u35328 \u36942 \u20854 \u23526 ", "etymology": \{ "roots": [ \{ "root": "ex", "origin": "Latin", "meaning": "thoroughly, out", "meaning_zh": "\u24505 \u24213 \u12289 \u21521 \u22806 " \}, \{ "root": "agger", "origin": "Latin", "meaning": "heap, pile, mound", "meaning_zh": "\u22534 \u12289 \u22303 \u22534 " \} ] \}, "mnemonic": \{ "root_memory": "EX\u65288 \u24505 \u24213 \u65289 + AGGER\u65288 \u22534 \u31309 \u65289 \u8594  \u25226 \u20107 \u24773 \u24505 \u24213 \u22534 \u25104 \u20687 \u22823 \u23665 \u19968 \u27171 \u65292 \u26997 \u24230 \u35463 \u24373 ", "story_en": "Do not EX (thoroughly) aggerate the facts into a massive AGGER (heap) just to make the headline sound scary.", "story_zh": "\u19981 \u35201 \u12300 \u24505 \u24213 \u65288 EX\u65289 \u12301 \u25226 \u20107 \u23526 \u12300 \u22534 \u31309 \u65288 AGGER\u65289 \u12301 \u25104 \u22823 \u23665 \u65292 \u21482 \u28858 \u20102 \u35731 \u26032 \u32862 \u27161 \u38988 \u32893 \u36215 \u20358 \u24456 \u22151 \u20154 \u65288 \u35463 \u22823 \u65289 \u12290 ", "emojis": ["\u55358 \u56613 ", "\u55356 \u57099 ", "\u55357 \u56803 \u65039 "] \}, "example": "The media tends to exaggerate the risks of minor side effects to generate more clicks.", "example_zh": "\u23186 \u39636 \u24448 \u24448 \u26371 \u35463 \u22823 \u36629 \u24494 \u21103 \u20316 \u29992 \u30340 \u39080 \u38570 \u65292 \u20197 \u29554 \u21462 \u26356 \u22810 \u40670 \u38321 \u29575 \u12290 ", "collocations": [ "grossly exaggerate", "tend to exaggerate", "greatly exaggerate", "easy to exaggerate", "exaggerate the importance" ], "synonyms": ["overstate", "magnify", "embellish", "amplify"], "near_synonyms": [ \{ "word": "overstate", "difference": "overstate is formal and focuses strictly on giving figures or claims that are too high; exaggerate is broader and can apply to physical gestures, descriptions, or expressions." \}, \{ "word": "embellish", "difference": "embellish means to add decorative, creative, or fictional details to a story to make it more interesting, not necessarily malicious." \} ], "antonyms": ["understate", "play down", "minimize"], "word_family": [ \{ "word": "exaggerate", "pos": "verb" \}, \{ "word": "exaggeration", "pos": "noun" \}, \{ "word": "exaggerated", "pos": "adjective" \} ], "usage_note": "A common adverbial pairing is 'grossly exaggerated', which means something has been distorted to a ridiculous or deceptive degree.", "frequency_rank": 19, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "language", "social"] \}, \{ "word": "feasible", "pos": "adjective", "phonetic": "/\u712 fi\u720 z\u601 bl/", "definition": "Possible to do easily or conveniently; realistic and likely to be achieved or carried out successfully.", "definition_zh": "\u21487 \u34892 \u30340 \u65307 \u34892 \u24471 \u36890 \u30340 \u65307 \u20999 \u23526 \u21487 \u34892 \u30340 ", "etymology": \{ "roots": [ \{ "root": "feas / fac / facere", "origin": "Latin / Old French", "meaning": "to do, make", "meaning_zh": "\u20570 \u12289 \u35069 \u36896 " \} ] \}, "mnemonic": \{ "root_memory": "FEAS\u65288 \u20570 \u65289 + IBLE\u65288 \u21487 \'85\u30340 \u65289 \u8594  \u36774 \u24471 \u21040 \u30340 \u12289 \u21487 \u20197 \u34987 \u20570 \u20986 \u20358 \u30340 ", "story_en": "If a grand business plan is truly FEAS (doable), it is marked as a FEASIBLE project by the bank.", "story_zh": "\u22914 \u26524 \u19968 \u20491 \u23439 \u22823 \u30340 \u21830 \u26989 \u35336 \u21123 \u26159 \u30495 \u27491 \u12300 \u21487 \u20570 \u65288 FEAS\u65289 \u12301 \u30340 \u65292 \u23427 \u23601 \u26371 \u34987 \u37504 \u34892 \u27161 \u35352 \u28858 \u12300 \u21487 \u34892 \u30340 \u65288 FEASIBLE\u65289 \u12301 \u38917 \u30446 \u12290 ", "emojis": ["\u9989 ", "\u55356 \u57303 \u65039 ", "\u55357 \u56481 "] \}, "example": "With current technology, building a permanent human base on the Moon is entirely feasible.", "example_zh": "\u21033 \u29992 \u29694 \u26377 \u30340 \u25216 \u34899 \u65292 \u22312 \u26376 \u29699 \u19978 \u24314 \u36896 \u27704 \u20037 \u24615 \u30340 \u20154 \u39006 \u22522 \u22320 \u26159 \u23436 \u20840 \u21487 \u34892 \u30340 \u12290 ", "collocations": [ "economically feasible", "feasible alternative", "commercially feasible", "perfectly feasible", "feasible solution" ], "synonyms": ["viable", "practicable", "achievable", "workable"], "near_synonyms": [ \{ "word": "viable", "difference": "viable means capable of surviving, growing, or sustaining itself long-term (like a business model); feasible focus primarily on whether it can be physically executed right now." \}, \{ "word": "possible", "difference": "possible simply means something 
\f1\i can
\f0\i0  happen in theory; feasible implies it is practical, realistic, and makes sense logistically." \} ], "antonyms": ["infeasible", "impractical", "impossible"], "word_family": [ \{ "word": "feasible", "pos": "adjective" \}, \{ "word": "feasibility", "pos": "noun" \}, \{ "word": "feasibly", "pos": "adverb" \} ], "usage_note": "In project management, a 'feasibility study' (\uc0\u21487 \u34892 \u24615 \u30740 \u31350 ) is conducted before investing money to see if a project is worth pursuing.", "frequency_rank": 20, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "business", "technology"] \}, \{ "word": "fluuctuate", "pos": "verb", "phonetic": "/\u712 fl\u652 kt\u643 ue\u618 t/", "definition": "To rise and fall irregularly in number, amount, or strength; to change continually and unpredictably.", "definition_zh": "\u27874 \u21205 \u65307 \u35722 \u21205 \u65307 \u19978 \u19979 \u36215 \u20239 ", "etymology": \{ "roots": [ \{ "root": "fluct / fluere", "origin": "Latin", "meaning": "to flow, wave", "meaning_zh": "\u27969 \u21205 \u12289 \u27874 \u28010 " \} ] \}, "mnemonic": \{ "root_memory": "FLUCT\u65288 \u27874 \u28010 \u65289 \u8594  \u20687 \u27874 \u28010 \u19968 \u27171 \u39640 \u20302 \u36215 \u20239 \u65292 \u27969 \u21205 \u19981 \u23450 ", "story_en": "Stock prices FLUCT (wave) like stormy ocean waves, making it dangerous to predict investments.", "story_zh": "\u32929 \u20729 \u20687 \u27958 \u28263 \u30340 \u12300 \u28023 \u28010 \u65288 FLUCT\u65289 \u12301 \u19968 \u27171 \u19978 \u19979 \u12300 \u27874 \u21205 \u65288 FLUCTUATE\u65289 \u12301 \u65292 \u35731 \u20154 \u38627 \u20197 \u38928 \u28204 \u25237 \u36039 \u39080 \u38570 \u12290 ", "emojis": ["\u55357 \u56520 ", "\u55357 \u56521 ", "\u55356 \u57098 "] \}, "example": "Oil prices tend to fluctuate wildly depending on political stability in the Middle East.", "example_zh": "\u30707 \u27833 \u20729 \u26684 \u24448 \u24448 \u26371 \u26681 \u25818 \u20013 \u26481 \u22320 \u21312 \u30340 \u25919 \u27835 \u31337 \u23450 \u24773 \u27841 \u32780 \u21127 \u28872 \u27874 \u21205 \u12290 ", "collocations": [ "fluctuate wildly", "fluctuate between", "prices fluctuate", "constantly fluctuate", "fluctuate irregularly" ], "synonyms": ["oscillate", "vacillate", "waver", "veer"], "near_synonyms": [ \{ "word": "oscillate", "difference": "oscillate implies moving back and forth smoothly between two fixed scientific parameters or values (like a pendulum); fluctuate implies random, irregular changes." \}, \{ "word": "vacillate", "difference": "vacillate is restricted to human minds or emotions, meaning to hesitate or waver between choosing different options." \} ], "antonyms": ["stabilize", "remain steady", "persist"], "word_family": [ \{ "word": "fluctuate", "pos": "verb" \}, \{ "word": "fluctuation", "pos": "noun" \} ], "usage_note": "Fluctuate is almost always paired with the adverb 'wildly' when describing severe, out-of-control economic market movements.", "frequency_rank": 21, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "economics", "finance"] \}, \{ "word": "hierarchy", "pos": "noun", "phonetic": "/\u712 ha\u618 \u601 r\u593 \u720 rki/", "definition": "A system or organization in which people or groups are ranked one above another according to status, power, or authority.", "definition_zh": "\u31561 \u32026 \u21046 \u24230 \u65307 \u38542 \u23652 \u65307 \u38542 \u32026 ", "etymology": \{ "roots": [ \{ "root": "hieros", "origin": "Greek", "meaning": "sacred, holy", "meaning_zh": "\u31070 \u32854 \u30340 " \}, \{ "root": "arkhein / archy", "origin": "Greek", "meaning": "to rule", "meaning_zh": "\u32113 \u27835 \u12289 \u31649 \u29702 " \} ] \}, "mnemonic": \{ "root_memory": "HIERO\u65288 \u31070 \u32854 \u65289 + ARCHY\u65288 \u32113 \u27835 \u65289 \u8594  \u23447 \u25945 \u26089 \u26399 \u31070 \u32887 \u20154 \u21729 \u30001 \u19978 \u33267 \u19979 \u30340 \u22196 \u26684 \u31649 \u29702 \u39636 \u31995 ", "story_en": "In ancient times, HIERO (sacred) priests established an ARCHY (rule) to maintain a rigid social HIERARCHY.", "story_zh": "\u22312 \u21476 \u20195 \u65292 \u31070 \u32854 \u30340 \u65288 HIERO\u65289 \u31085 \u21496 \u24314 \u31435 \u20102 \u19968 \u22871 \u32113 \u27835 \u39636 \u21046 \u65288 ARCHY\u65289 \u65292 \u20197 \u32173 \u25345 \u22196 \u26684 \u30340 \u31038 \u26371 \u12300 \u31561 \u32026 \u21046 \u24230 \u65288 HIERARCHY\u65289 \u12301 \u12290 ", "emojis": ["\u55357 \u56634 ", "\u55357 \u56401 ", "\u55356 \u57314 "] \}, "example": "In a traditional corporate hierarchy, major strategic decisions flow from top executives down to management.", "example_zh": "\u22312 \u20659 \u32113 \u30340 \u20844 \u21496 \u31561 \u32026 \u21046 \u24230 \u20013 \u65292 \u37325 \u22823 \u30340 \u25136 \u30053 \u27770 \u31574 \u26159 \u30001 \u39640 \u38542 \u20027 \u31649 \u21521 \u19979 \u27969 \u21205 \u21040 \u31649 \u29702 \u23652 \u12290 ", "collocations": [ "corporate hierarchy", "rigid hierarchy", "social hierarchy", "strict hierarchy", "organizational hierarchy" ], "synonyms": ["pecking order", "ranking", "gradation", "echelon"], "near_synonyms": [ \{ "word": "ranking", "difference": "ranking is a simple list sorted from best to worst (like sports teams); hierarchy is a complex structural pyramid showing who has direct power over whom." \}, \{ "word": "echelon", "difference": "echelon refers specifically to a single level or tier within an overall military or governmental system." \} ], "antonyms": ["egalitarianism", "anarchy"], "word_family": [ \{ "word": "hierarchy", "pos": "noun" \}, \{ "word": "hierarchical", "pos": "adjective" \}, \{ "word": "hierarchically", "pos": "adverb" \} ], "usage_note": "Psychology students will frequently encounter this in 'Maslow's hierarchy of needs' (\u39340 \u26031 \u27931 \u38656 \u27714 \u23652 \u27425 \u29702 \u35542 ).", "frequency_rank": 22, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "social", "business"] \}, \{ "word": "hypothesis", "pos": "noun", "phonetic": "/ha\u618 \u712 p\u593 \u720 \u952 \u601 s\u618 s/", "definition": "A proposed explanation made on the basis of limited evidence as a starting point for further investigation or experimentation.", "definition_zh": "\u20551 \u35373 \u65307 \u20551 \u35498 ", "etymology": \{ "roots": [ \{ "root": "hypo", "origin": "Greek", "meaning": "under, beneath", "meaning_zh": "\u22312 \'85\u20043 \u19979 " \}, \{ "root": "tithenai / thesis", "origin": "Greek", "meaning": "to place, a proposition", "meaning_zh": "\u25918 \u32622 \u12289 \u35542 \u40670 " \} ] \}, "mnemonic": \{ "root_memory": "HYPO\u65288 \u22312 \'85\u20043 \u19979 \u65289 + THESIS\u65288 \u26680 \u24515 \u35542 \u40670 \u65289 \u8594  \u22666 \u22312 \u27491 \u24335 \u35542 \u40670 \u24213 \u19979 \u30340 \u21021 \u27493 \u29468 \u24819 ", "story_en": "Before a theory is built, a scientist lays a HYPO (under) statement beneath the THESIS (proposition) as a temporary HYPOTHESIS.", "story_zh": "\u22312 \u24314 \u31435 \u27491 \u24335 \u29702 \u35542 \u21069 \u65292 \u31185 \u23416 \u23478 \u26371 \u22312 \u12300 \u26680 \u24515 \u35542 \u40670 \u65288 THESIS\u65289 \u12301 \u20043 \u12300 \u19979 \u65288 HYPO\u65289 \u12301 \u22666 \u19968 \u20491 \u21021 \u27493 \u24819 \u27861 \u65292 \u20316 \u28858 \u26283 \u26178 \u30340 \u12300 \u20551 \u35373 \u65288 HYPOTHESIS\u65289 \u12301 \u12290 ", "emojis": ["\u55358 \u56810 ", "\u55358 \u56784 ", "\u55357 \u56541 "] \}, "example": "To test the hypothesis, the research team conducted a double-blind clinical study with over five hundred patients.", "example_zh": "\u28858 \u20102 \u35299 \u39511 \u35657 \u35442 \u20551 \u35373 \u65292 \u30740 \u31350 \u22296 \u38538 \u23565 \u20116 \u30334 \u22810 \u21517 \u24739 \u32773 \u36914 \u34892 \u20102 \u38617 \u30450 \u33256 \u24202 \u30740 \u31350 \u12290 ", "collocations": [ "test a hypothesis", "formulate a hypothesis", "working hypothesis", "support the hypothesis", "null hypothesis" ], "synonyms": ["supposition", "theory", "premise", "conjecture"], "near_synonyms": [ \{ "word": "theory", "difference": "theory is a well-substantiated, thoroughly tested scientific explanation supported by vast evidence; hypothesis is just an untested preliminary guess." \}, \{ "word": "guess", "difference": "guess is informal and requires no scientific basis or logic; hypothesis is structured and designed specifically to be tested through experiments." \} ], "antonyms": ["fact", "proof", "certainty"], "word_family": [ \{ "word": "hypothesis", "pos": "noun" \}, \{ "word": "hypothetical", "pos": "adjective" \}, \{ "word": "hypothesize", "pos": "verb" \} ], "usage_note": "Note the plural form: one 'hypothesis' ends in -is, while multiple 'hypotheses' ends in -es (pronounced /ha\u618 \u712 p\u593 \u720 \u952 \u601 si\u720 z/).", "frequency_rank": 23, "frequency_source": "custom", "difficulty": "C1", "tags": ["college", "academic", "science"] \}, \{ "word": "implement", "pos": "verb", "phonetic": "/\u712 \u618 mpl\u618 ment/", "definition": "To put a decision, plan, policy, or agreement into official effect or execution.", "definition_zh": "\u23526 \u26045 \u65307 \u22519 \u34892 \u65307 \u36011 \u24505 ", "etymology": \{ "roots": [ \{ "root": "in / im", "origin": "Latin", "meaning": "in, into", "meaning_zh": "\u36914 \u20837 \u12289 \u22312 \'85\u20839 " \}, \{ "root": "ple / plere", "origin": "Latin", "meaning": "to fill", "meaning_zh": "\u22635 \u28415 \u12289 \u20805 \u28415 " \} ] \}, "mnemonic": \{ "root_memory": "IM\u65288 \u36914 \u20837 \u65289 + PLE\u65288 \u22635 \u28415 \u65289 \u8594  \u25237 \u20837 \u20854 \u20013 \u65292 \u25226 \u35336 \u30059 \u30340 \u20839 \u23481 \u22635 \u28415 \u33853 \u23526 ", "story_en": "The manager will step IM (into) the project to PLE (fill) the gaps and IMPLEMENT the new safety protocol.", "story_zh": "\u32147 \u29702 \u23559 \u20171 \u20837 \u65288 IM\u65289 \u38917 \u30446 \u20013 \u21435 \u22635 \u28415 \u65288 PLE\u65289 \u28431 \u27934 \u65292 \u20197 \u12300 \u23526 \u26045 \u65288 IMPLEMENT\u65289 \u12301 \u26032 \u30340 \u23433 \u20840 \u21332 \u23450 \u12290 ", "emojis": ["\u55356 \u57303 \u65039 ", "\u55357 \u56523 ", "\u55357 \u56960 "] \}, "example": "The local government plans to implement stricter recycling regulations starting next month.", "example_zh": "\u22320 \u26041 \u25919 \u24220 \u35336 \u21123 \u24478 \u19979 \u20491 \u26376 \u38283 \u22987 \u23526 \u26045 \u26356 \u22196 \u26684 \u30340 \u36039 \u28304 \u22238 \u25910 \u27861 \u35215 \u12290 ", "collocations": [ "implement changes", "implement a policy", "effectively implement", "plan to implement", "implement a strategy" ], "synonyms": ["execute", "enact", "carry out", "administer"], "near_synonyms": [ \{ "word": "execute", "difference": "execute carries a heavy corporate or technical tone, implying carrying out precise orders or complex software programs to the letter; implement is broader and covers policies, lifestyle changes, and broad plans." \}, \{ "word": "enact", "difference": "enact is strictly limited to legal and political contexts, meaning to pass a bill into official law." \} ], "antonyms": ["cancel", "suspend", "neglect"], "word_family": [ \{ "word": "implement", "pos": "verb / noun" \}, \{ "word": "implementation", "pos": "noun" \} ], "usage_note": "As a noun (pronounced /\u712 \u618 mpl\u618 m\u601 nt/), it means a tool or instrument (e.g., farming implements). As a verb, it focuses on execution.", "frequency_rank": 24, "frequency_source": "custom", "difficulty": "B2", "tags": ["college", "business", "politics"] \}, \{ "word": "imply", "pos": "verb", "phonetic": "/\u618 m\u712 pla\u618 /", "definition": "To strongly suggest the truth or existence of something without stating it directly or explicitly.", "definition_zh": "\u26263 \u31034 \u65307 \u26263 \u25351 \u65307 \u24847 \u25351 \u65307 \u24517 \u28982 \u21253 \u21547 ", "etymology": \{ "roots": [ \{ "root": "in / im", "origin": "Latin", "meaning": "in, into", "meaning_zh": "\u22312 \'85\u20839 \u12289 \u21253 \u35065 " \}, \{ "root": "ply / plicare", "origin": "Latin", "meaning": "to fold", "meaning_zh": "\u25240 \u30090 " \} ] \}, "mnemonic": \{ "root_memory": "IM\u65288 \u22312 \'85\u20839 \u65289 + PLY\u65288 \u25240 \u30090 \u65289 \u8594  \u25226 \u30495 \u27491 \u30340 \u24847 \u24605 \u25722 \u30090 \u34255 \u22312 \u35498 \u35441 \u30340 \u20839 \u37096 ", "story_en": "He chose to fold his thoughts IM (in) a heavy PLY (fold), trying to IMPLY his displeasure without shouting.", "story_zh": "\u20182 \u36984 \u25799 \u25226 \u24819 \u27861 \u12300 \u25722 \u30090 \u65288 PLY\u65289 \u12301 \u22312 \u35441 \u35486 \u12300 \u20839 \u65288 IM\u65289 \u12301 \u65292 \u35430 \u22294 \u20197 \u27492 \u12300 \u26263 \u31034 \u65288 IMPLY\u65289 \u12301 \u20182 \u30340 \u19981 \u28415 \u12290 ", "emojis": ["\u55358 \u56592 ", "\u9993 \u65039 ", "\u55358 \u56809 "] \}, "example": "The study does not explicitly state that the drug is unsafe, but the data strongly implies it.", "example_zh": "\u36889 \u38917 \u30740 \u31350 \u20006 \u26410 \u26126 \u30906 \u25351 \u20986 \u35442 \u34277 \u29289 \u26159 \u19981 \u23433 \u20840 \u30340 \u65292 \u20294 \u25976 \u25818 \u24375 \u28872 \u26263 \u31034 \u20102 \u36889 \u19968 \u40670 \u12290 ", "collocations": [ "strongly imply", "not necessarily imply", "imply that", "seem to imply", "clearly imply" ], "synonyms": ["insinuate", "intimate", "hint", "signify"], "near_synonyms": [ \{ "word": "infer", "difference": "imply means the 
